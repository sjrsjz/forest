schema T0 = variant {Err(variant {Cq(variant {InvalidParameter, InvalidValue(string), MissingParameter(string), UnknownType(string), Unterminated}), InlineMedia}), Ok([variant {Assistant({content: optional string, reasoning_content: optional string, refusal: optional string, tool_calls: optional [variant {Function {function: {arguments: string, name: string}, id: string}}]}), Developer {content: string}, System {content: string}, Tool {content: string, tool_call_id: string}, User {content: variant {Parts([variant {ImageUrl {image_url: {detail: optional variant {Auto, High, Low}, url: string}}, Text {text: string}}]), Text(string)}}}])};
export T0;
