schema T0 = variant {Host(variant {Dispatch(variant {Denied, ExecutionFailed(string), FrameTooLarge, HostStopped, InputContract, InterfaceNotFound(string), Interrupted, LifecycleRestricted, ObjectNotFound(string), OutputContract, QueueFull, Unavailable(string)}), Service(variant {InUse, InvalidInput(string), NotFound, RandomUnavailable, Storage(string), Timeout, Transport(string)})}), InvalidSetting {field: string, maximum: i64, minimum: i64, value: i64}};
export T0;
