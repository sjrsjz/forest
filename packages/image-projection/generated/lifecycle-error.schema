schema T0 = variant {Host(variant {Dispatch(variant {Denied, ExecutionFailed(string), FrameTooLarge, HostStopped, InputContract, InterfaceNotFound(string), Interrupted, LifecycleRestricted, ObjectNotFound(string), OutputContract, QueueFull, Unavailable(string)}), Service(variant {InUse, InvalidInput(string), NotFound, Storage(string), Transport(string)})}), InvalidLimits {decode_memory_mib: i32, max_side: i32}};
export T0;
