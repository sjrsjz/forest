[{"interface": "/search", "object": "/module/deepseek-web", "tool": {"description": some "Default tool for web research and finding sources. Search with DeepSeek and return titles, URLs and query-relevant summaries. Search first, then use web_fetch to read selected pages. need_content defaults to false; request full content only when needed.", "name": "web_search", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"count\":{\"default\":10,\"maximum\":50,\"minimum\":1,\"type\":\"integer\"},\"localization\":{\"description\":\"Optional IP address for localized search ranking.\",\"type\":\"string\"},\"need_content\":{\"default\":false,\"type\":\"boolean\"},\"ori_question\":{\"description\":\"Optional original user question.\",\"maxLength\":128,\"minLength\":1,\"type\":\"string\"},\"query\":{\"description\":\"Search query; supports site:, -site:, quoted phrases and date filters.\",\"maxLength\":128,\"minLength\":1,\"type\":\"string\"}},\"required\":[\"query\"],\"type\":\"object\"}", "strict": null}}, {"interface": "/fetch", "object": "/module/deepseek-web", "tool": {"description": some "Default tool for reading a webpage URL. Fetch through DeepSeek and return its title, source URL and extracted Markdown content. Use this for webpage reading instead of requesting raw HTML with http_request.", "name": "web_fetch", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"url\":{\"description\":\"HTTP(S) URL with a host and no embedded credentials.\",\"format\":\"uri\",\"maxLength\":8192,\"minLength\":1,\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"}", "strict": null}}, {"interface": "/http", "object": "/module/agent-tools", "tool": {"description": some "Low-level HTTP(S) for explicit API operations and raw HTTP diagnostics. Returns status, headers and the complete UTF-8 body. For web research use web_search; for webpage content use web_fetch. No automatic retries.", "name": "http_request", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"body\":{\"type\":\"string\"},\"headers\":{\"additionalProperties\":{\"type\":\"string\"},\"type\":\"object\"},\"method\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"}", "strict": null}}, {"interface": "/query", "object": "/module/wolfram-alpha", "tool": {"description": some "Exact mathematics, scientific computation, units, dates and computable facts via Wolfram Alpha. Translate the query to concise single-line English. Use 6*10^14 instead of 6e14 for scientific notation. If status is not_interpreted, use the returned suggestions to reformulate the query. Image URLs in results are source links, not managed media references.", "name": "wolfram_alpha", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"max_chars\":{\"default\":4000,\"description\":\"Result character limit requested from Wolfram Alpha.\",\"maximum\":6000,\"minimum\":500,\"type\":\"integer\"},\"query\":{\"description\":\"A concise single-line query in English, e.g. integrate x^2 sin(x) from 0 to pi.\",\"maxLength\":2000,\"minLength\":1,\"type\":\"string\"}},\"required\":[\"query\"],\"type\":\"object\"}", "strict": null}}, {"interface": "/render", "object": "/module/typst", "tool": {"description": some "Render a Typst document, equations or tables into PNG pages. Use Typst syntax, not Markdown or LaTeX. Defaults: 480pt width, automatic height, 12pt Chinese text, 2 pixels/pt; source can override page/text settings. Chinese and mathematical fonts are included. Returns page dimensions, managed media references and ready-to-send Markdown image links; include the returned markdown in your assistant reply to send the images. No image bytes appear in the tool result. Optional images maps relative virtual file names to existing media: references for image(\"name.png\"). File system, package downloads and current date are unavailable. Compilation diagnostics are returned for you to correct the source.", "name": "typst_render", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"images\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Virtual relative image file names mapped to managed media references.\",\"type\":\"object\"},\"source\":{\"description\":\"Typst source, for example: = 积分结果\\n$ integral_0^pi x^2 sin(x) dif x = pi^2 - 4 $\",\"maxLength\":100000,\"minLength\":1,\"type\":\"string\"}},\"required\":[\"source\"],\"type\":\"object\"}", "strict": null}}, {"interface": "/generate", "object": "/module/ai-paint", "tool": {"description": some "Generate one AI image from a detailed visual prompt. Use this for drawing requests; use typst_render for documents, exact equations and tables. Preserve the user's intended subject and requested wording. style is anime (default), photo or none; size is portrait, landscape or square (default). Returns a persistent media reference and a ready-to-send Markdown image link: copy the markdown exactly into your assistant reply, or send it with onebot_send_group_message/onebot_send_private_message. The tool generates and stores the image but does not send it. Endpoint, model, quality and inference steps are administrator settings. seed is optional and only supported by SiliconFlow and SwarmUI. Do not retry a failed or interrupted generation automatically; it may already have been billed.", "name": "image_generate", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"prompt\":{\"maxLength\":8000,\"minLength\":1,\"type\":\"string\"},\"seed\":{\"description\":\"Optional reproducible seed for SiliconFlow/SwarmUI; omit for a random image.\",\"maximum\":9999999999,\"minimum\":0,\"type\":\"integer\"},\"size\":{\"default\":\"square\",\"enum\":[\"portrait\",\"landscape\",\"square\"],\"type\":\"string\"},\"style\":{\"default\":\"anime\",\"enum\":[\"anime\",\"photo\",\"none\"],\"type\":\"string\"}},\"required\":[\"prompt\"],\"type\":\"object\"}", "strict": null}}, {"interface": "/memory", "object": "/module/agent-tools", "tool": {"description": some "Read up to 16 archived memory units by original group and sequence. Original source is preserved.", "name": "memory_read", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"ids\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"group\":{\"type\":\"integer\"},\"sequence\":{\"type\":\"integer\"}},\"required\":[\"group\",\"sequence\"],\"type\":\"object\"},\"maxItems\":16,\"type\":\"array\"}},\"required\":[\"ids\"],\"type\":\"object\"}", "strict": null}}, {"interface": "/get_login_info", "object": "/module/onebot-tools", "tool": {"description": some "Query the connected bot's own QQ account ID and nickname.", "name": "onebot_get_login_info", "parameters_json": "{\"additionalProperties\":false,\"properties\":{},\"type\":\"object\"}", "strict": null}}, {"interface": "/get_friend_list", "object": "/module/onebot-tools", "tool": {"description": some "List the bot's QQ friends with account IDs, nicknames and remarks. Returns items, total and next_offset; paginate until next_offset is null when needed.", "name": "onebot_get_friend_list", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"limit\":{\"default\":50,\"maximum\":100,\"minimum\":1,\"type\":\"integer\"},\"offset\":{\"default\":0,\"minimum\":0,\"type\":\"integer\"}},\"type\":\"object\"}", "strict": null}}, {"interface": "/get_group_list", "object": "/module/onebot-tools", "tool": {"description": some "List QQ groups the bot has joined, with group IDs, names and membership counts. Returns items, total and next_offset; paginate as needed. Membership does not imply an Agent is enabled in that group.", "name": "onebot_get_group_list", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"limit\":{\"default\":50,\"maximum\":100,\"minimum\":1,\"type\":\"integer\"},\"offset\":{\"default\":0,\"minimum\":0,\"type\":\"integer\"}},\"type\":\"object\"}", "strict": null}}, {"interface": "/get_group_info", "object": "/module/onebot-tools", "tool": {"description": some "Query a QQ group's name, member count and capacity. Defaults to the current group.", "name": "onebot_get_group_info", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"group_id\":{\"description\":\"QQ group ID. Omit to use the current conversation's group.\",\"type\":\"integer\"},\"no_cache\":{\"default\":false,\"description\":\"Request fresh information from the gateway rather than its cache.\",\"type\":\"boolean\"}},\"type\":\"object\"}", "strict": null}}, {"interface": "/get_group_member_list", "object": "/module/onebot-tools", "tool": {"description": some "List QQ group members with account IDs, nicknames, group cards and owner/admin/member roles. Defaults to the current group. Returns items, total and next_offset; use pagination instead of assuming the first page is the entire group.", "name": "onebot_get_group_member_list", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"group_id\":{\"description\":\"QQ group ID. Omit to use the current conversation's group.\",\"type\":\"integer\"},\"limit\":{\"default\":50,\"maximum\":100,\"minimum\":1,\"type\":\"integer\"},\"offset\":{\"default\":0,\"minimum\":0,\"type\":\"integer\"}},\"type\":\"object\"}", "strict": null}}, {"interface": "/get_group_member_info", "object": "/module/onebot-tools", "tool": {"description": some "Query a particular member's group card, role, title, join time and other gateway-provided profile fields. Defaults to the current group; use the bot's account ID to inspect its own role.", "name": "onebot_get_group_member_info", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"group_id\":{\"description\":\"QQ group ID. Omit to use the current conversation's group.\",\"type\":\"integer\"},\"no_cache\":{\"default\":false,\"description\":\"Request fresh information from the gateway rather than its cache.\",\"type\":\"boolean\"},\"user_id\":{\"description\":\"QQ account ID, not a nickname. Use sender IDs from the conversation or query group members.\",\"type\":\"integer\"}},\"required\":[\"user_id\"],\"type\":\"object\"}", "strict": null}}, {"interface": "/get_stranger_info", "object": "/module/onebot-tools", "tool": {"description": some "Query a QQ user's public profile by account ID, including nickname, sex and age as provided by the gateway. This does not require assuming the user is a friend or belongs to the current group.", "name": "onebot_get_stranger_info", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"no_cache\":{\"default\":false,\"description\":\"Request fresh information from the gateway rather than its cache.\",\"type\":\"boolean\"},\"user_id\":{\"description\":\"QQ account ID, not a nickname. Use sender IDs from the conversation or query group members.\",\"type\":\"integer\"}},\"required\":[\"user_id\"],\"type\":\"object\"}", "strict": null}}, {"interface": "/send_group_message", "object": "/module/onebot-tools", "tool": {"description": some "Immediately send a separate QQ group message and return its actual message_ids and any terminal error. Defaults to the current group; an explicit group_id can target another joined group. Supports Forest Markdown links for mentions, replies, faces and managed images. Successful calls have already sent the message: do not repeat that content in your assistant reply. Ordinary replies to the current conversation are sent automatically and do not require this tool.", "name": "onebot_send_group_message", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"group_id\":{\"description\":\"QQ group ID. Omit to use the current conversation's group.\",\"type\":\"integer\"},\"message\":{\"description\":\"Markdown message with optional [name](forest:at/ACCOUNT), [reply](forest:reply/GROUP/MESSAGE), [face](forest:face/ID), and ![image](media:HASH). Images must use media:<sha256> references returned by tools; never supply base64, URLs or filesystem paths. A thematic break splits messages. Group replies must target the destination group; private messages cannot mention groups or reply to group messages.\",\"minLength\":1,\"type\":\"string\"}},\"required\":[\"message\"],\"type\":\"object\"}", "strict": null}}, {"interface": "/send_private_message", "object": "/module/onebot-tools", "tool": {"description": some "Immediately send a separate private QQ message and return its actual message_ids and any terminal error. The gateway determines whether the recipient can be reached; do not claim delivery if it fails. Supports Forest Markdown face links and managed images. A successful call has already sent the message; do not repeat it as an assistant reply.", "name": "onebot_send_private_message", "parameters_json": "{\"additionalProperties\":false,\"properties\":{\"message\":{\"description\":\"Markdown message with optional [name](forest:at/ACCOUNT), [reply](forest:reply/GROUP/MESSAGE), [face](forest:face/ID), and ![image](media:HASH). Images must use media:<sha256> references returned by tools; never supply base64, URLs or filesystem paths. A thematic break splits messages. Group replies must target the destination group; private messages cannot mention groups or reply to group messages.\",\"minLength\":1,\"type\":\"string\"},\"user_id\":{\"description\":\"QQ account ID, not a nickname. Use sender IDs from the conversation or query group members.\",\"type\":\"integer\"}},\"required\":[\"user_id\",\"message\"],\"type\":\"object\"}", "strict": null}}]