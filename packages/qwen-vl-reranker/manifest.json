{
  "package": {
    "id": "/module/qwen-vl-reranker",
    "version": "0.1.0",
    "name": "Qwen VL Reranker",
    "description": "Qwen3-VL-Reranker-8B text/image relevance scoring"
  },
  "module": "module.wasm",
  "configs": [
    {
      "key": "/connection",
      "schema": [
        {
          "Record": {
            "api_key": "String",
            "batch_size": "I64",
            "endpoint": "String"
          }
        }
      ],
      "default": {
        "Record": {
          "api_key": {
            "String": ""
          },
          "batch_size": {
            "I64": 64
          },
          "endpoint": {
            "String": "https://api.siliconflow.cn/v1/rerank"
          }
        }
      },
      "access": {
        "readers": [
          "SelfModule"
        ],
        "writers": [
          {
            "Path": "/user/admin"
          }
        ],
        "callers": []
      }
    }
  ],
  "provides": [
    {
      "path": "/rank",
      "input": [
        {
          "Record": {
            "documents": {
              "Array": {
                "Variant": {
                  "Image": {
                    "Unnamed": [
                      "String"
                    ]
                  },
                  "Text": {
                    "Unnamed": [
                      "String"
                    ]
                  }
                }
              }
            },
            "query": {
              "Variant": {
                "Image": {
                  "Unnamed": [
                    "String"
                  ]
                },
                "Text": {
                  "Unnamed": [
                    "String"
                  ]
                }
              }
            }
          }
        }
      ],
      "output": [
        {
          "Variant": {
            "Err": {
              "Unnamed": [
                {
                  "Variant": {
                    "Host": {
                      "Unnamed": [
                        "String"
                      ]
                    },
                    "Http": {
                      "Named": {
                        "body": "String",
                        "request_id": {
                          "Option": "String"
                        },
                        "status": "I32"
                      }
                    },
                    "NotConfigured": {
                      "Unnamed": []
                    },
                    "Response": {
                      "Unnamed": [
                        "String"
                      ]
                    }
                  }
                }
              ]
            },
            "Ok": {
              "Unnamed": [
                {
                  "Record": {
                    "json": "String"
                  }
                }
              ]
            }
          }
        }
      ],
      "reentrant": true,
      "access": {
        "readers": [],
        "writers": [],
        "callers": [
          {
            "Path": "/module/**"
          },
          {
            "Path": "/user/admin"
          }
        ]
      }
    }
  ],
  "uses": [],
  "subscriptions": []
}