schema T0 = variant {Err(variant {Host(string), Http {request_id: optional string, status: i32}, NotConfigured, Response(string), ToolSchema {name: string, reason: string}}), Ok({choices: [{finish_reason: variant {ContentFilter, Length, Stop, ToolCalls}, index: i64, message: {content: optional string, reasoning_content: optional string, refusal: optional string, tool_calls: optional [variant {Function {function: {arguments: string, name: string}, id: string}}]}}], created: i64, id: string, model: string, usage: optional {completion_tokens: i64, completion_tokens_details: optional {reasoning_tokens: optional i64}, prompt_cache_hit_tokens: optional i64, prompt_cache_miss_tokens: optional i64, prompt_tokens: i64, prompt_tokens_details: optional {cached_tokens: optional i64}, total_tokens: i64}})};
export T0;
