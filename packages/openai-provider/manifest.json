{
  "package": {
    "id": "/module/openai-provider",
    "version": "0.1.0",
    "name": "OpenAI Chat Completions",
    "description": "Typed messages and native function tools; configured model and image capability"
  },
  "module": "module.wasm",
  "configs": [
    {
      "key": "/settings",
      "schema": [
        {
          "Record": {
            "api_key": "String",
            "endpoint": "String",
            "model": "String",
            "multimodal": "Bool",
            "output_limit": {
              "Variant": {
                "CompletionTokens": {
                  "Unnamed": [
                    "I64"
                  ]
                },
                "ProviderDefault": {
                  "Unnamed": []
                },
                "Tokens": {
                  "Unnamed": [
                    "I64"
                  ]
                }
              }
            },
            "reasoning_effort": {
              "Option": "String"
            }
          }
        }
      ],
      "default": {
        "Record": {
          "api_key": {
            "String": ""
          },
          "endpoint": {
            "String": "https://api.openai.com/v1/chat/completions"
          },
          "model": {
            "String": ""
          },
          "multimodal": {
            "Bool": false
          },
          "output_limit": {
            "Variant": [
              "ProviderDefault",
              {
                "Unnamed": []
              }
            ]
          },
          "reasoning_effort": "None"
        }
      },
      "access": {
        "readers": [
          "SelfModule"
        ],
        "writers": [
          {
            "Path": "/user/admin"
          }
        ],
        "callers": []
      }
    }
  ],
  "provides": [
    {
      "path": "/capabilities",
      "input": [
        {
          "Tuple": []
        }
      ],
      "output": [
        {
          "Variant": {
            "Err": {
              "Unnamed": [
                {
                  "Variant": {
                    "Host": {
                      "Unnamed": [
                        "String"
                      ]
                    },
                    "Http": {
                      "Named": {
                        "request_id": {
                          "Option": "String"
                        },
                        "status": "I32"
                      }
                    },
                    "NotConfigured": {
                      "Unnamed": []
                    },
                    "Response": {
                      "Unnamed": [
                        "String"
                      ]
                    },
                    "ToolSchema": {
                      "Named": {
                        "name": "String",
                        "reason": "String"
                      }
                    }
                  }
                }
              ]
            },
            "Ok": {
              "Unnamed": [
                {
                  "Record": {
                    "model": "String",
                    "multimodal": "Bool"
                  }
                }
              ]
            }
          }
        }
      ],
      "reentrant": true,
      "access": {
        "readers": [],
        "writers": [],
        "callers": [
          {
            "Path": "/module/**"
          },
          {
            "Path": "/user/admin"
          }
        ]
      }
    },
    {
      "path": "/complete",
      "input": [
        {
          "Record": {
            "messages": {
              "Array": {
                "Variant": {
                  "Assistant": {
                    "Unnamed": [
                      {
                        "Record": {
                          "content": {
                            "Option": "String"
                          },
                          "reasoning_content": {
                            "Option": "String"
                          },
                          "refusal": {
                            "Option": "String"
                          },
                          "tool_calls": {
                            "Option": {
                              "Array": {
                                "Variant": {
                                  "Function": {
                                    "Named": {
                                      "function": {
                                        "Record": {
                                          "arguments": "String",
                                          "name": "String"
                                        }
                                      },
                                      "id": "String"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  },
                  "Developer": {
                    "Named": {
                      "content": "String"
                    }
                  },
                  "System": {
                    "Named": {
                      "content": "String"
                    }
                  },
                  "Tool": {
                    "Named": {
                      "content": "String",
                      "tool_call_id": "String"
                    }
                  },
                  "User": {
                    "Named": {
                      "content": {
                        "Variant": {
                          "Parts": {
                            "Unnamed": [
                              {
                                "Array": {
                                  "Variant": {
                                    "ImageUrl": {
                                      "Named": {
                                        "image_url": {
