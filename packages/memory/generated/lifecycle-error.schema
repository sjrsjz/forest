schema T0 = variant {Host(variant {Dispatch(variant {Denied, ExecutionFailed(string), FrameTooLarge, HostStopped, InputContract, InterfaceNotFound(string), Interrupted, LifecycleRestricted, ObjectNotFound(string), OutputContract, QueueFull, Unavailable(string)}), Service(variant {InUse, InvalidInput(string), NotFound, RandomUnavailable, Storage(string), Timeout, Transport(string)})}), InvalidCollectionName, InvalidRetrievalBounds, RetrievalJson {column: i64, line: i64, message: string}};
export T0;
