schema T0 = variant {Configuration(variant {InvalidDimensions {size: string}, InvalidEndpoint, InvalidSteps {backend: variant {OpenAiImages, SiliconFlow, SwarmUi}, steps: i64}}), Host(variant {Dispatch(variant {Denied, ExecutionFailed(string), FrameTooLarge, HostStopped, InputContract, InterfaceNotFound(string), Interrupted, LifecycleRestricted, ObjectNotFound(string), OutputContract, QueueFull, Unavailable(string)}), Service(variant {InUse, InvalidInput(string), NotFound, Storage(string), Transport(string)})})};
export T0;
