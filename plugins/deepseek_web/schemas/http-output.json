{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "enum": [
        "RECEIVED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "status_code": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "byte_length": {
      "type": "integer",
      "minimum": 0
    },
    "body": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "payload_id": {
              "type": "string",
              "maxLength": 512
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "owner_component_id": {
              "type": "string",
              "maxLength": 128
            },
            "owner_kind": {
              "type": "string",
              "maxLength": 128
            },
            "owner_id": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": [
            "payload_id",
            "digest",
            "owner_component_id",
            "owner_kind",
            "owner_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    }
  },
  "required": [
    "outcome",
    "status_code",
    "headers",
    "byte_length",
    "body",
    "error_code"
  ],
  "additionalProperties": false
}
