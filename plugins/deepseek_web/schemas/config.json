{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string",
      "maxLength": 8192
    },
    "transport": {
      "type": "object",
      "properties": {
        "allowed_origins": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 8192
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "allow_public_urls": {
          "type": "boolean"
        },
        "allowed_private_hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 60
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 4194304
        },
        "credential_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "credential_purpose": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "allowed_origins",
        "allow_public_urls",
        "allowed_private_hosts",
        "timeout_seconds",
        "max_response_bytes",
        "credential_ref",
        "credential_purpose"
      ],
      "additionalProperties": false
    },
    "max_result_chars": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 48000
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "endpoint",
    "transport",
    "max_result_chars",
    "max_results"
  ],
  "additionalProperties": false
}
