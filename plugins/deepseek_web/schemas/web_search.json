{
  "name": "web_search",
  "description": "Search the web with DeepSeek. Returns source URLs, titles, dates and relevant excerpts; use web_fetch for full pages.",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "ori_question": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 128
      },
      "localization": {
        "type": "string",
        "maxLength": 128
      },
      "need_content": {
        "type": "boolean"
      }
    },
    "required": [
      "query",
      "count",
      "ori_question",
      "localization",
      "need_content"
    ],
    "additionalProperties": false
  },
  "strict": true
}
