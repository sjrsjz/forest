{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "forest.agent-tool-execute/1"
    },
    "tool_call_id": {
      "type": "string",
      "maxLength": 512
    },
    "effect_operation_id": {
      "type": "string",
      "maxLength": 512
    },
    "effect_attempt_id": {
      "type": "string",
      "maxLength": 512
    },
    "component_id": {
      "const": "tools.http"
    },
    "generation_id": {
      "type": "string",
      "maxLength": 512
    },
    "service_id": {
      "enum": [
        "tools.http.http-get",
        "tools.http.http-request"
      ]
    },
    "contract_digest": {
      "type": "string",
      "maxLength": 71
    },
    "binding_digest": {
      "type": "string",
      "maxLength": 71
    },
    "authority_trigger_ref": {
      "type": "string",
      "maxLength": 512
    },
    "authority_principal_ref": {
      "type": "string",
      "maxLength": 512
    },
    "arguments": {
      "type": "object"
    }
  },
  "required": [
    "protocol",
    "tool_call_id",
    "effect_operation_id",
    "effect_attempt_id",
    "component_id",
    "generation_id",
    "service_id",
    "contract_digest",
    "binding_digest",
    "authority_trigger_ref",
    "authority_principal_ref",
    "arguments"
  ],
  "additionalProperties": false
}
