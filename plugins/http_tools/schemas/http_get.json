{
  "name": "http_get",
  "description": "Read an HTTP(S) URL without following redirects. Returns HTTP status, response headers and bounded text or a managed binary reference.",
  "parameters": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "maxLength": 8192
      },
      "method": {
        "enum": [
          "GET",
          "HEAD"
        ]
      },
      "headers": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 128
            },
            "value": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "required": [
            "name",
            "value"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "url",
      "method",
      "headers"
    ],
    "additionalProperties": false
  },
  "strict": true
}
