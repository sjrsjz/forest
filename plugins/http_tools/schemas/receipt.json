{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "status",
    "tool_call_id",
    "effect_operation_id",
    "effect_attempt_id",
    "result",
    "error_code",
    "observation_ref"
  ],
  "properties": {
    "protocol": {
      "const": "forest.agent-tool-receipt/1"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "UNKNOWN"
      ]
    },
    "tool_call_id": {
      "$ref": "#/$defs/id"
    },
    "effect_operation_id": {
      "$ref": "#/$defs/id"
    },
    "effect_attempt_id": {
      "$ref": "#/$defs/id"
    },
    "result": {
      "oneOf": [
        {
          "$ref": "#/$defs/result"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "observation_ref": {
      "$ref": "#/$defs/id"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_id",
        "digest",
        "owner_component_id",
        "owner_kind",
        "owner_id"
      ],
      "properties": {
        "payload_id": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "owner_component_id": {
          "const": "tools.http"
        },
        "owner_kind": {
          "const": "tool.result"
        },
        "owner_id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
