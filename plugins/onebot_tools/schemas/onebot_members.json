{
  "name": "onebot_members",
  "description": "Read a page of members of an allowed group.",
  "parameters": {
    "type": "object",
    "properties": {
      "group_id": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$"
      },
      "after_user_id": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[1-9][0-9]{0,18}$"
      }
    },
    "required": [
      "group_id",
      "after_user_id"
    ],
    "additionalProperties": false
  },
  "strict": true
}
