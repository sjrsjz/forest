{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_ref",
    "query",
    "after_group_id"
  ],
  "properties": {
    "binding_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "query": {
      "type": "string",
      "maxLength": 128
    },
    "after_group_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[1-9][0-9]{0,18}$"
    }
  }
}
