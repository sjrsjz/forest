{
  "name": "onebot_kick_member",
  "description": "Remove a group member; reject_add_request controls whether their rejoin requests are rejected.",
  "parameters": {
    "type": "object",
    "properties": {
      "group_id": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$"
      },
      "user_id": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$"
      },
      "reject_add_request": {
        "type": "boolean"
      }
    },
    "required": [
      "group_id",
      "user_id",
      "reject_add_request"
    ],
    "additionalProperties": false
  },
  "strict": true
}
