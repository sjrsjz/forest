{
  "name": "onebot_set_group_name",
  "description": "Set the name of an allowed group; requires group management permission.",
  "parameters": {
    "type": "object",
    "properties": {
      "group_id": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$"
      },
      "group_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required": [
      "group_id",
      "group_name"
    ],
    "additionalProperties": false
  },
  "strict": true
}
