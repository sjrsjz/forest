{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "forest.agent-tool-execute/1"
    },
    "tool_call_id": {
      "type": "string",
      "maxLength": 512
    },
    "effect_operation_id": {
      "type": "string",
      "maxLength": 512
    },
    "effect_attempt_id": {
      "type": "string",
      "maxLength": 512
    },
    "component_id": {
      "const": "tools.onebot"
    },
    "generation_id": {
      "type": "string",
      "maxLength": 512
    },
    "service_id": {
      "enum": [
        "tools.onebot.onebot-account-info",
        "tools.onebot.onebot-groups",
        "tools.onebot.onebot-group-info",
        "tools.onebot.onebot-member-info",
        "tools.onebot.onebot-members",
        "tools.onebot.onebot-send-group",
        "tools.onebot.onebot-send-private",
        "tools.onebot.onebot-ban-member",
        "tools.onebot.onebot-ban-all",
        "tools.onebot.onebot-kick-member",
        "tools.onebot.onebot-set-card",
        "tools.onebot.onebot-set-group-name",
        "tools.onebot.onebot-delivery-status"
      ]
    },
    "contract_digest": {
      "type": "string",
      "maxLength": 71
    },
    "binding_digest": {
      "type": "string",
      "maxLength": 71
    },
    "authority_trigger_ref": {
      "type": "string",
      "maxLength": 512
    },
    "authority_principal_ref": {
      "type": "string",
      "maxLength": 512
    },
    "arguments": {
      "type": "object"
    }
  },
  "required": [
    "protocol",
    "tool_call_id",
    "effect_operation_id",
    "effect_attempt_id",
    "component_id",
    "generation_id",
    "service_id",
    "contract_digest",
    "binding_digest",
    "authority_trigger_ref",
    "authority_principal_ref",
    "arguments"
  ],
  "additionalProperties": false
}
