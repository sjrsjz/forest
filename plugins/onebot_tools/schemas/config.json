{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "binding_ref": {
      "type": "string",
      "maxLength": 128
    },
    "allowed_group_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$"
      },
      "maxItems": 4096,
      "uniqueItems": true
    },
    "operator_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$"
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "enabled_tools": {
      "type": "array",
      "items": {
        "enum": [
          "onebot_account_info",
          "onebot_groups",
          "onebot_group_info",
          "onebot_member_info",
          "onebot_members",
          "onebot_send_group",
          "onebot_send_private",
          "onebot_ban_member",
          "onebot_ban_all",
          "onebot_kick_member",
          "onebot_set_card",
          "onebot_set_group_name",
          "onebot_delivery_status"
        ]
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "management_permissions": {
      "type": "object",
      "properties": {
        "onebot_send_group": {
          "type": "array",
          "items": {
            "enum": [
              "owner",
              "admin"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "onebot_ban_member": {
          "type": "array",
          "items": {
            "enum": [
              "owner",
              "admin"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "onebot_ban_all": {
          "type": "array",
          "items": {
            "enum": [
              "owner",
              "admin"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "onebot_kick_member": {
          "type": "array",
          "items": {
            "enum": [
              "owner",
              "admin"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "onebot_set_card": {
          "type": "array",
          "items": {
            "enum": [
              "owner",
              "admin"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "onebot_set_group_name": {
          "type": "array",
          "items": {
            "enum": [
              "owner",
              "admin"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "onebot_send_group",
        "onebot_ban_member",
        "onebot_ban_all",
        "onebot_kick_member",
        "onebot_set_card",
        "onebot_set_group_name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "binding_ref",
    "allowed_group_ids",
    "operator_ids",
    "enabled_tools",
    "management_permissions"
  ],
  "additionalProperties": false
}
