{
  "name": "onebot_groups",
  "description": "List allowed joined groups with provenance; use after_group_id to get the next page.",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 128
      },
      "after_group_id": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[1-9][0-9]{0,18}$"
      }
    },
    "required": [
      "query",
      "after_group_id"
    ],
    "additionalProperties": false
  },
  "strict": true
}
