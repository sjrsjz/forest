{
  "name": "onebot_send_private",
  "description": "Queue an authorized private message through Delivery. QUEUED is not SENT.",
  "parameters": {
    "type": "object",
    "properties": {
      "user_id": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$"
      },
      "message": {
        "type": "string",
        "maxLength": 16000
      }
    },
    "required": [
      "user_id",
      "message"
    ],
    "additionalProperties": false
  },
  "strict": true
}
