{
  "name": "onebot_set_card",
  "description": "Set or clear a member group card; requires group management permission.",
  "parameters": {
    "type": "object",
    "properties": {
      "group_id": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$"
      },
      "user_id": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$"
      },
      "card": {
        "type": "string",
        "maxLength": 128
      }
    },
    "required": [
      "group_id",
      "user_id",
      "card"
    ],
    "additionalProperties": false
  },
  "strict": true
}
