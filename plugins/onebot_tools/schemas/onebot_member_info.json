{
  "name": "onebot_member_info",
  "description": "Read a member and their role in an allowed group.",
  "parameters": {
    "type": "object",
    "properties": {
      "group_id": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$"
      },
      "user_id": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$"
      }
    },
    "required": [
      "group_id",
      "user_id"
    ],
    "additionalProperties": false
  },
  "strict": true
}
