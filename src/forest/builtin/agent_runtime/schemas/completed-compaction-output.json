{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "conversation_id", "session_ref", "run_ref"],
  "properties": {
    "protocol": {"const": "forest.agent-completed-compaction/1"},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "session_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "run_ref": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
