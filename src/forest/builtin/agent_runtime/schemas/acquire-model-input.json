{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversation", "payload_epoch", "memory", "agent"],
  "properties": {
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "boundary", "selection_mode", "session_ref", "run_ref", "next_run_ref"],
      "properties": {
        "actor": {"$ref": "#/$defs/conversation_owner"},
        "boundary": {"const": "MODEL_SAFE_POINT"},
        "selection_mode": {"const": "ANY"},
        "session_ref": {"$ref": "#/$defs/id"},
        "run_ref": {"$ref": "#/$defs/id"},
        "next_run_ref": {"type": "null"}
      }
    },
    "payload_epoch": {
      "const": {"protocol": "forest.payload-epoch-capture/1"}
    },
    "memory": {
      "const": {
        "selection_step_id": "conversation",
        "deletion_epoch_step_id": "payload_epoch"
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "selection_step_id", "memory_step_id"],
      "properties": {
        "owner": {"$ref": "#/$defs/agent_owner"},
        "selection_step_id": {"const": "conversation"},
        "memory_step_id": {"const": "memory"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "conversation_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation_id", "owner_id", "epoch"],
      "properties": {
        "conversation_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "epoch": {"type": "integer", "minimum": 1}
      }
    },
    "agent_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "owner_id", "epoch"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "epoch": {"type": "integer", "minimum": 1}
      }
    }
  }
}
