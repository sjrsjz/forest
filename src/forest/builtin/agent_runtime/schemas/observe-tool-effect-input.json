{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["effect", "agent"], "properties": {"effect": {"$ref": "#/$defs/effect"}, "agent": {"$ref": "#/$defs/agent"}},
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "owner": {"type": "object", "additionalProperties": false, "required": ["run_id", "owner_id", "epoch"], "properties": {"run_id": {"$ref": "#/$defs/id"}, "owner_id": {"$ref": "#/$defs/id"}, "epoch": {"type": "integer", "minimum": 1}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"], "properties": {"payload_id": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/digest"}, "owner_component_id": {"$ref": "#/$defs/id"}, "owner_kind": {"const": "tool.result"}, "owner_id": {"$ref": "#/$defs/id"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["protocol", "status", "tool_call_id", "effect_operation_id", "effect_attempt_id", "result", "error_code", "observation_ref"], "properties": {"protocol": {"const": "forest.agent-tool-receipt/1"}, "status": {"enum": ["SUCCEEDED", "FAILED", "CANCELLED", "UNKNOWN"]}, "tool_call_id": {"$ref": "#/$defs/id"}, "effect_operation_id": {"$ref": "#/$defs/id"}, "effect_attempt_id": {"$ref": "#/$defs/id"}, "result": {"oneOf": [{"$ref": "#/$defs/result"}, {"type": "null"}]}, "error_code": {"type": ["string", "null"], "maxLength": 128}, "observation_ref": {"$ref": "#/$defs/id"}}},
    "effect": {"type": "object", "additionalProperties": false, "required": ["protocol", "effect_operation_id", "attempt_id", "observation_operation_id", "status", "evidence_kind", "evidence"], "properties": {"protocol": {"const": "forest.effect-command-result/1"}, "effect_operation_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "observation_operation_id": {"$ref": "#/$defs/id"}, "status": {"enum": ["SUCCEEDED", "UNKNOWN"]}, "evidence_kind": {"enum": ["executor", "reconciliation"]}, "evidence": {"type": "object", "additionalProperties": false, "required": ["value", "parents"], "properties": {"value": {"$ref": "#/$defs/receipt"}, "parents": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/result"}}}}}},
    "agent": {"type": "object", "additionalProperties": false, "required": ["owner", "observation_operation_id", "tool_call_id", "effect_attempt_id", "observed_state", "evidence_kind", "effect_observation_ref", "approval_ref", "error_code", "results", "effect_step_id", "evidence_digest"], "properties": {"owner": {"$ref": "#/$defs/owner"}, "observation_operation_id": {"$ref": "#/$defs/id"}, "tool_call_id": {"$ref": "#/$defs/id"}, "effect_attempt_id": {"$ref": "#/$defs/id"}, "observed_state": {"enum": ["SUCCEEDED", "FAILED", "CANCELLED", "UNKNOWN"]}, "evidence_kind": {"enum": ["EXECUTOR", "RECONCILIATION"]}, "effect_observation_ref": {"$ref": "#/$defs/id"}, "approval_ref": {"type": "null"}, "error_code": {"type": ["string", "null"], "maxLength": 128}, "results": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/result"}}, "effect_step_id": {"const": "effect"}, "evidence_digest": {"$ref": "#/$defs/digest"}}}
  }
}
