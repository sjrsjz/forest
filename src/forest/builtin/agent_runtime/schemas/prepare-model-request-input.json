{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/input",
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "owner": {
      "type": "object",
      "required": ["run_id", "owner_id", "epoch"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "epoch": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"const": "agent.runtime"},
        "owner_kind": {"const": "model.projection"},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    },
    "wire_payload": {
      "type": "object",
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"const": "agent.runtime"},
        "owner_kind": {"const": "model.wire"},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "request_id", "request_kind", "provider_component_id", "provider_generation_id",
        "provider_profile_ref", "model_ref", "instruction_channel", "capability_digest",
        "projection", "first_attempt_id", "initial_wire", "projected_content_digest", "source_manifest_digest",
        "learning_candidates", "output_token_budget"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/id"},
        "request_kind": {"enum": ["PRIMARY", "CONTINUATION", "REPAIR"]},
        "provider_component_id": {"$ref": "#/$defs/id"},
        "provider_generation_id": {"$ref": "#/$defs/id"},
        "provider_profile_ref": {"$ref": "#/$defs/id"},
        "model_ref": {"$ref": "#/$defs/id"},
        "instruction_channel": {"enum": ["SYSTEM", "DEVELOPER", "INSTRUCTIONS", "DEGRADED_USER"]},
        "capability_digest": {"$ref": "#/$defs/digest"},
        "projection": {"$ref": "#/$defs/payload"},
        "first_attempt_id": {"$ref": "#/$defs/id"},
        "initial_wire": {"$ref": "#/$defs/wire_payload"},
        "projected_content_digest": {"$ref": "#/$defs/digest"},
        "source_manifest_digest": {"$ref": "#/$defs/digest"},
        "learning_candidates": {
          "type": "array", "maxItems": 64,
          "items": {"$ref": "#/$defs/learning_candidate"}
        },
        "output_token_budget": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "learning_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_id", "query_id", "source_unit_id", "source_revision", "rank_score", "part_ids"],
      "properties": {
        "bundle_id": {"$ref": "#/$defs/id"},
        "query_id": {"$ref": "#/$defs/id"},
        "source_unit_id": {"$ref": "#/$defs/id"},
        "source_revision": {"type": "integer", "minimum": 1},
        "rank_score": {"type": "number", "minimum": 0, "maximum": 256},
        "part_ids": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "input": {
      "type": "object",
      "required": ["owner", "request"],
      "properties": {
        "owner": {"$ref": "#/$defs/owner"},
        "request": {"$ref": "#/$defs/request"}
      },
      "additionalProperties": false
    }
  }
}
