{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object",
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "agent.runtime"},
        "generation_id": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["owner", "input_batch"],
      "properties": {
        "owner": {"$ref": "#/$defs/owner"},
        "input_batch": {"$ref": "#/$defs/batch"}
      },
      "additionalProperties": false
    },
    "prior": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "owner": {
      "type": "object",
      "required": ["run_id", "owner_id", "epoch"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "epoch": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["ref", "count", "last_trigger_ref", "last_trigger_ingress_seq", "digest"],
      "properties": {
        "ref": {"$ref": "#/$defs/id"},
        "count": {"type": "integer", "minimum": 1},
        "last_trigger_ref": {"$ref": "#/$defs/id"},
        "last_trigger_ingress_seq": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "batch": {
      "type": "object",
      "required": [
        "input_batch_ref", "input_batch_digest", "selected_input_end_seq",
        "context_revision", "context_view_revision", "source_manifest_digest", "trigger_claim"
      ],
      "properties": {
        "input_batch_ref": {"$ref": "#/$defs/id"},
        "input_batch_digest": {"$ref": "#/$defs/digest"},
        "selected_input_end_seq": {"type": "integer", "minimum": 1},
        "context_revision": {"type": "integer", "minimum": 1},
        "context_view_revision": {"type": "integer", "minimum": 0},
        "source_manifest_digest": {"$ref": "#/$defs/digest"},
        "trigger_claim": {"$ref": "#/$defs/claim"}
      },
      "additionalProperties": false
    }
  }
}
