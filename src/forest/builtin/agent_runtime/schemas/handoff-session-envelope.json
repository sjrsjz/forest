{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "conversation.scheduler"},
        "generation_id": {"$ref": "#/$defs/id"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id", "completed_run_id", "successor_run_id", "successor_deadline",
        "selection_step_id", "memory_step_id"
      ],
      "properties": {
        "session_id": {"$ref": "#/$defs/id"},
        "completed_run_id": {"$ref": "#/$defs/id"},
        "successor_run_id": {"$ref": "#/$defs/id"},
        "successor_deadline": {"type": "string", "minLength": 1, "maxLength": 64},
        "selection_step_id": {"const": "conversation"},
        "memory_step_id": {"const": "memory"}
      }
    },
    "prior": {
      "type": "object",
      "required": ["conversation", "payload_epoch", "memory"]
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
