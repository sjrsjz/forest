{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "failure_id", "failed_request_id", "error_code", "candidate_digest",
    "resulting_state", "repair_step_seq"
  ],
  "properties": {
    "failure_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "failed_request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "error_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "resulting_state": {"enum": ["REPAIR_READY", "FAILED"]},
    "repair_step_seq": {"type": ["integer", "null"], "minimum": 1}
  },
  "additionalProperties": false
}
