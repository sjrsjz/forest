{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "kernel.runtime"},
        "generation_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "expected_checkpoint_seq", "reason_code", "requested_by"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "expected_checkpoint_seq": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "reason_code": {"const": "CORE_RESCUE_CANCEL"},
        "requested_by": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "prior": {"type": "object"}
  }
}
