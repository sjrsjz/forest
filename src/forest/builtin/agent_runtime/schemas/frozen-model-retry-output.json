{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol", "request_id", "provider_generation_id", "provider_profile_ref", "model_ref", "capability_digest", "projection", "wire", "output_token_budget", "projected_content_digest", "source_manifest_digest"],
  "properties": {
    "protocol": {"const": "forest.agent-frozen-model-retry/1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider_generation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider_profile_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "model_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "capability_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "projection": {"$ref": "#/$defs/ref"},
    "wire": {"$ref": "#/$defs/ref"},
    "output_token_budget": {"type": "integer", "minimum": 1},
    "projected_content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source_manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "owner_component_id": {"const": "agent.runtime"},
        "owner_kind": {"enum": ["model.projection", "model.wire"]},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    }
  }
}
