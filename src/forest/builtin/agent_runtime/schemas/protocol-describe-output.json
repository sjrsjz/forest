{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol_id", "protocol_version", "core_prompt_digest",
    "parser_revision", "core_prompt", "core_prompt_bytes"
  ],
  "properties": {
    "protocol_id": {"const": "forest-agent-protocol"},
    "protocol_version": {"const": 2},
    "core_prompt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "parser_revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "core_prompt": {"type": "string", "minLength": 1, "maxLength": 131072},
    "core_prompt_bytes": {"type": "integer", "minimum": 1, "maximum": 131072}
  },
  "additionalProperties": false
}
