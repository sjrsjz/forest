{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "agent.runtime"},
        "generation_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": [
        "owner", "request_id", "attempt_id", "effect_operation_ref",
        "provider_service_id", "effect_step_id"
      ],
      "properties": {
        "owner": {"$ref": "#/$defs/owner"},
        "request_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "effect_operation_ref": {"$ref": "#/$defs/id"},
        "provider_service_id": {"const": "provider.model.dispatch"},
        "effect_step_id": {"const": "effect"}
      }
    },
    "prior": {"type": "object", "required": ["authorization", "effect"]}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "owner_id", "epoch"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "epoch": {"type": "integer", "minimum": 1}
      }
    }
  }
}
