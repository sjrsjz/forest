{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "conversation.scheduler"},
        "generation_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "prior_step_id"],
      "properties": {
        "protocol": {"const": "forest.agent-requeue-verification/1"},
        "prior_step_id": {"const": "conversation"}
      }
    },
    "prior": {
      "type": "object",
      "required": ["conversation"],
      "properties": {
        "conversation": {"$ref": "#/$defs/requeued"}
      }
    }
  },
  "$defs": {
    "requeued": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "conversation_id", "session_ref", "run_ref", "claim_ref", "trigger_count"],
      "properties": {
        "protocol": {"const": "forest.conversation-run-requeued/1"},
        "conversation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "session_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "run_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "claim_ref": {"type": "string", "pattern": "^claim:[a-f0-9]{64}$"},
        "trigger_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
