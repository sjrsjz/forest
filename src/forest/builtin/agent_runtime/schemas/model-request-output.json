{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["request_id", "step_seq", "request_kind", "state", "attempt_count"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "step_seq": {"type": "integer", "minimum": 1},
    "request_kind": {"enum": ["PRIMARY", "CONTINUATION", "REPAIR"]},
    "state": {"enum": ["READY", "ATTEMPT_PREPARED", "DISPATCHING", "SUCCEEDED", "NOT_APPLIED", "UNKNOWN", "ABANDONED"]},
    "attempt_count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
