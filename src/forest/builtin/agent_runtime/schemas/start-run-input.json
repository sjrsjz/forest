{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/start",
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "payload": {
      "type": "object",
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"const": "agent.runtime"},
        "owner_kind": {"enum": ["module.configuration", "preset.context"]},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "required": ["trigger_ref", "principal_ref", "ingress_seq"],
      "properties": {
        "trigger_ref": {"$ref": "#/$defs/id"},
        "principal_ref": {"$ref": "#/$defs/id"},
        "ingress_seq": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "batch": {
      "type": "object",
      "required": [
        "input_batch_ref", "input_batch_digest", "selected_input_end_seq",
        "context_revision", "context_view_revision", "source_manifest_digest", "triggers"
      ],
      "properties": {
        "input_batch_ref": {"$ref": "#/$defs/id"},
        "input_batch_digest": {"$ref": "#/$defs/digest"},
        "selected_input_end_seq": {"type": "integer", "minimum": 1},
        "context_revision": {"type": "integer", "minimum": 1},
        "context_view_revision": {"type": "integer", "minimum": 0},
        "source_manifest_digest": {"$ref": "#/$defs/digest"},
        "triggers": {
          "type": "array", "minItems": 1, "maxItems": 4096,
          "items": {"$ref": "#/$defs/trigger"}
        }
      },
      "additionalProperties": false
    },
    "start": {
      "type": "object",
      "required": [
        "conversation_ref", "session_id", "run_id", "input_batch", "agent_spec_revision",
        "config", "preset_revision", "preset", "absolute_deadline"
      ],
      "properties": {
        "conversation_ref": {"$ref": "#/$defs/id"},
        "session_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "input_batch": {"$ref": "#/$defs/batch"},
        "agent_spec_revision": {"$ref": "#/$defs/id"},
        "config": {"$ref": "#/$defs/payload"},
        "preset_revision": {"$ref": "#/$defs/id"},
        "preset": {"$ref": "#/$defs/payload"},
        "absolute_deadline": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
