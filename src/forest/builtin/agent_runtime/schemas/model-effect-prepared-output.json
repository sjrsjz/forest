{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "attempt_id", "request_id", "attempt_no", "effect_operation_ref",
    "state", "authorization_ticket_id", "input_payload", "wire_payload", "permit"
  ],
  "properties": {
    "protocol": {"const": "forest.agent-model-effect-prepared/1"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "request_id": {"$ref": "#/$defs/id"},
    "attempt_no": {"type": "integer", "minimum": 1},
    "effect_operation_ref": {"$ref": "#/$defs/id"},
    "state": {"enum": ["PREPARED", "DISPATCHING", "SUCCEEDED", "NOT_APPLIED", "UNKNOWN", "ABANDONED"]},
    "authorization_ticket_id": {"$ref": "#/$defs/id"},
    "input_payload": {"$ref": "#/$defs/payload_ref"},
    "wire_payload": {"$ref": "#/$defs/payload_ref"},
    "permit": {"$ref": "#/$defs/permit"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "payload_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"$ref": "#/$defs/id"},
        "owner_kind": {"$ref": "#/$defs/id"},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "permit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol", "effect_operation_id", "attempt_id", "attempt_no", "wire_payload_id",
        "wire_payload_digest", "executor_component_id", "executor_generation_id",
        "fence_kind", "fence_id", "fence_epoch", "deadline_at"
      ],
      "properties": {
        "protocol": {"const": "forest.effect-permit/1"},
        "effect_operation_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "attempt_no": {"type": "integer", "minimum": 1},
        "wire_payload_id": {"$ref": "#/$defs/id"},
        "wire_payload_digest": {"$ref": "#/$defs/digest"},
        "executor_component_id": {"$ref": "#/$defs/id"},
        "executor_generation_id": {"$ref": "#/$defs/id"},
        "fence_kind": {"const": "runtime.graph"},
        "fence_id": {"$ref": "#/$defs/id"},
        "fence_epoch": {"type": "integer", "minimum": 1},
        "deadline_at": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    }
  }
}
