{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["conversation", "payload_epoch", "memory", "agent"],
  "properties": {
    "conversation": {
      "type": "object", "additionalProperties": false,
      "required": ["actor", "boundary", "selection_mode", "session_ref", "run_ref", "next_run_ref"],
      "properties": {
        "actor": {"$ref": "#/$defs/actor"},
        "boundary": {"const": "IDLE"},
        "selection_mode": {"const": "ANY"},
        "session_ref": {"$ref": "#/$defs/id"},
        "run_ref": {"$ref": "#/$defs/id"},
        "next_run_ref": {"type": "null"}
      }
    },
    "payload_epoch": {"const": {"protocol": "forest.payload-epoch-capture/1"}},
    "memory": {"const": {"selection_step_id": "conversation", "deletion_epoch_step_id": "payload_epoch"}},
    "agent": {"$ref": "#/$defs/agent"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["conversation_id", "owner_id", "epoch"],
      "properties": {
        "conversation_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "epoch": {"type": "integer", "minimum": 1}
      }
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"const": "agent.runtime"},
        "owner_kind": {"enum": ["module.configuration", "preset.context"]},
        "owner_id": {"$ref": "#/$defs/id"}
      }
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": [
        "conversation_ref", "session_id", "run_id", "agent_spec_revision", "config",
        "preset_revision", "preset", "absolute_deadline", "selection_step_id", "memory_step_id"
      ],
      "properties": {
        "conversation_ref": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"}, "agent_spec_revision": {"$ref": "#/$defs/id"},
        "config": {"$ref": "#/$defs/payload"}, "preset_revision": {"$ref": "#/$defs/id"},
        "preset": {"$ref": "#/$defs/payload"},
        "absolute_deadline": {"type": "string", "minLength": 1, "maxLength": 64},
        "selection_step_id": {"const": "conversation"}, "memory_step_id": {"const": "memory"}
      }
    }
  }
}
