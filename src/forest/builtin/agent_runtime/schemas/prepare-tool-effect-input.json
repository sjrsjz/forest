{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["authorization", "effect", "agent"],
  "properties": {
    "approval": {"$ref": "#/$defs/approval"},
    "authorization": {"$ref": "#/$defs/authorization"},
    "effect": {"$ref": "#/$defs/effect"},
    "agent": {"$ref": "#/$defs/agent"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "owner_id", "epoch"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"}, "owner_id": {"$ref": "#/$defs/id"},
        "epoch": {"type": "integer", "minimum": 1}
      }
    },
    "payload_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"$ref": "#/$defs/id"}, "owner_kind": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "approval_id", "request_kind", "request_id", "action", "input_digest", "plan_digest", "consume_operation_id"],
      "properties": {
        "protocol": {"const": "forest.approval-consume/1"}, "approval_id": {"$ref": "#/$defs/id"},
        "request_kind": {"const": "agent.tool"}, "request_id": {"$ref": "#/$defs/id"},
        "action": {"const": "tool.invoke"}, "input_digest": {"$ref": "#/$defs/digest"},
        "plan_digest": {"$ref": "#/$defs/digest"}, "consume_operation_id": {"$ref": "#/$defs/id"}
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "ticket_id", "issuance_operation_id", "operation_id", "action", "resource_kind", "resource_id", "input_digest", "plan_digest", "expires_at", "audience_component_id", "audience_generation_id"],
      "properties": {
        "protocol": {"const": "forest.authorization-issue/1"}, "ticket_id": {"$ref": "#/$defs/id"},
        "issuance_operation_id": {"$ref": "#/$defs/id"}, "operation_id": {"$ref": "#/$defs/id"},
        "action": {"const": "tool.invoke"}, "resource_kind": {"const": "bot"},
        "resource_id": {"$ref": "#/$defs/id"}, "input_digest": {"$ref": "#/$defs/digest"},
        "plan_digest": {"$ref": "#/$defs/digest"}, "expires_at": {"type": "string", "minLength": 1, "maxLength": 64},
        "audience_component_id": {"$ref": "#/$defs/id"}, "audience_generation_id": {"$ref": "#/$defs/id"}
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "effect_operation_id", "input_digest", "effect_kind", "target_kind", "target_id", "attempt_id", "permit_operation_id", "authorization_step_id", "authorization", "executor", "deadline_at", "command"],
      "properties": {
        "protocol": {"const": "forest.effect-command-prepare/1"}, "effect_operation_id": {"$ref": "#/$defs/id"},
        "input_digest": {"$ref": "#/$defs/digest"}, "effect_kind": {"const": "tool.dispatch"},
        "target_kind": {"const": "component.service"}, "target_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"}, "permit_operation_id": {"$ref": "#/$defs/id"},
        "authorization_step_id": {"const": "authorization"},
        "authorization": {
          "type": "object", "additionalProperties": false,
          "required": ["action", "resource_kind", "resource_id", "plan_digest"],
          "properties": {"action": {"const": "tool.invoke"}, "resource_kind": {"const": "bot"}, "resource_id": {"$ref": "#/$defs/id"}, "plan_digest": {"$ref": "#/$defs/digest"}}
        },
        "executor": {
          "type": "object", "additionalProperties": false,
          "required": ["component_id", "generation_id", "fence_kind", "fence_id", "fence_epoch"],
          "properties": {"component_id": {"$ref": "#/$defs/id"}, "generation_id": {"$ref": "#/$defs/id"}, "fence_kind": {"const": "runtime.graph"}, "fence_id": {"$ref": "#/$defs/id"}, "fence_epoch": {"type": "integer", "minimum": 1}}
        },
        "deadline_at": {"type": "string", "minLength": 1, "maxLength": 64},
        "command": {
          "type": "object", "additionalProperties": false, "required": ["value", "parents"],
          "properties": {"value": {"type": "object"}, "parents": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/payload_ref"}}}
        }
      }
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "tool_call_id", "effect_operation_ref", "effect_attempt_id", "command_digest", "effect_step_id"],
      "properties": {
        "owner": {"$ref": "#/$defs/owner"}, "tool_call_id": {"$ref": "#/$defs/id"},
        "effect_operation_ref": {"$ref": "#/$defs/id"}, "effect_attempt_id": {"$ref": "#/$defs/id"},
        "command_digest": {"$ref": "#/$defs/digest"}, "effect_step_id": {"const": "effect"},
        "approval_step_id": {"const": "approval"}
      }
    }
  }
}
