{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["effect", "owner", "request_id", "attempt_id", "checkpoint_id", "checkpoint_state"],
  "properties": {
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "attempts"],
      "properties": {
        "protocol": {"const": "forest.effect-unsent-proof-request/1"},
        "attempts": {"type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["effect_operation_id", "attempt_id"],
            "properties": {
              "effect_operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
              "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256}
            }
          }
        }
      }
    },
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "owner_id", "epoch"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "epoch": {"type": "integer", "minimum": 1}
      }
    },
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "checkpoint_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "checkpoint_state": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "owner_component_id": {"const": "agent.runtime"},
        "owner_kind": {"const": "checkpoint.state"},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
