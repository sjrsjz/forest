{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["effect", "agent"],
  "properties": {
    "effect": {"$ref": "#/$defs/effect"},
    "agent": {"$ref": "#/$defs/agent"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "owner": {
      "type": "object",
      "required": ["run_id", "owner_id", "epoch"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "epoch": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "effect_payload": {
      "type": "object",
      "required": ["payload_id", "digest"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "agent_payload": {
      "type": "object",
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"$ref": "#/$defs/id"},
        "owner_kind": {"enum": ["model.result", "model.usage"]},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": [
        "protocol", "effect_operation_id", "attempt_id", "observation_operation_id",
        "status", "evidence_kind", "evidence_payload"
      ],
      "properties": {
        "protocol": {"const": "forest.effect-observe/1"},
        "effect_operation_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "observation_operation_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["SUCCEEDED", "NOT_APPLIED", "UNKNOWN"]},
        "evidence_kind": {"enum": ["executor", "reconciliation"]},
        "evidence_payload": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/effect_payload"}]
        }
      },
      "additionalProperties": false
    },
    "agent_entry": {
      "type": "object",
      "required": ["role", "payload"],
      "properties": {
        "role": {"enum": ["RESULT", "USAGE"]},
        "payload": {"$ref": "#/$defs/agent_payload"}
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": [
        "owner", "observation_operation_id", "request_id", "attempt_id",
        "observed_state", "evidence_kind", "effect_observation_ref", "payloads"
      ],
      "properties": {
        "owner": {"$ref": "#/$defs/owner"},
        "observation_operation_id": {"$ref": "#/$defs/id"},
        "request_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "observed_state": {"enum": ["SUCCEEDED", "NOT_APPLIED", "UNKNOWN"]},
        "evidence_kind": {"enum": ["EXECUTOR", "RECONCILIATION"]},
        "effect_observation_ref": {"$ref": "#/$defs/id"},
        "payloads": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "#/$defs/agent_entry"}
        }
      },
      "additionalProperties": false
    }
  }
}
