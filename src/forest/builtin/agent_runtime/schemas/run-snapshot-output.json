{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id", "session_id", "conversation_ref", "state", "profile", "absolute_deadline",
    "progress", "owner", "current", "final_candidate", "error_code", "session",
    "inputs", "triggers", "cancel_request", "created_at", "updated_at", "terminal_at"
  ],
  "properties": {
    "run_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "conversation_ref": {"$ref": "#/$defs/id"},
    "state": {"$ref": "#/$defs/run_state"},
    "profile": {"$ref": "#/$defs/profile"},
    "absolute_deadline": {"$ref": "#/$defs/time"},
    "progress": {"$ref": "#/$defs/progress"},
    "owner": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/owner"}]
    },
    "current": {"$ref": "#/$defs/current"},
    "final_candidate": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/final_candidate"}]
    },
    "error_code": {"$ref": "#/$defs/nullable_string"},
    "session": {"$ref": "#/$defs/session"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "triggers": {"type": "array", "items": {"$ref": "#/$defs/trigger"}},
    "cancel_request": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/cancel"}]
    },
    "created_at": {"$ref": "#/$defs/time"},
    "updated_at": {"$ref": "#/$defs/time"},
    "terminal_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/time"}]}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "time": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "nullable_string": {"type": ["string", "null"]},
    "run_state": {
      "enum": [
        "WAIT_INPUT", "PREPARING_MODEL", "MODEL_PENDING", "PARSING", "REPAIR_READY",
        "WAIT_TOOL", "WAIT_APPROVAL", "BLOCKED_UNKNOWN", "SAFE_BOUNDARY", "FINAL_READY",
        "RELOAD_WAIT", "COMPLETED", "FAILED", "CANCELLED"
      ]
    },
    "payload": {
      "type": "object",
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"$ref": "#/$defs/id"},
        "owner_kind": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": [
        "agent_spec_revision", "config", "preset_revision", "preset", "core_protocol_id",
        "core_protocol_version", "core_prompt_digest", "parser_revision"
      ],
      "properties": {
        "agent_spec_revision": {"$ref": "#/$defs/id"},
        "config": {"$ref": "#/$defs/payload"},
        "preset_revision": {"$ref": "#/$defs/id"},
        "preset": {"$ref": "#/$defs/payload"},
        "core_protocol_id": {"$ref": "#/$defs/id"},
        "core_protocol_version": {"type": "integer", "minimum": 1},
        "core_prompt_digest": {"$ref": "#/$defs/digest"},
        "parser_revision": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": [
        "input_revision", "selected_input_end_seq", "context_revision", "context_view_revision",
        "next_step_seq", "checkpoint_seq", "repair_count", "tool_count", "thinking_count"
      ],
      "properties": {
        "input_revision": {"type": "integer", "minimum": 1},
        "selected_input_end_seq": {"type": "integer", "minimum": 0},
        "context_revision": {"type": "integer", "minimum": 1},
        "context_view_revision": {"type": "integer", "minimum": 0},
        "next_step_seq": {"type": "integer", "minimum": 1},
        "checkpoint_seq": {"type": "integer", "minimum": 0},
        "repair_count": {"type": "integer", "minimum": 0},
        "tool_count": {"type": "integer", "minimum": 0},
        "thinking_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "required": ["owner_id", "epoch", "expires_at"],
      "properties": {
        "owner_id": {"$ref": "#/$defs/id"},
        "epoch": {"type": "integer", "minimum": 1},
        "expires_at": {"$ref": "#/$defs/time"}
      },
      "additionalProperties": false
    },
    "current": {
      "type": "object",
      "required": [
        "model_request_id", "tool_call_id", "reload_operation_id", "reload_resume_phase",
        "reload_generation_id"
      ],
      "properties": {
        "model_request_id": {"$ref": "#/$defs/nullable_string"},
        "tool_call_id": {"$ref": "#/$defs/nullable_string"},
        "reload_operation_id": {"$ref": "#/$defs/nullable_string"},
        "reload_resume_phase": {
          "type": ["string", "null"],
          "enum": [null, "PREPARING_MODEL", "WAIT_TOOL", "WAIT_APPROVAL"]
        },
        "reload_generation_id": {"$ref": "#/$defs/nullable_string"}
      },
      "additionalProperties": false
    },
    "final_candidate": {
      "type": "object",
      "required": ["payload_id", "digest"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": [
        "state", "active_run_id", "session_epoch", "terminal_reason_code", "created_at",
        "updated_at", "closed_at"
      ],
      "properties": {
        "state": {"enum": ["ACTIVE", "CLOSED", "FAILED", "CANCELLED"]},
        "active_run_id": {"$ref": "#/$defs/nullable_string"},
        "session_epoch": {"type": "integer", "minimum": 1},
        "terminal_reason_code": {"$ref": "#/$defs/nullable_string"},
        "created_at": {"$ref": "#/$defs/time"},
        "updated_at": {"$ref": "#/$defs/time"},
        "closed_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/time"}]}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": [
        "input_revision", "input_batch_ref", "input_batch_digest", "selected_input_end_seq",
        "context_revision", "context_view_revision", "source_manifest_digest", "trigger_count",
        "created_at"
      ],
      "properties": {
        "input_revision": {"type": "integer", "minimum": 1},
        "input_batch_ref": {"$ref": "#/$defs/id"},
        "input_batch_digest": {"$ref": "#/$defs/digest"},
        "selected_input_end_seq": {"type": "integer", "minimum": 0},
        "context_revision": {"type": "integer", "minimum": 1},
        "context_view_revision": {"type": "integer", "minimum": 0},
        "source_manifest_digest": {"$ref": "#/$defs/digest"},
        "trigger_count": {"type": "integer", "minimum": 1},
        "created_at": {"$ref": "#/$defs/time"}
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "required": ["input_revision", "trigger_index", "trigger_ref", "principal_ref", "ingress_seq"],
      "properties": {
        "input_revision": {"type": "integer", "minimum": 1},
        "trigger_index": {"type": "integer", "minimum": 0},
        "trigger_ref": {"$ref": "#/$defs/id"},
        "principal_ref": {"$ref": "#/$defs/id"},
        "ingress_seq": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "required": [
        "operation_id", "input_digest", "expected_checkpoint_seq", "requested_by",
        "reason_code", "created_at"
      ],
      "properties": {
        "operation_id": {"$ref": "#/$defs/id"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "expected_checkpoint_seq": {"type": "integer", "minimum": 0},
        "requested_by": {"$ref": "#/$defs/id"},
        "reason_code": {"$ref": "#/$defs/id"},
        "created_at": {"$ref": "#/$defs/time"}
      },
      "additionalProperties": false
    }
  }
}
