{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {"$ref": "#/$defs/caller"},
    "input": {"$ref": "#/$defs/input"},
    "prior": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "caller": {
      "type": "object",
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "conversation.scheduler"},
        "generation_id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "required": ["trigger_ref", "principal_ref", "ingress_seq"],
      "properties": {
        "trigger_ref": {"$ref": "#/$defs/id"},
        "principal_ref": {"$ref": "#/$defs/id"},
        "ingress_seq": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "batch": {
      "type": "object",
      "required": [
        "input_batch_ref", "input_batch_digest", "selected_input_end_seq",
        "context_revision", "context_view_revision", "source_manifest_digest", "triggers"
      ],
      "properties": {
        "input_batch_ref": {"$ref": "#/$defs/id"},
        "input_batch_digest": {"$ref": "#/$defs/digest"},
        "selected_input_end_seq": {"type": "integer", "minimum": 1},
        "context_revision": {"type": "integer", "minimum": 1},
        "context_view_revision": {"type": "integer", "minimum": 0},
        "source_manifest_digest": {"$ref": "#/$defs/digest"},
        "triggers": {
          "type": "array", "minItems": 1, "maxItems": 4096,
          "items": {"$ref": "#/$defs/trigger"}
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": [
        "session_id", "completed_run_id", "run_id", "input_batch", "absolute_deadline"
      ],
      "properties": {
        "session_id": {"$ref": "#/$defs/id"},
        "completed_run_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "input_batch": {"$ref": "#/$defs/batch"},
        "absolute_deadline": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
