{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["effect", "agent"], "properties": {"effect": {"$ref": "#/$defs/effect"}, "agent": {"$ref": "#/$defs/agent"}},
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "owner": {"type": "object", "additionalProperties": false, "required": ["run_id", "owner_id", "epoch"], "properties": {"run_id": {"$ref": "#/$defs/id"}, "owner_id": {"$ref": "#/$defs/id"}, "epoch": {"type": "integer", "minimum": 1}}},
    "permit": {"type": "object", "additionalProperties": false, "required": ["protocol", "effect_operation_id", "attempt_id", "attempt_no", "wire_payload_id", "wire_payload_digest", "executor_component_id", "executor_generation_id", "fence_kind", "fence_id", "fence_epoch", "deadline_at"], "properties": {"protocol": {"const": "forest.effect-permit/1"}, "effect_operation_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "attempt_no": {"type": "integer", "minimum": 1}, "wire_payload_id": {"$ref": "#/$defs/id"}, "wire_payload_digest": {"$ref": "#/$defs/digest"}, "executor_component_id": {"$ref": "#/$defs/id"}, "executor_generation_id": {"$ref": "#/$defs/id"}, "fence_kind": {"const": "runtime.graph"}, "fence_id": {"$ref": "#/$defs/id"}, "fence_epoch": {"type": "integer", "minimum": 1}, "deadline_at": {"type": "string", "minLength": 1, "maxLength": 64}}},
    "effect": {"type": "object", "additionalProperties": false, "required": ["protocol", "permit", "handoff_operation_id"], "properties": {"protocol": {"const": "forest.effect-handoff/1"}, "permit": {"$ref": "#/$defs/permit"}, "handoff_operation_id": {"$ref": "#/$defs/id"}}},
    "agent": {"type": "object", "additionalProperties": false, "required": ["owner", "observation_operation_id", "tool_call_id", "effect_attempt_id", "effect_step_id"], "properties": {"owner": {"$ref": "#/$defs/owner"}, "observation_operation_id": {"$ref": "#/$defs/id"}, "tool_call_id": {"$ref": "#/$defs/id"}, "effect_attempt_id": {"$ref": "#/$defs/id"}, "effect_step_id": {"const": "effect"}}}
  }
}
