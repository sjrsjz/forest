{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["run_id", "state", "error_code"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "state": {"const": "FAILED"},
    "error_code": {"enum": ["AGENT_CONTEXT_REQUIRED_OVER_BUDGET", "AGENT_MODEL_INPUT_BYTES_EXCEEDED"]}
  }
}
