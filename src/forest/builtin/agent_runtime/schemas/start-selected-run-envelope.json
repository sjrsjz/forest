{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "agent.runtime"},
        "generation_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "input": {"$ref": "#/$defs/input"},
    "prior": {
      "type": "object",
      "required": ["conversation", "memory"],
      "properties": {
        "conversation": {"type": "object"},
        "memory": {"type": "object"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"const": "agent.runtime"},
        "owner_kind": {"enum": ["module.configuration", "preset.context"]},
        "owner_id": {"$ref": "#/$defs/id"}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": [
        "conversation_ref", "session_id", "run_id", "agent_spec_revision", "config",
        "preset_revision", "preset", "absolute_deadline", "selection_step_id", "memory_step_id"
      ],
      "properties": {
        "conversation_ref": {"$ref": "#/$defs/id"},
        "session_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "agent_spec_revision": {"$ref": "#/$defs/id"},
        "config": {"$ref": "#/$defs/payload"},
        "preset_revision": {"$ref": "#/$defs/id"},
        "preset": {"$ref": "#/$defs/payload"},
        "absolute_deadline": {"type": "string", "minLength": 1, "maxLength": 64},
        "selection_step_id": {"const": "conversation"},
        "memory_step_id": {"const": "memory"}
      }
    }
  }
}
