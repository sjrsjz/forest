{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol", "agent_spec_revision", "preset_revision", "preset",
    "run_timeout_seconds", "max_steps", "output_tokens", "stream"
  ],
  "properties": {
    "protocol": {"const": "forest.agent.runtime/1"},
    "agent_spec_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "preset_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "preset": {
      "type": "object",
      "required": ["payload_id", "digest", "owner_id"],
      "properties": {
        "payload_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    },
    "run_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 256},
    "output_tokens": {"type": "integer", "minimum": 1, "maximum": 131072},
    "stream": {"type": "boolean"}
  },
  "additionalProperties": false
}
