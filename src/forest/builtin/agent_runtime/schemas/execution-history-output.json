{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "run_id", "turns"],
  "properties": {
    "protocol": {"const": "forest.agent-execution-history/1"},
    "run_id": {"$ref": "#/$defs/id"},
    "turns": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/turn"}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "nullable_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "nullable_digest": {
      "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_id", "request_id", "step_seq", "input_revision",
        "provider_component_id", "model_attempt_id", "model_result_payload_id",
        "model_result_payload_digest", "tool_call_id", "tool_name",
        "tool_component_id", "tool_state", "function_call_payload_id",
        "function_call_payload_digest", "result_payload_id", "result_payload_digest",
        "tool_error_code"
      ],
      "properties": {
        "turn_id": {"$ref": "#/$defs/id"},
        "request_id": {"$ref": "#/$defs/id"},
        "step_seq": {"type": "integer", "minimum": 1},
        "input_revision": {"type": "integer", "minimum": 1},
        "provider_component_id": {"$ref": "#/$defs/id"},
        "model_attempt_id": {"$ref": "#/$defs/id"},
        "model_result_payload_id": {"$ref": "#/$defs/id"},
        "model_result_payload_digest": {"$ref": "#/$defs/digest"},
        "tool_call_id": {"$ref": "#/$defs/nullable_id"},
        "tool_name": {"$ref": "#/$defs/nullable_id"},
        "tool_component_id": {"$ref": "#/$defs/nullable_id"},
        "tool_state": {
          "type": ["string", "null"],
          "enum": [null, "PROPOSED", "WAIT_APPROVAL", "DISPATCHING", "SUCCEEDED", "FAILED", "CANCELLED", "UNKNOWN"]
        },
        "function_call_payload_id": {"$ref": "#/$defs/nullable_id"},
        "function_call_payload_digest": {"$ref": "#/$defs/nullable_digest"},
        "result_payload_id": {"$ref": "#/$defs/nullable_id"},
        "result_payload_digest": {"$ref": "#/$defs/nullable_digest"},
        "tool_error_code": {"$ref": "#/$defs/nullable_id"}
      }
    }
  }
}
