{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "kind", "snapshot_at", "filter_digest", "items", "has_more", "next_cursor"],
  "properties": {
    "run_id": {"type": "string"},
    "kind": {"enum": ["MODEL_TURN", "TOOL_CALL"]},
    "snapshot_at": {"type": "string", "format": "date-time"},
    "filter_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "items": {"type": "array", "maxItems": 100, "items": {
      "oneOf": [
        {"$ref": "#/$defs/model_turn"},
        {"$ref": "#/$defs/tool_call"}
      ]
    }},
    "has_more": {"type": "boolean"},
    "next_cursor": {"oneOf": [
      {"type": "null"},
      {"type": "object", "additionalProperties": false,
       "required": ["step_seq"],
       "properties": {"step_seq": {"type": "integer", "minimum": 1}}}
    ]}
  },
  "$defs": {
    "model_turn": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "turn_id", "request_id", "step_seq", "terminal", "thinking_only", "truncated_after_function_call", "repair_of_request_id", "raw_candidate_digest", "created_at"],
      "properties": {
        "kind": {"const": "MODEL_TURN"},
        "turn_id": {"type": "string"},
        "request_id": {"type": "string"},
        "step_seq": {"type": "integer", "minimum": 1},
        "terminal": {"type": "boolean"},
        "thinking_only": {"type": "boolean"},
        "truncated_after_function_call": {"type": "boolean"},
        "repair_of_request_id": {"type": ["string", "null"]},
        "raw_candidate_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "tool_call": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "tool_call_id", "turn_id", "step_seq", "tool_name", "tool_component_id", "tool_generation_id", "tool_service_id", "state", "approval_required", "supports_query", "error_code", "created_at", "updated_at"],
      "properties": {
        "kind": {"const": "TOOL_CALL"},
        "tool_call_id": {"type": "string"},
        "turn_id": {"type": "string"},
        "step_seq": {"type": "integer", "minimum": 1},
        "tool_name": {"type": "string"},
        "tool_component_id": {"type": "string"},
        "tool_generation_id": {"type": "string"},
        "tool_service_id": {"type": "string"},
        "state": {"enum": ["PROPOSED", "WAIT_APPROVAL", "DISPATCHING", "SUCCEEDED", "FAILED", "CANCELLED", "UNKNOWN"]},
        "approval_required": {"type": "boolean"},
        "supports_query": {"type": "boolean"},
        "error_code": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
