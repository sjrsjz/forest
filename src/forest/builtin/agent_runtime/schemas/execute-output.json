{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "status", "session_ref", "run_ref", "reply",
    "answered_trigger_ids", "approval_ref", "error_code"
  ],
  "properties": {
    "protocol": {"const": "forest.agent-execution/2"},
    "status": {
      "enum": [
        "IDLE", "WAIT_INPUT", "WAIT_TOOL", "WAIT_APPROVAL", "BLOCKED_UNKNOWN",
        "RELOAD_WAIT", "FINAL_READY", "COMPLETED", "FAILED", "CANCELLED"
      ]
    },
    "session_ref": {"$ref": "#/$defs/id"},
    "run_ref": {"$ref": "#/$defs/id"},
    "reply": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/reply"}]
    },
    "answered_trigger_ids": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/id"}
    },
    "approval_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "error_code": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"const": "agent.runtime"},
        "owner_kind": {"const": "final.reply"},
        "owner_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
