{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "status", "run", "memory_qualified_count", "memory_pending_count"],
  "properties": {
    "protocol": {"const": "forest.agent-start-selection/1"},
    "status": {"enum": ["STARTED", "IDLE"]},
    "run": {"oneOf": [{"type": "object"}, {"type": "null"}]},
    "memory_qualified_count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "memory_pending_count": {"type": "integer", "minimum": 0, "maximum": 100000}
  }
}
