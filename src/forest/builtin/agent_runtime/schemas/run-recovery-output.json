{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id", "state", "next_step_seq", "repair_count", "cancel_request",
    "model_request", "model_attempt", "tool_call", "latest_turn", "protocol_failure"
  ],
  "properties": {
    "run_id": {"$ref": "#/$defs/id"},
    "state": {"$ref": "#/$defs/run_state"},
    "next_step_seq": {"type": "integer", "minimum": 1},
    "repair_count": {"type": "integer", "minimum": 0},
    "cancel_request": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/cancel"}]},
    "model_request": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/model_request"}]},
    "model_attempt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/model_attempt"}]},
    "tool_call": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/tool_call"}]},
    "latest_turn": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/model_turn"}]},
    "protocol_failure": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/protocol_failure"}]}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "run_state": {
      "enum": [
        "WAIT_INPUT", "PREPARING_MODEL", "MODEL_PENDING", "PARSING", "REPAIR_READY",
        "WAIT_TOOL", "WAIT_APPROVAL", "BLOCKED_UNKNOWN", "SAFE_BOUNDARY", "FINAL_READY",
        "RELOAD_WAIT", "COMPLETED", "FAILED", "CANCELLED"
      ]
    },
    "cancel": {
      "type": "object",
      "required": ["operation_id", "reason_code"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/id"},
        "reason_code": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "model_request": {
      "type": "object",
      "required": [
        "request_id", "step_seq", "request_kind", "provider_component_id", "state",
        "attempt_count"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/id"},
        "step_seq": {"type": "integer", "minimum": 1},
        "request_kind": {"enum": ["PRIMARY", "CONTINUATION", "REPAIR"]},
        "provider_component_id": {"$ref": "#/$defs/id"},
        "state": {
          "enum": [
            "READY", "ATTEMPT_PREPARED", "DISPATCHING", "SUCCEEDED", "NOT_APPLIED",
            "UNKNOWN", "ABANDONED"
          ]
        },
        "attempt_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "model_attempt": {
      "type": "object",
      "required": ["attempt_id", "effect_operation_ref", "state", "result_payload_id"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/id"},
        "effect_operation_ref": {"$ref": "#/$defs/id"},
        "state": {
          "enum": ["PREPARED", "DISPATCHING", "SUCCEEDED", "NOT_APPLIED", "UNKNOWN", "ABANDONED"]
        },
        "result_payload_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    },
    "tool_call": {
      "type": "object",
      "required": [
        "tool_call_id", "tool_name", "tool_component_id", "tool_generation_id",
        "tool_service_id", "arguments_payload_id", "authority_trigger_ref",
        "authority_principal_ref", "tool_contract_digest", "tool_binding_digest",
        "approval_required", "supports_query", "effect_operation_ref", "approval_ref", "state"
      ],
      "properties": {
        "tool_call_id": {"$ref": "#/$defs/id"},
        "tool_name": {"$ref": "#/$defs/id"},
        "tool_component_id": {"$ref": "#/$defs/id"},
        "tool_generation_id": {"$ref": "#/$defs/id"},
        "tool_service_id": {"$ref": "#/$defs/id"},
        "arguments_payload_id": {"$ref": "#/$defs/id"},
        "authority_trigger_ref": {"$ref": "#/$defs/id"},
        "authority_principal_ref": {"$ref": "#/$defs/id"},
        "tool_contract_digest": {"$ref": "#/$defs/digest"},
        "tool_binding_digest": {"$ref": "#/$defs/digest"},
        "approval_required": {"type": "boolean"},
        "supports_query": {"type": "boolean"},
        "effect_operation_ref": {"$ref": "#/$defs/id"},
        "approval_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
        "state": {
          "enum": ["PROPOSED", "WAIT_APPROVAL", "DISPATCHING", "SUCCEEDED", "FAILED", "CANCELLED", "UNKNOWN"]
        }
      },
      "additionalProperties": false
    },
    "model_turn": {
      "type": "object",
      "required": ["turn_id", "request_id", "step_seq", "assistant_payload_id", "terminal"],
      "properties": {
        "turn_id": {"$ref": "#/$defs/id"},
        "request_id": {"$ref": "#/$defs/id"},
        "step_seq": {"type": "integer", "minimum": 1},
        "assistant_payload_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
        "terminal": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "protocol_failure": {
      "type": "object",
      "required": [
        "failed_request_id", "error_code", "candidate_digest", "feedback_payload_id",
        "resulting_state", "repair_step_seq"
      ],
      "properties": {
        "failed_request_id": {"$ref": "#/$defs/id"},
        "error_code": {"$ref": "#/$defs/id"},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "feedback_payload_id": {"$ref": "#/$defs/id"},
        "resulting_state": {"enum": ["REPAIR_READY", "FAILED"]},
        "repair_step_seq": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
