{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object", "required": ["component_id", "generation_id"],
      "properties": {"component_id": {"const": "agent.runtime"}, "generation_id": {"type": "string", "minLength": 1, "maxLength": 256}},
      "additionalProperties": false
    },
    "input": {"$ref": "#/$defs/input"}, "prior": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "owner": {"type": "object", "required": ["run_id", "owner_id", "epoch"], "properties": {"run_id": {"$ref": "#/$defs/id"}, "owner_id": {"$ref": "#/$defs/id"}, "epoch": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "block": {
      "oneOf": [
        {"type": "object", "required": ["block_type", "text"], "properties": {"block_type": {"const": "Thinking"}, "text": {"type": "string", "minLength": 1, "maxLength": 262144}}, "additionalProperties": false},
        {"type": "object", "required": ["block_type", "text"], "properties": {"block_type": {"const": "Assistant"}, "text": {"type": "string", "minLength": 1, "maxLength": 262144}}, "additionalProperties": false},
        {"type": "object", "required": ["block_type", "name", "arguments"], "properties": {"block_type": {"const": "FunctionCall"}, "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"}, "arguments": {"type": "object", "required": ["authority_trigger_id", "arguments"], "properties": {"authority_trigger_id": {"$ref": "#/$defs/id"}, "arguments": {"type": "object"}}, "additionalProperties": false}}, "additionalProperties": false}
      ]
    },
    "turn": {"type": "object", "required": ["protocol_version", "blocks", "raw_candidate_digest", "truncated_after_function_call"], "properties": {"protocol_version": {"const": 1}, "blocks": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/block"}}, "raw_candidate_digest": {"$ref": "#/$defs/digest"}, "truncated_after_function_call": {"type": "boolean"}}, "additionalProperties": false},
    "payload": {"type": "object", "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"], "properties": {"payload_id": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/digest"}, "owner_component_id": {"const": "agent.runtime"}, "owner_kind": {"enum": ["model.turn", "assistant.candidate", "tool.arguments"]}, "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}}, "additionalProperties": false},
    "artifact": {"type": "object", "required": ["role", "payload"], "properties": {"role": {"enum": ["TURN", "ASSISTANT", "TOOL_ARGUMENTS"]}, "payload": {"$ref": "#/$defs/payload"}}, "additionalProperties": false},
    "tool": {"type": "object", "required": ["tool_call_id", "component_id", "generation_id", "service_id", "tool_contract_digest", "tool_binding_digest", "approval_required", "supports_query", "authority_trigger_ref", "effect_operation_ref"], "properties": {"tool_call_id": {"$ref": "#/$defs/id"}, "component_id": {"$ref": "#/$defs/id"}, "generation_id": {"$ref": "#/$defs/id"}, "service_id": {"$ref": "#/$defs/id"}, "authority_trigger_ref": {"$ref": "#/$defs/id"}, "tool_contract_digest": {"$ref": "#/$defs/digest"}, "tool_binding_digest": {"$ref": "#/$defs/digest"}, "approval_required": {"type": "boolean"}, "supports_query": {"type": "boolean"}, "effect_operation_ref": {"$ref": "#/$defs/id"}}, "additionalProperties": false},
    "input": {
      "type": "object", "required": ["owner", "turn_id", "request_id", "turn", "artifacts", "tool", "repair_of_request_id"],
      "properties": {
        "owner": {"$ref": "#/$defs/owner"}, "turn_id": {"$ref": "#/$defs/id"}, "request_id": {"$ref": "#/$defs/id"}, "turn": {"$ref": "#/$defs/turn"},
        "artifacts": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/artifact"}, "allOf": [{"contains": {"type": "object", "properties": {"role": {"const": "TURN"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1}, {"contains": {"type": "object", "properties": {"role": {"const": "ASSISTANT"}}, "required": ["role"]}, "minContains": 0, "maxContains": 1}, {"contains": {"type": "object", "properties": {"role": {"const": "TOOL_ARGUMENTS"}}, "required": ["role"]}, "minContains": 0, "maxContains": 1}]},
        "tool": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/tool"}]}, "repair_of_request_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    }
  }
}
