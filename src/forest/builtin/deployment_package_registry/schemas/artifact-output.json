{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {"const": "forest.package-catalog-artifact/1"},
    "package_id": {"type": "string"},
    "package_version": {"type": "string"},
    "package_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "component_id": {"type": "string"},
    "scope": {"enum": ["bot", "deployment", "host"]},
    "runtime": {"type": "string"},
    "kernel_api": {"type": "string"},
    "configuration_schema_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "requested_capabilities": {"type": "array", "items": {"type": "string"}},
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "contract": {"type": "string"},
          "required": {"type": "boolean"},
          "startup_dependency": {"type": "boolean"}
        },
        "required": ["name", "contract", "required", "startup_dependency"],
        "additionalProperties": false
      }
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"name": {"type": "string"}, "contract": {"type": "string"}},
        "required": ["name", "contract"],
        "additionalProperties": false
      }
    },
    "storage_execution_profile": {"enum": ["declarative", "official", null]}
  },
  "required": [
    "protocol", "package_id", "package_version", "package_digest",
    "manifest_digest", "component_id", "scope", "runtime", "kernel_api",
    "configuration_schema_digest", "requested_capabilities", "requires", "provides",
    "storage_execution_profile"
  ],
  "additionalProperties": false
}
