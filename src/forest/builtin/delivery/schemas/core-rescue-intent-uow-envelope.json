{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "kernel.runtime"},
        "generation_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "intent_id", "binding_ref", "lane_kind", "ordering_key", "conversation_ref", "channel_kind", "channel_ref", "cause_component_id", "cause_kind", "cause_id", "delivery_generation_id", "reply_ref", "parts"],
      "properties": {
        "protocol": {"const": "forest.delivery-intent/1"},
        "intent_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "binding_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "lane_kind": {"const": "CONTROL"},
        "ordering_key": {"type": "string", "minLength": 1, "maxLength": 256},
        "conversation_ref": {"type": "null"},
        "channel_kind": {"const": "GROUP"},
        "channel_ref": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
        "cause_component_id": {"const": "kernel.runtime"},
        "cause_kind": {"const": "core.rescue.request"},
        "cause_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "delivery_generation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "reply_ref": {"type": "null"},
        "parts": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["part_operation_id", "effect_operation_ref", "payload"],
            "properties": {
              "part_operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
              "effect_operation_ref": {"type": "string", "minLength": 1, "maxLength": 256},
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
                "properties": {
                  "payload_id": {"type": "string", "minLength": 1, "maxLength": 256},
                  "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
                  "owner_component_id": {"const": "kernel.runtime"},
                  "owner_kind": {"const": "core.rescue.result"},
                  "owner_id": {"type": "string", "minLength": 1, "maxLength": 256}
                }
              }
            }
          }
        }
      }
    },
    "prior": {"type": "object"}
  }
}
