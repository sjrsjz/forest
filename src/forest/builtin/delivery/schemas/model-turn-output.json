{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "turn_id",
    "request_id",
    "step_seq",
    "terminal",
    "thinking_only",
    "truncated_after_function_call",
    "next_state",
    "tool_call_id"
  ],
  "properties": {
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "step_seq": {
      "type": "integer",
      "minimum": 1
    },
    "terminal": {
      "type": "boolean"
    },
    "thinking_only": {
      "type": "boolean"
    },
    "truncated_after_function_call": {
      "type": "boolean"
    },
    "next_state": {
      "enum": [
        "PREPARING_MODEL",
        "WAIT_TOOL",
        "SAFE_BOUNDARY"
      ]
    },
    "tool_call_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    }
  },
  "additionalProperties": false
}
