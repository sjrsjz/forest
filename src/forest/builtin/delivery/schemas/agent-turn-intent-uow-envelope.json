{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "caller",
    "input",
    "prior"
  ],
  "properties": {
    "protocol": {
      "const": "forest.uow-step/1"
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "generation_id"
      ],
      "properties": {
        "component_id": {
          "const": "agent.runtime"
        },
        "generation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload",
        "delivery_generation_id"
      ],
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payload_id",
            "digest",
            "owner_component_id",
            "owner_kind",
            "owner_id"
          ],
          "properties": {
            "payload_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "owner_component_id": {
              "const": "agent.runtime"
            },
            "owner_kind": {
              "const": "assistant.message"
            },
            "owner_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "delivery_generation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "prior": {
      "type": "object",
      "required": [
        "authority",
        "agent"
      ]
    }
  }
}
