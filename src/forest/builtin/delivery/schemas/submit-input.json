{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "binding_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "channel_kind": {
      "enum": [
        "GROUP",
        "PRIVATE"
      ]
    },
    "channel_ref": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "cause_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "text"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "format": {
            "enum": [
              "platform-markup",
              null
            ]
          }
        },
        "required": [
          "type",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "binding_ref",
    "channel_kind",
    "channel_ref",
    "parts",
    "cause_id"
  ],
  "additionalProperties": false
}
