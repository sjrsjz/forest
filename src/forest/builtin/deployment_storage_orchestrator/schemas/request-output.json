{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "bot_id", "profile_ref"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^storage-request/[a-f0-9]{64}$"},
    "bot_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "profile_ref": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
