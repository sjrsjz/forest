{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "state"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^storage-request/[a-f0-9]{64}$"},
    "state": {"enum": ["WAITING", "SETTLED", "BLOCKED"]},
    "error_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}
  }
}
