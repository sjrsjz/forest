{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "claim_token", "attempt_no"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^storage-request/[a-f0-9]{64}$"},
    "claim_token": {"type": "string", "pattern": "^storage-claim/[a-f0-9]{32}$"},
    "attempt_no": {"type": "integer", "minimum": 1}
  }
}
