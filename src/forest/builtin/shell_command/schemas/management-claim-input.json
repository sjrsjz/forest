{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {"const": "forest.shell-management-claim/1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "claim_token": {"type": "string", "minLength": 1, "maxLength": 256},
    "shell_generation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "principal_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "conversation_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "command_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "command_version": {"type": "integer", "minimum": 1},
    "arguments": {"type": "object"},
    "target_component_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_generation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "target_service_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_service_version": {"type": "integer", "minimum": 1},
