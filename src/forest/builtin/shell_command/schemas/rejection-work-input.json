{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": [
    "request_id", "claim_token", "binding_ref", "conversation_ref", "principal_ref",
    "command_id", "rejection_code", "rejection"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "claim_token": {"type": "string", "minLength": 1, "maxLength": 256},
    "binding_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "conversation_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "principal_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "command_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "rejection_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "rejection": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_id", "value"],
      "properties": {
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "value": {
          "type": "object", "additionalProperties": false,
          "required": ["text"],
          "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 4096}}
        }
      }
    }
  }
}
