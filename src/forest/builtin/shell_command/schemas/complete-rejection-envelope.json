{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "shell.command"},
        "generation_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "claim_token", "result"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "claim_token": {"type": "string", "minLength": 1, "maxLength": 256},
        "result": {
          "type": "object", "additionalProperties": false,
          "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
          "properties": {
            "payload_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "owner_component_id": {"const": "shell.command"},
            "owner_kind": {"const": "shell.result"},
            "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    },
    "prior": {"type": "object"}
  }
}
