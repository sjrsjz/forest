{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "request_id", "transport_attempt_id", "component_id", "generation_id", "profile_ref", "space_id", "purpose", "facets"],
  "properties": {
    "protocol": {"const": "forest.embedding-materialize/1"},
    "request_id": {"$ref": "#/$defs/id"},
    "transport_attempt_id": {"$ref": "#/$defs/id"},
    "component_id": {"const": "embedding.multimodal"},
    "generation_id": {"$ref": "#/$defs/id"},
    "profile_ref": {"type": "string", "pattern": "^profile:[a-f0-9]{64}$"},
    "space_id": {"$ref": "#/$defs/digest"},
    "purpose": {"enum": ["DOCUMENT", "QUERY"]},
    "facets": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/facet"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"$ref": "#/$defs/id"},
        "owner_kind": {"$ref": "#/$defs/id"},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "facet": {
      "type": "object", "additionalProperties": false,
      "required": ["facet_id", "part_id", "modality", "selector_start_char", "selector_end_char", "input_payload", "facet_content_digest", "input_byte_length", "media_type", "width", "height"],
      "oneOf": [
        {"required": ["source_unit_id", "source_revision", "trunk_id", "conversation_ref", "author_ref"],
         "not": {"required": ["input_kind"]}},
        {"required": ["input_kind", "input_ref", "input_revision", "query_id"],
         "properties": {"input_kind": {"const": "ADMIN_TRIAL"}},
         "not": {"anyOf": [
           {"required": ["source_unit_id"]}, {"required": ["source_revision"]},
           {"required": ["trunk_id"]}, {"required": ["conversation_ref"]},
           {"required": ["author_ref"]}
         ]}}
      ],
      "properties": {
        "facet_id": {"$ref": "#/$defs/id"},
        "input_kind": {"const": "ADMIN_TRIAL"},
        "input_ref": {"$ref": "#/$defs/id"},
        "input_revision": {"type": "integer", "minimum": 1},
        "query_id": {"$ref": "#/$defs/id"},
        "source_unit_id": {"$ref": "#/$defs/id"},
        "source_revision": {"type": "integer", "minimum": 1},
        "part_id": {"$ref": "#/$defs/id"},
        "trunk_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "conversation_ref": {"$ref": "#/$defs/id"},
        "author_ref": {"$ref": "#/$defs/id"},
        "modality": {"enum": ["TEXT", "IMAGE"]},
        "selector_start_char": {"type": ["integer", "null"], "minimum": 0},
        "selector_end_char": {"type": ["integer", "null"], "minimum": 1},
        "input_payload": {"$ref": "#/$defs/payload"},
        "facet_content_digest": {"$ref": "#/$defs/digest"},
        "input_byte_length": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "width": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000},
        "height": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000}
      }
    }
  }
}
