{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "space_id",
    "dimensions"
  ],
  "properties": {
    "space_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dimensions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    }
  }
}
