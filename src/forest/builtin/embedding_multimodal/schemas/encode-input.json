{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "effect_operation_id", "authorization_ticket_id", "component_id", "generation_id", "profile_ref", "prepared"],
  "properties": {
    "protocol": {"const": "forest.embedding-dispatch/2"},
    "effect_operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authorization_ticket_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "component_id": {"const": "embedding.multimodal"},
    "generation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "profile_ref": {"type": "string", "pattern": "^profile:[0-9a-f]{64}$"},
    "prepared": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "transport_attempt_id", "body", "manifest", "payload_digest", "space_id"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "transport_attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "body": {"$ref": "#/$defs/payload"},
        "manifest": {"$ref": "#/$defs/payload"},
        "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "space_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "owner_component_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "owner_kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
