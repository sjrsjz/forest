{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "reason_code",
    "rule_revision",
    "classifier_component_id",
    "classifier_generation_id"
  ],
  "properties": {
    "decision": {"enum": ["TRIGGER", "NO_TRIGGER"]},
    "reason_code": {"type": "string"},
    "rule_revision": {"type": "string"},
    "classifier_component_id": {"const": "conversation.trigger-policy"},
    "classifier_generation_id": {"type": "string"}
  }
}
