{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "allowed_group_ids", "group_trigger_mode", "private_enabled"],
  "properties": {
    "protocol": {"const": "forest.conversation.trigger-policy/1"},
    "allowed_group_ids": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9]{1,32}$"}
    },
    "group_trigger_mode": {"enum": ["MENTION", "ALL", "DISABLED"]},
    "private_enabled": {"type": "boolean"}
  }
}
