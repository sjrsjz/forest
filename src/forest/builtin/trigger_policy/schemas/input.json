{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["normalized"],
  "properties": {
    "normalized": {
      "type": "object",
      "required": ["channel_kind", "channel_id", "self_id", "author", "segments"],
      "properties": {
        "channel_kind": {"enum": ["group", "private"]},
        "channel_id": {"type": "string"},
        "self_id": {"type": "string"},
        "author": {"type": "object"},
        "segments": {"type": "array"}
      }
    }
  }
}
