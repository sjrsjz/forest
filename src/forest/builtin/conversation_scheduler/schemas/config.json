{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol", "context_view"],
  "properties": {
    "protocol": {"const": "forest.conversation.scheduler/2"},
    "context_view": {
      "type": "object",
      "required": ["high_watermark_units", "retain_units", "high_watermark_payload_bytes", "retain_payload_bytes", "high_watermark_media_bytes", "retain_media_bytes", "high_watermark_decoded_bytes", "retain_decoded_bytes", "policy_revision"],
      "properties": {
        "high_watermark_units": {"type": "integer", "minimum": 2, "maximum": 1000000},
        "retain_units": {"type": "integer", "minimum": 1, "maximum": 999999},
        "high_watermark_payload_bytes": {"type": "integer", "minimum": 1024, "maximum": 134217728},
        "retain_payload_bytes": {"type": "integer", "minimum": 1, "maximum": 134217727},
        "high_watermark_media_bytes": {"type": "integer", "minimum": 1024, "maximum": 134217728},
        "retain_media_bytes": {"type": "integer", "minimum": 1, "maximum": 134217727},
        "high_watermark_decoded_bytes": {"type": "integer", "minimum": 1024, "maximum": 536870912},
        "retain_decoded_bytes": {"type": "integer", "minimum": 1, "maximum": 536870911},
        "policy_revision": {"const": "context-view-multimodal-window-v4"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
