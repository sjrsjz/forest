{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "profile",
    "profile_digest"
  ],
  "properties": {
    "profile": {
      "type": "object",
      "required": [
        "high_watermark_units",
        "retain_units",
        "high_watermark_payload_bytes",
        "retain_payload_bytes",
        "high_watermark_media_bytes",
        "retain_media_bytes",
        "high_watermark_decoded_bytes",
        "retain_decoded_bytes",
        "high_watermark_estimated_tokens",
        "retain_estimated_tokens",
        "utf8_bytes_per_estimated_token",
        "unit_overhead_estimated_tokens",
        "policy_revision"
      ],
      "properties": {
        "high_watermark_units": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "retain_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4095
        },
        "high_watermark_payload_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 134217728
        },
        "retain_payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217727
        },
        "high_watermark_media_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 134217728
        },
        "retain_media_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217727
        },
        "high_watermark_decoded_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 536870912
        },
        "retain_decoded_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870911
        },
        "high_watermark_estimated_tokens": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "retain_estimated_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048575
        },
        "utf8_bytes_per_estimated_token": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "unit_overhead_estimated_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "policy_revision": {
          "const": "context-view-multimodal-window-v5"
        }
      },
      "additionalProperties": false
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
