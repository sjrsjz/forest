{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor", "conversation_id", "session_ref", "run_ref", "resume", "claimed_at",
    "binding_ref", "channel_kind", "channel_ref"
  ],
  "properties": {
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["conversation_id", "owner_id", "epoch"],
      "properties": {
        "conversation_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "epoch": {"type": "integer", "minimum": 1}
      }
    },
    "conversation_id": {"$ref": "#/$defs/id"},
    "session_ref": {"$ref": "#/$defs/id"},
    "run_ref": {"$ref": "#/$defs/id"},
    "resume": {"type": "boolean"},
    "claimed_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "binding_ref": {"$ref": "#/$defs/id"},
    "channel_kind": {"enum": ["GROUP", "PRIVATE"]},
    "channel_ref": {"$ref": "#/$defs/id"}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 256}}
}
