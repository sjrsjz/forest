{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "context_revision", "unit_id", "answered_trigger_ids", "reply_ref"],
  "properties": {
    "operation_id": {"type": "string", "minLength": 1},
    "context_revision": {"type": "integer", "minimum": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "answered_trigger_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reply_ref": {"type": "string", "minLength": 1}
  }
}
