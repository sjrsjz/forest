{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "context_revision", "unit_id", "answered_trigger_count", "answered_events", "reply_ref"],
  "properties": {
    "operation_id": {"type": "string", "minLength": 1},
    "context_revision": {"type": "integer", "minimum": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "answered_trigger_count": {"type": "integer", "minimum": 1},
    "answered_events": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["trigger_ref", "event_ref"],
        "properties": {
          "trigger_ref": {"type": "string", "minLength": 1},
          "event_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "reply_ref": {"type": "string", "minLength": 1}
  }
}
