{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["conversation_id", "run_ref", "reason_code", "requested_by"],
  "properties": {
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "run_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
