{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": ["protocol", "status"],
      "properties": {
        "protocol": {"const": "forest.payload-json-plan/1"},
        "status": {"const": "SKIP"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "status", "payload", "commit"],
      "properties": {
        "protocol": {"const": "forest.payload-json-plan/1"},
        "status": {"const": "WRITE"},
        "payload": {
          "type": "object",
          "required": ["owner_kind", "owner_id", "value", "parents", "sources"],
          "properties": {
            "owner_kind": {"const": "context.archive"},
            "owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "value": {"type": "object"},
            "parents": {"type": "array", "maxItems": 0},
            "sources": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}}
          },
          "additionalProperties": false
        },
        "commit": {"type": "object"}
      },
      "additionalProperties": false
    }
  ]
}
