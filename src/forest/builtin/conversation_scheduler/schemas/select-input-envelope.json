{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object",
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "generation_id": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["actor", "boundary", "selection_mode", "session_ref", "run_ref", "next_run_ref"],
      "properties": {
        "actor": {
          "type": "object",
          "required": ["conversation_id", "owner_id", "epoch"],
          "properties": {
            "conversation_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "epoch": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "boundary": {"enum": ["IDLE", "MODEL_SAFE_POINT", "SESSION_END"]},
        "selection_mode": {"enum": ["ANY", "SILENT_ONLY"]},
        "session_ref": {"type": ["string", "null"], "maxLength": 256},
        "run_ref": {"type": ["string", "null"], "maxLength": 256},
        "next_run_ref": {"type": ["string", "null"], "maxLength": 256}
      },
      "allOf": [
        {
          "if": {"properties": {"boundary": {"const": "IDLE"}}},
          "then": {
            "properties": {
              "session_ref": {"type": "string", "minLength": 1},
              "run_ref": {"type": "string", "minLength": 1},
              "next_run_ref": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"boundary": {"const": "MODEL_SAFE_POINT"}}},
          "then": {
            "properties": {
              "session_ref": {"type": "string", "minLength": 1},
              "run_ref": {"type": "string", "minLength": 1},
              "next_run_ref": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"boundary": {"const": "SESSION_END"}}},
          "then": {
            "properties": {
              "session_ref": {"type": "string", "minLength": 1},
              "run_ref": {"type": "string", "minLength": 1},
              "next_run_ref": {"type": "string", "minLength": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "prior": {"type": "object"}
  },
  "additionalProperties": false
}
