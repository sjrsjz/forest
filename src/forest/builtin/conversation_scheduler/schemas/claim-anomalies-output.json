{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "items", "has_more", "next_cursor"],
  "properties": {
    "protocol": {"const": "forest.conversation-claim-anomalies/1"},
    "items": {"type": "array", "maxItems": 50, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["conversation_id", "channel_kind", "channel_ref", "claim_ref",
        "session_ref", "run_ref", "lane_session_ref", "lane_run_ref", "anomaly_code"],
      "properties": {
        "conversation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "channel_kind": {"enum": ["GROUP", "PRIVATE"]},
        "channel_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "claim_ref": {"type": "string", "pattern": "^claim:[a-f0-9]{64}$"},
        "session_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "run_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "lane_session_ref": {"type": ["string", "null"], "maxLength": 256},
        "lane_run_ref": {"type": ["string", "null"], "maxLength": 256},
        "anomaly_code": {"enum": ["MULTIPLE_ACTIVE_GROUPS", "LANE_CLAIM_MISMATCH"]}
      }
    }},
    "has_more": {"type": "boolean"},
    "next_cursor": {"anyOf": [
      {"type": "null"},
      {"type": "object", "additionalProperties": false,
       "required": ["conversation_id", "claim_ref"],
       "properties": {
         "conversation_id": {"type": "string", "minLength": 1, "maxLength": 256},
         "claim_ref": {"type": "string", "pattern": "^claim:[a-f0-9]{64}$"}
       }}
    ]}
  }
}
