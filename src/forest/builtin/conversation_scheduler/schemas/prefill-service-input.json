{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol", "request_id", "actor", "boundary", "session_ref", "run_ref", "next_run_ref"],
  "properties": {
    "protocol": {"const": "forest.conversation-context-prefill/1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "actor": {
      "type": "object",
      "required": ["conversation_id", "owner_id", "epoch"],
      "properties": {
        "conversation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "epoch": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "boundary": {"enum": ["IDLE", "MODEL_SAFE_POINT", "SESSION_END"]},
    "session_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "run_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "next_run_ref": {"type": ["string", "null"], "maxLength": 256}
  },
  "allOf": [{
    "if": {"properties": {"boundary": {"const": "SESSION_END"}}},
    "then": {"properties": {"next_run_ref": {"type": "string", "minLength": 1}}},
    "else": {"properties": {"next_run_ref": {"type": "null"}}}
  }],
  "additionalProperties": false
}
