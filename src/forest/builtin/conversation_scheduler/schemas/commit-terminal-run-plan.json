{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversation"],
  "properties": {
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "session_ref", "run_ref", "terminal_status", "reason_code"],
      "properties": {
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conversation_id", "owner_id", "epoch"],
          "properties": {
            "conversation_id": {"$ref": "#/$defs/id"},
            "owner_id": {"$ref": "#/$defs/id"},
            "epoch": {"type": "integer", "minimum": 1}
          }
        },
        "session_ref": {"$ref": "#/$defs/id"},
        "run_ref": {"$ref": "#/$defs/id"},
        "terminal_status": {"enum": ["FAILED", "CANCELLED"]},
        "reason_code": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 512}}
}
