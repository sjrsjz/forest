{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "action", "selection", "run", "session"],
  "properties": {
    "protocol": {"const": "forest.agent-session-handoff/1"},
    "action": {"enum": ["SUCCESSOR", "WAIT_INPUT", "CLOSED"]},
    "selection": {"type": "object"},
    "run": {"type": ["object", "null"]},
    "session": {"type": ["object", "null"]}
  }
}
