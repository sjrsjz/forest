{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["actor", "session_ref", "run_ref", "step_seq", "quote"],
  "properties": {
    "actor": {
      "type": "object",
      "required": ["conversation_id", "owner_id", "epoch"],
      "properties": {
        "conversation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "epoch": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "session_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "run_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "step_seq": {"type": "integer", "minimum": 1, "maximum": 256},
    "quote": {
      "type": "object",
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "owner_component_id": {"const": "agent.runtime"},
        "owner_kind": {"const": "model.view.quote"},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
