{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol", "conversation_id", "run_ref", "view_profile_digest", "claimed_trigger_count", "token_estimator", "context_applied_seq", "context_revision",
    "context_view_revision", "media_cost_revision", "context_view_media_bytes", "context_view_decoded_bytes", "unit_count", "snapshot"
  ],
  "properties": {
    "protocol": {"const": "forest.conversation-context-snapshot/7"},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "run_ref": {"type": ["string", "null"]},
    "view_profile_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "claimed_trigger_count": {"type": "integer", "minimum": 0},
    "token_estimator": {
      "type": "object",
      "required": ["revision", "utf8_bytes_per_estimated_token", "unit_overhead_estimated_tokens", "history_budget_tokens", "estimated_history_tokens"],
      "properties": {
        "revision": {"const": "utf8-payload-plus-unit-v1"},
        "utf8_bytes_per_estimated_token": {"type": "integer", "minimum": 1, "maximum": 16},
        "unit_overhead_estimated_tokens": {"type": "integer", "minimum": 0, "maximum": 256},
        "history_budget_tokens": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "estimated_history_tokens": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "context_applied_seq": {"type": "integer", "minimum": 0},
    "context_revision": {"type": "integer", "minimum": 0},
    "context_view_revision": {"type": "integer", "minimum": 0},
    "media_cost_revision": {"type": "integer", "minimum": 0},
    "context_view_media_bytes": {"type": "integer", "minimum": 0},
    "context_view_decoded_bytes": {"type": "integer", "minimum": 0},
    "unit_count": {"type": "integer", "minimum": 0, "maximum": 1000001},
    "snapshot": {"$ref": "#/$defs/payload"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "payload": {
      "type": "object",
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"const": "conversation.scheduler"},
        "owner_kind": {"const": "context.snapshot"},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    }
  }
}
