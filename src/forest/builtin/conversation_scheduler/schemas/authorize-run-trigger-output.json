{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol", "run_ref", "trigger_ref", "session_ref", "conversation_ref", "principal_ref"],
  "properties": {
    "protocol": {"const": "forest.conversation-run-trigger-authority/1"},
    "run_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "trigger_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "session_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "conversation_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "principal_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
  },
  "additionalProperties": false,
  "oneOf": [
    {"properties": {"trigger_ref": {"type": "null"}, "session_ref": {"type": "null"}, "conversation_ref": {"type": "null"}, "principal_ref": {"type": "null"}}},
    {"properties": {"trigger_ref": {"type": "string"}, "session_ref": {"type": "string"}, "conversation_ref": {"type": "string"}, "principal_ref": {"type": "string"}}}
  ]
}
