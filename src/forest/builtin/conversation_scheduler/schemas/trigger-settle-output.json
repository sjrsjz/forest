{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "claim_ref", "segment_index", "settled_count", "remaining_segments"],
  "properties": {
    "protocol": {"const": "forest.trigger-segment-settled/1"},
    "claim_ref": {"type": "string", "pattern": "^claim:[a-f0-9]{64}$"},
    "segment_index": {"type": "integer", "minimum": 0},
    "settled_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "remaining_segments": {"type": "integer", "minimum": 0}
  }
}
