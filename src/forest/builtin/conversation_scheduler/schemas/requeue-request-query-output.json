{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "state", "request_id", "conversation_id", "session_ref",
    "run_ref", "claim_ref", "claim_digest", "reason_code", "requested_by",
    "disposition_code"],
  "properties": {
    "protocol": {"const": "forest.conversation-requeue-request/1"},
    "state": {"enum": ["NONE", "PENDING", "APPLIED", "REJECTED"]},
    "request_id": {"type": ["string", "null"], "maxLength": 256},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "session_ref": {"type": ["string", "null"], "maxLength": 256},
    "run_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "claim_ref": {"type": ["string", "null"], "pattern": "^claim:[a-f0-9]{64}$"},
    "claim_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "reason_code": {"type": ["string", "null"], "maxLength": 128},
    "requested_by": {"type": ["string", "null"], "maxLength": 256},
    "disposition_code": {"type": ["string", "null"], "maxLength": 128}
  }
}
