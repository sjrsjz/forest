{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "conversation.scheduler"},
        "generation_id": {"$ref": "#/$defs/id"}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["actor", "session_ref", "run_ref", "reply", "reply_byte_length", "unit_id"],
      "properties": {
        "actor": {"$ref": "#/$defs/actor"},
        "session_ref": {"$ref": "#/$defs/id"},
        "run_ref": {"$ref": "#/$defs/id"},
        "reply": {"$ref": "#/$defs/reply"},
        "reply_byte_length": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "unit_id": {"$ref": "#/$defs/id"}
      }
    },
    "prior": {"type": "object", "required": ["agent"]}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["conversation_id", "owner_id", "epoch"],
      "properties": {
        "conversation_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "epoch": {"type": "integer", "minimum": 1}
      }
    },
    "reply": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "owner_component_id": {"const": "agent.runtime"},
        "owner_kind": {"const": "final.reply"},
        "owner_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
