{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "disposition", "agent_status", "reason_code", "delay_seconds"],
  "properties": {
    "protocol": {"const": "forest.conversation-agent-work/1"},
    "disposition": {"enum": ["RELEASE", "DEFER"]},
    "agent_status": {
      "enum": [
        "IDLE", "WAIT_INPUT", "WAIT_MEMORY", "WAIT_TOOL", "WAIT_APPROVAL", "BLOCKED_UNKNOWN",
        "RELOAD_WAIT", "COMPLETED", "FAILED", "CANCELLED", "REQUEUED"
      ]
    },
    "reason_code": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "delay_seconds": {"type": ["number", "null"], "minimum": 0.1, "maximum": 3600}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "DEFER"}}},
      "then": {"properties": {"reason_code": {"type": "string"}, "delay_seconds": {"type": "number"}}},
      "else": {"properties": {"reason_code": {"type": "null"}, "delay_seconds": {"type": "null"}}}
    }
  ]
}
