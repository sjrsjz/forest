{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchor",
    "context_view",
    "payload",
    "payload_epoch",
    "memory"
  ],
  "properties": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "conversation_id",
        "actor",
        "session_ref",
        "run_ref"
      ],
      "properties": {
        "protocol": {
          "const": "forest.conversation-handoff-compaction-anchor/1"
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conversation_id",
            "owner_id",
            "epoch"
          ],
          "properties": {
            "conversation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "owner_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "epoch": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "session_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "run_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "context_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "high_watermark_units",
        "retain_units",
        "high_watermark_payload_bytes",
        "retain_payload_bytes",
        "high_watermark_media_bytes",
        "retain_media_bytes",
        "high_watermark_decoded_bytes",
        "retain_decoded_bytes",
        "high_watermark_estimated_tokens",
        "retain_estimated_tokens",
        "model_view_budget_tokens",
        "model_view_media_bytes",
        "model_view_decoded_bytes",
        "utf8_bytes_per_estimated_token",
        "unit_overhead_estimated_tokens",
        "policy_revision"
      ],
      "properties": {
        "high_watermark_units": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "retain_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4095
        },
        "high_watermark_payload_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 134217728
        },
        "retain_payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217727
        },
        "high_watermark_media_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 134217728
        },
        "retain_media_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217727
        },
        "high_watermark_decoded_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 536870912
        },
        "retain_decoded_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870911
        },
        "high_watermark_estimated_tokens": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "retain_estimated_tokens": {"type": "integer", "minimum": 1, "maximum": 1048575},
        "model_view_budget_tokens": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "model_view_media_bytes": {"type": "integer", "minimum": 1024, "maximum": 268435456},
        "model_view_decoded_bytes": {"type": "integer", "minimum": 1024, "maximum": 1073741824},
        "utf8_bytes_per_estimated_token": {"type": "integer", "minimum": 1, "maximum": 16},
        "unit_overhead_estimated_tokens": {"type": "integer", "minimum": 0, "maximum": 256},
        "policy_revision": {
          "const": "context-view-multimodal-window-v6"
        }
      }
    },
    "payload": {
      "const": {
        "protocol": "forest.payload-json-from-prior/1",
        "prior_step_id": "prepare"
      }
    },
    "payload_epoch": {
      "const": {
        "protocol": "forest.payload-epoch-capture/1"
      }
    },
    "memory": {
      "type": "object",
      "maxProperties": 0
    }
  }
}
