{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object",
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "conversation.scheduler"},
        "generation_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "input": {"type": "object"},
    "prior": {
      "type": "object",
      "maxProperties": 3,
      "properties": {
        "select": {"type": "object", "required": ["status", "conversation_id"]},
        "payload_epoch": {"type": "object", "required": ["protocol", "deletion_epoch"]},
        "qualify": {"type": "object", "required": ["protocol", "qualified_count", "pending_count"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
