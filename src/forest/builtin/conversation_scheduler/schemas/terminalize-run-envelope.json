{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "conversation.scheduler"},
        "generation_id": {"$ref": "#/$defs/id"}
      }
    },
    "input": {"$ref": "#/$defs/terminal"},
    "prior": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "session_ref", "run_ref", "terminal_status", "reason_code"],
      "properties": {
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conversation_id", "owner_id", "epoch"],
          "properties": {
            "conversation_id": {"$ref": "#/$defs/id"},
            "owner_id": {"$ref": "#/$defs/id"},
            "epoch": {"type": "integer", "minimum": 1}
          }
        },
        "session_ref": {"$ref": "#/$defs/id"},
        "run_ref": {"$ref": "#/$defs/id"},
        "terminal_status": {"enum": ["FAILED", "CANCELLED"]},
        "reason_code": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  }
}
