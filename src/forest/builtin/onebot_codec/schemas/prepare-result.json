{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "action",
    "body"
  ],
  "properties": {
    "action": {
      "enum": [
        "send_group_msg",
        "send_private_msg"
      ]
    },
    "body": {
      "type": "object",
      "required": [
        "message",
        "auto_escape"
      ],
      "properties": {
        "group_id": {
          "type": "integer",
          "minimum": 1
        },
        "user_id": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "type",
              "data"
            ],
            "properties": {
              "type": {
                "enum": [
                  "text",
                  "at",
                  "reply",
                  "face",
                  "image"
                ]
              },
              "data": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "auto_escape": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
