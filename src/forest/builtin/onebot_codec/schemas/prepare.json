{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["channel_kind", "channel_id", "segments"],
  "additionalProperties": false,
  "properties": {
    "channel_kind": {"enum": ["group", "private"]},
    "channel_id": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "segments": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object"}}
  }
}
