{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "job_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "job_type": {"type": "string"},
    "job_version": {"type": "integer", "minimum": 1},
    "requested_by": {"type": "string"},
    "input": {"type": "object"},
    "claim_token": {"type": "string"},
    "max_attempts": {"type": "integer", "minimum": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3660},
    "target_component_id": {"type": "string"},
    "target_generation_id": {"type": "string"},
    "target_service_id": {"type": "string"},
    "target_service_version": {"type": "integer", "minimum": 1}
  },
  "required": ["job_id", "job_type", "job_version", "requested_by", "input", "claim_token", "max_attempts", "timeout_seconds", "target_component_id", "target_generation_id", "target_service_id", "target_service_version"],
  "additionalProperties": false
}
