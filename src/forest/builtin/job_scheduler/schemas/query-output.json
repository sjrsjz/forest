{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "job_id": {"type": "string"},
        "job_type": {"type": "string"},
        "job_version": {"type": "integer", "minimum": 1},
        "state": {"enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED", "UNKNOWN"]},
        "revision": {"type": "integer", "minimum": 1},
        "requested_by": {"type": "string"},
        "source_conversation_ref": {"type": ["string", "null"]},
        "input": {"type": "object"},
        "result": {"type": ["object", "null"]},
        "attempt_count": {"type": "integer", "minimum": 0},
        "max_attempts": {"type": "integer", "minimum": 1},
        "error_code": {"type": ["string", "null"]},
        "cancel_requested_at": {"type": ["string", "null"], "format": "date-time"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "target_component_id": {"type": ["string", "null"]},
        "target_generation_id": {"type": ["string", "null"]},
        "target_service_id": {"type": ["string", "null"]},
        "target_service_version": {"type": ["integer", "null"], "minimum": 1}
      },
      "required": ["job_id", "job_type", "job_version", "state", "revision", "requested_by", "source_conversation_ref", "input", "result", "attempt_count", "max_attempts", "error_code", "cancel_requested_at", "created_at", "updated_at", "completed_at", "target_component_id", "target_generation_id", "target_service_id", "target_service_version"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "snapshot_created_at": {"type": "string", "format": "date-time"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "has_more": {"type": "boolean"},
    "next_before_created_at": {"type": ["string", "null"], "format": "date-time"},
    "next_before_job_id": {"type": ["string", "null"]}
  },
  "required": ["snapshot_created_at", "items", "has_more", "next_before_created_at", "next_before_job_id"],
  "additionalProperties": false
}
