{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "kind", "graph_id", "graph_revision"],
  "properties": {
    "protocol": {"const": "forest.contribution-directory-cleanup/1"},
    "kind": {"const": "job-types"},
