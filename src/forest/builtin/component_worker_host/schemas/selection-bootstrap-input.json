{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {"const": "forest.component-selection-bootstrap/1"},
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "component_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "package_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "required": ["component_id", "package_digest", "manifest_digest"],
        "additionalProperties": false
      }
    }
  },
  "required": ["protocol", "packages"],
  "additionalProperties": false
}
