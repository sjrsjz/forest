{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "input_digest", "desired_enabled"],
  "properties": {
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "input_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "desired_enabled": {"type": "boolean"}
  }
}
