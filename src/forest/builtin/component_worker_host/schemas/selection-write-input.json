{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "component_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "source_kind": {"enum": ["builtin", "installed"]},
    "package_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "manifest_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "approved_capabilities": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "desired_enabled": {"type": "boolean"},
    "plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "expected_configuration_revision": {"type": ["integer", "null"], "minimum": 1},
    "expected_selection_revision": {"type": "integer", "minimum": 0},
    "expected_graph_revision": {"type": "integer", "minimum": 1},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 256}
  },
  "required": [
    "component_id", "source_kind", "package_digest", "manifest_digest",
    "approved_capabilities", "desired_enabled", "plan_digest",
    "expected_configuration_revision", "expected_selection_revision",
    "expected_graph_revision", "requested_by"
  ],
  "oneOf": [
    {
      "properties": {
        "source_kind": {"const": "builtin"},
        "package_digest": {"type": "null"},
        "manifest_digest": {"type": "null"},
        "approved_capabilities": {"maxItems": 0}
      }
    },
    {
      "properties": {
        "source_kind": {"const": "installed"},
        "package_digest": {"type": "string"},
        "manifest_digest": {"type": "string"}
      }
    }
  ],
  "additionalProperties": false
}
