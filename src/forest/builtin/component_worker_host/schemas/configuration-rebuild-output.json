{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {"const": "forest.configuration-rebuild/1"},
    "request_id": {"type": "string", "pattern": "^config-rebuild:[0-9a-f]{32}$"},
    "state": {"enum": ["PENDING_REBUILD", "RUNNING", "REBUILD_REQUESTED", "EFFECTIVE", "REBUILD_FAILED"]},
    "target_component_id": {"type": "string"},
    "desired_revision": {"type": "integer", "minimum": 2},
    "expected_graph_revision": {"type": "integer", "minimum": 1},
    "requested_by": {"type": "string"},
    "attempt_count": {"type": "integer", "minimum": 0},
    "error_code": {"type": ["string", "null"]},
    "kernel_receipt": {"type": ["object", "null"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "required": ["protocol", "request_id", "state", "target_component_id", "desired_revision", "expected_graph_revision", "requested_by", "attempt_count", "error_code", "kernel_receipt", "created_at", "updated_at"],
  "additionalProperties": false
}
