{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_id", "source_kind", "package_digest", "manifest_digest",
    "approved_capabilities", "desired_enabled", "expected_selection_revision",
    "expected_graph_revision", "expected_configuration_revision"
  ],
  "properties": {
    "component_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "source_kind": {"enum": ["builtin", "installed"]},
    "package_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "manifest_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "approved_capabilities": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "desired_enabled": {"type": "boolean"},
    "expected_selection_revision": {"type": "integer", "minimum": 0},
    "expected_graph_revision": {"type": "integer", "minimum": 1},
    "expected_configuration_revision": {"type": ["integer", "null"], "minimum": 1}
  }
}
