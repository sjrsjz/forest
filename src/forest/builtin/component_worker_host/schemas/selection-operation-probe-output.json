{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "disposition", "receipt"],
  "properties": {
    "protocol": {"const": "forest.component-selection-operation-probe/1"},
    "disposition": {"enum": ["ABSENT", "REPLAY"]},
    "receipt": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol", "operation_id", "request_id", "component_id", "desired_enabled",
            "selection_revision", "expected_graph_revision"
          ],
          "properties": {
            "protocol": {"const": "forest.component-selection-operation/2"},
            "operation_id": {"type": "string"},
            "request_id": {"type": "string", "pattern": "^selection:[0-9a-f]{32}$"},
            "component_id": {"type": "string"},
            "desired_enabled": {"type": "boolean"},
            "selection_revision": {"type": "integer", "minimum": 1},
            "expected_graph_revision": {"type": "integer", "minimum": 1}
          }
        }
      ]
    }
  },
  "oneOf": [
    {"properties": {"disposition": {"const": "ABSENT"}, "receipt": {"type": "null"}}},
    {"properties": {"disposition": {"const": "REPLAY"}, "receipt": {"type": "object"}}}
  ]
}
