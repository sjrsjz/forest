{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {"const": "forest.component-selection-snapshot/1"},
    "revision": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "component_id": {"type": "string"},
          "source_kind": {"enum": ["builtin", "official", "installed"]},
          "package_digest": {"type": ["string", "null"]},
          "manifest_digest": {"type": ["string", "null"]},
          "approved_capabilities": {"type": "array", "items": {"type": "string"}},
          "desired_enabled": {"type": "boolean"},
          "desired_revision": {"type": "integer", "minimum": 1}
        },
        "required": ["component_id", "source_kind", "package_digest", "manifest_digest", "approved_capabilities", "desired_enabled", "desired_revision"],
        "additionalProperties": false
      }
    }
  },
  "required": ["protocol", "revision", "entries"],
  "additionalProperties": false
}
