{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "bot_id", "runtime_status", "graph_id", "graph_revision", "graph_state", "data_admission", "control_admission", "members"],
  "properties": {
    "protocol": {"const": "forest.runtime-health-snapshot/1"},
    "bot_id": {"type": "string", "minLength": 1},
    "runtime_status": {"type": "string", "minLength": 1},
    "graph_id": {"type": ["string", "null"]},
    "graph_revision": {"type": "integer", "minimum": 0},
    "graph_state": {"type": ["string", "null"]},
    "data_admission": {"type": "boolean"},
    "control_admission": {"type": "boolean"},
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "generation_id", "status", "config_revision"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "generation_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "config_revision": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
