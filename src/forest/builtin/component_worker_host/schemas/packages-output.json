{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {"const": "forest.package-catalog-page/1"},
    "catalog_revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "items": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "package_id": {"type": "string"},
          "package_version": {"type": "string"},
          "package_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "component_id": {"type": "string"},
          "scope": {"enum": ["bot", "host", "deployment"]},
          "runtime": {"type": "string"},
          "kernel_api": {"type": "string"},
          "requested_capabilities": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["package_id", "package_version", "package_digest", "manifest_digest", "component_id", "scope", "runtime", "kernel_api", "requested_capabilities"],
        "additionalProperties": false
      }
    },
    "next_after": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "properties": {"package_id": {"type": "string"}, "version": {"type": "string"}}, "required": ["package_id", "version"], "additionalProperties": false}
      ]
    }
  },
  "required": ["protocol", "catalog_revision", "items", "next_after"],
  "additionalProperties": false
}
