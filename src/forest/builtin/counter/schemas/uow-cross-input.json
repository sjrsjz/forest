{
  "type": "object",
  "additionalProperties": false,
  "required": ["counter", "effect"],
  "properties": {
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "expected_revision"],
      "properties": {
        "value": {"type": "integer"},
        "expected_revision": {"type": "integer", "minimum": 0}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "effect_operation_id",
        "attempt_id",
        "observation_operation_id",
        "status",
        "evidence_kind",
        "evidence_payload"
      ],
      "properties": {
        "protocol": {"const": "forest.effect-observe/1"},
        "effect_operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "observation_operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "status": {"enum": ["SUCCEEDED", "NOT_APPLIED", "UNKNOWN"]},
        "evidence_kind": {"enum": ["executor", "reconciliation"]},
        "evidence_payload": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["payload_id", "digest"],
              "properties": {
                "payload_id": {"type": "string"},
                "digest": {"type": "string"}
              }
            }
          ]
        }
      }
    }
  }
}
