{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_id", "deployment_id", "bot_id", "storage_generation", "profile_ref", "pinned_resource_revision", "retirement_operation_id", "revocation_operation_id", "bot_revision", "intent_revision", "observation_revision"],
  "properties": {
    "resource_id": {"type": "string", "pattern": "^resource/[a-f0-9-]{36}$"},
    "deployment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "bot_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "storage_generation": {"type": "integer", "minimum": 1},
    "profile_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "pinned_resource_revision": {"type": "integer", "minimum": 2},
    "retirement_operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "revocation_operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "bot_revision": {"type": "integer", "minimum": 1},
    "intent_revision": {"type": "integer", "minimum": 1},
    "observation_revision": {"type": ["integer", "null"], "minimum": 1}
  }
}
