{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_id", "state", "attempt_count", "last_error_code"],
  "properties": {
    "resource_id": {"type": "string", "pattern": "^resource/[a-f0-9-]{36}$"},
    "state": {"enum": ["PENDING", "CLAIMED", "SUCCEEDED", "FAILED"]},
    "attempt_count": {"type": "integer", "minimum": 0},
    "last_error_code": {"type": ["string", "null"]}
  }
}
