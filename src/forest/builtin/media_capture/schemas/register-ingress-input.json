{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object",
  "required": ["capture_id", "identity", "source_unit_id", "source_revision", "unit_kind", "author_subject_ref", "author", "text_parts", "image_parts", "binding_ref", "conversation_ref", "event_ref", "ingress_seq", "observed_at", "occurred_at"],
  "properties": {
    "capture_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "identity": {
      "type": "object", "required": ["source_id", "source_kind", "identity_incarnation", "platform", "realm_id", "external_group_id", "trunk_id"],
      "properties": {"source_id": {"type": "string"}, "source_kind": {"enum": ["GROUP", "DIRECT"]}, "identity_incarnation": {"type": "integer", "minimum": 1}, "platform": {"type": ["string", "null"]}, "realm_id": {"type": ["string", "null"]}, "external_group_id": {"type": ["string", "null"]}, "trunk_id": {"type": ["string", "null"]}},
      "additionalProperties": false
    },
    "source_unit_id": {"type": "string"}, "source_revision": {"type": "integer", "minimum": 1}, "unit_kind": {"type": "string"}, "author_subject_ref": {"type": "string"},
    "author": {"$ref": "#/$defs/payload"},
    "text_parts": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/text_part"}},
    "image_parts": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/image_part"}},
    "binding_ref": {"type": "string"}, "conversation_ref": {"type": "string"}, "event_ref": {"type": "string"}, "ingress_seq": {"type": "integer", "minimum": 1},
    "observed_at": {"type": "string", "format": "date-time"}, "occurred_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "payload": {"type": "object", "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"], "properties": {"payload_id": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "owner_component_id": {"type": "string"}, "owner_kind": {"type": "string"}, "owner_id": {"type": "string"}}, "additionalProperties": false},
    "text_part": {"type": "object", "required": ["part_id", "part_index", "part_kind", "media_type", "payload", "width", "height", "byte_length"], "properties": {"part_id": {"type": "string"}, "part_index": {"type": "integer", "minimum": 0}, "part_kind": {"const": "TEXT"}, "media_type": {"type": "string"}, "payload": {"$ref": "#/$defs/payload"}, "width": {"type": "null"}, "height": {"type": "null"}, "byte_length": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "image_part": {"type": "object", "required": ["part_id", "part_index", "media_ref", "locator"], "properties": {"part_id": {"type": "string"}, "part_index": {"type": "integer", "minimum": 0}, "media_ref": {"type": "string"}, "locator": {"type": "object", "required": ["kind", "uri", "platform_file"], "properties": {"kind": {"const": "onebot-source"}, "uri": {"type": ["string", "null"]}, "platform_file": {"type": ["string", "null"]}}, "additionalProperties": false}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
