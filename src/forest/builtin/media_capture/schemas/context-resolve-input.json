{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["source_unit_id", "part_id", "media_ref", "media_revision"],
        "properties": {
          "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "part_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "media_ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "media_revision": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
