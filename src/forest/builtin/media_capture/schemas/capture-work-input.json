{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$ref": "#/$defs/capture",
  "$defs": {
    "payload": {"type": "object", "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"], "properties": {"payload_id": {"type": "string"}, "digest": {"type": "string"}, "owner_component_id": {"type": "string"}, "owner_kind": {"type": "string"}, "owner_id": {"type": "string"}}, "additionalProperties": false},
    "part": {"type": "object", "required": ["part_id", "part_index", "part_kind", "state", "media_ref", "locator", "payload", "media_type", "width", "height", "byte_length", "error_code"], "properties": {"part_id": {"type": "string"}, "part_index": {"type": "integer"}, "part_kind": {"enum": ["TEXT", "IMAGE"]}, "state": {"enum": ["PENDING", "READY", "FAILED"]}, "media_ref": {"type": ["string", "null"]}, "locator": {"type": ["object", "null"]}, "payload": {"anyOf": [{"$ref": "#/$defs/payload"}, {"type": "null"}]}, "media_type": {"type": ["string", "null"]}, "width": {"type": ["integer", "null"]}, "height": {"type": ["integer", "null"]}, "byte_length": {"type": ["integer", "null"]}, "error_code": {"type": ["string", "null"]}}, "additionalProperties": false},
    "capture": {"type": "object", "required": ["capture_id", "claim_token", "identity", "source_unit_id", "source_revision", "unit_kind", "author_subject_ref", "author", "binding_ref", "conversation_ref", "event_ref", "ingress_seq", "observed_at", "occurred_at", "parts"], "properties": {"capture_id": {"type": "string"}, "claim_token": {"type": "string"}, "identity": {"type": "object"}, "source_unit_id": {"type": "string"}, "source_revision": {"type": "integer"}, "unit_kind": {"type": "string"}, "author_subject_ref": {"type": "string"}, "author": {"$ref": "#/$defs/payload"}, "binding_ref": {"type": "string"}, "conversation_ref": {"type": "string"}, "event_ref": {"type": "string"}, "ingress_seq": {"type": "integer"}, "observed_at": {"type": "string"}, "occurred_at": {"type": "string"}, "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}}}, "additionalProperties": false}
  }
}
