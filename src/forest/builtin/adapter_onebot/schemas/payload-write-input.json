{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["protocol","owner_kind","owner_id","media_type","content_base64","parents","sources"],
  "properties":{
    "protocol":{"const":"forest.payload-bytes-write/1"},
    "owner_kind":{"enum":["onebot.raw-event","onebot.normalized-event","onebot.author-snapshot","onebot.memory-text","onebot.shell-input"]},
    "owner_id":{"type":"string","minLength":1,"maxLength":512},
    "media_type":{"type":"string","minLength":1,"maxLength":128},
    "content_base64":{"type":"string","maxLength":524288},
    "parents":{"type":"array","maxItems":8,"items":{"type":"string"}},
    "sources":{"type":"array","minItems":1,"maxItems":8,"items":{"$ref":"#/$defs/source"}}
  },
  "$defs":{"source":{"type":"object","additionalProperties":false,
    "required":["source_component_id","source_kind","source_id","source_revision","part_id","source_trunk_id","observation_conversation_id","observation_binding_id","author_subject_id","occurred_at"],
    "properties":{
      "source_component_id":{"const":"adapter.onebot"},"source_kind":{"const":"onebot.platform-event"},
      "source_id":{"type":"string"},"source_revision":{"const":1},"part_id":{"type":"string","minLength":1},
      "source_trunk_id":{"type":["string","null"]},"observation_conversation_id":{"type":"string"},
      "observation_binding_id":{"type":"string"},"author_subject_id":{"type":"string"},"occurred_at":{"type":"string","format":"date-time"}
    }
  }}
}
