{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter",
    "conversation",
    "gate",
    "shell_origin",
    "position",
    "payload_epoch",
    "memory",
    "rescue",
    "rescue_classification"
  ],
  "properties": {
    "adapter": {
      "type": "object"
    },
    "conversation": {
      "type": "object"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_id",
        "inspection",
        "input"
      ],
      "properties": {
        "self_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "inspection": {
          "type": "object"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payload_id",
            "digest",
            "owner_component_id",
            "owner_kind",
            "owner_id"
          ],
          "properties": {
            "payload_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "owner_component_id": {
              "const": "adapter.onebot"
            },
            "owner_kind": {
              "const": "onebot.shell-input"
            },
            "owner_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    },
    "shell_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_frame"
      ],
      "properties": {
        "raw_frame": {
          "type": "object"
        }
      }
    },
    "position": {
      "type": "object"
    },
    "payload_epoch": {
      "type": "object"
    },
    "memory": {
      "type": "object"
    },
    "rescue": {
      "type": "object"
    },
    "rescue_classification": {
      "type": "object"
    }
  }
}
