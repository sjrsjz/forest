{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object",
  "required":["protocol","bindings"],"additionalProperties":false,
  "properties":{
    "protocol":{"const":"forest.adapter.onebot/2"},
    "bindings":{"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/$defs/binding"}}
  },
  "$defs":{"binding":{"type":"object","additionalProperties":false,
    "required":["binding_ref","binding_epoch","self_id","credential_ref","websocket_url","timeout_seconds","event_capacity","pending_capacity","enabled"],
    "properties":{
      "binding_ref":{"type":"string","minLength":1,"maxLength":128},
      "binding_epoch":{"type":"integer","minimum":1},
      "self_id":{"type":"string","pattern":"^[1-9][0-9]{0,18}$"},
      "credential_ref":{"type":"string","minLength":1,"maxLength":256},
      "websocket_url":{"type":"string","pattern":"^wss?://","maxLength":8192},
      "timeout_seconds":{"type":"number","exclusiveMinimum":0,"maximum":120},
      "event_capacity":{"type":"integer","minimum":1,"maximum":4096},
      "pending_capacity":{"type":"integer","minimum":1,"maximum":256},
      "enabled":{"type":"boolean"}
    }
  }}
}
