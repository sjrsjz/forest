{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "binding_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "self_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "outcome": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    }
  },
  "required": [
    "binding_ref",
    "self_id",
    "outcome",
    "error_code"
  ],
  "additionalProperties": false
}
