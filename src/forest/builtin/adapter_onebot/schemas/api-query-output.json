{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "binding_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "self_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "self_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "nickname": {
              "type": "string",
              "maxLength": 1024
            }
          },
          "required": [
            "self_id",
            "nickname"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "group_name": {
              "type": "string",
              "maxLength": 256
            },
            "member_count": {
              "type": "integer",
              "minimum": 0
            },
            "max_member_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "group_id",
            "group_name",
            "member_count",
            "max_member_count"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "user_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "nickname": {
              "type": "string",
              "maxLength": 256
            },
            "card": {
              "type": "string",
              "maxLength": 256
            },
            "role": {
              "enum": [
                "owner",
                "admin",
                "member"
              ]
            }
          },
          "required": [
            "group_id",
            "user_id",
            "nickname",
            "card",
            "role"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 25,
              "items": {
                "type": "object",
                "properties": {
                  "group_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,18}$"
                  },
                  "user_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,18}$"
                  },
                  "nickname": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "card": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "role": {
                    "enum": [
                      "owner",
                      "admin",
                      "member"
                    ]
                  }
                },
                "required": [
                  "group_id",
                  "user_id",
                  "nickname",
                  "card",
                  "role"
                ],
                "additionalProperties": false
              }
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "next_after_user_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          },
          "required": [
            "items",
            "total",
            "next_after_user_id"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "binding_ref",
    "self_id",
    "data"
  ],
  "additionalProperties": false
}
