{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_ref",
    "binding_epoch",
    "connection_epoch",
    "client_incarnation",
    "adapter_generation_id",
    "graph_id",
    "graph_revision",
    "transport_digest",
    "query",
    "after_group_id"
  ],
  "properties": {
    "binding_ref": {
      "type": "string"
    },
    "binding_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "connection_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "client_incarnation": {
      "type": "string"
    },
    "adapter_generation_id": {
      "type": "string"
    },
    "graph_id": {
      "type": "string"
    },
    "graph_revision": {
      "type": "integer",
      "minimum": 1
    },
    "transport_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "query": {
      "type": "string",
      "maxLength": 128
    },
    "after_group_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[1-9][0-9]{0,18}$"
    }
  }
}
