{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol",
    "status",
    "message_id",
    "error_code"
  ],
  "properties": {
    "protocol": {
      "const": "forest.onebot-send-result/3"
    },
    "status": {
      "enum": [
        "SENT",
        "NOT_SENT",
        "REJECTED",
        "UNKNOWN"
      ]
    },
    "message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
