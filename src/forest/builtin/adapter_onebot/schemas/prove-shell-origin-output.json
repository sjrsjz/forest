{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol",
    "event_ref",
    "binding_ref",
    "binding_epoch",
    "conversation_ref",
    "principal_ref",
    "self_id",
    "adapter_generation_id",
    "platform_message_ref"
  ],
  "properties": {
    "protocol": {
      "const": "forest.onebot-shell-origin-proof/1"
    },
    "event_ref": {
      "type": "string"
    },
    "binding_ref": {
      "type": "string"
    },
    "binding_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "conversation_ref": {
      "type": "string"
    },
    "principal_ref": {
      "type": "string"
    },
    "self_id": {
      "type": "string"
    },
    "adapter_generation_id": {
      "type": "string"
    },
    "platform_message_ref": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
