{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "action",
    "wire_payload",
    "wire_digest"
  ],
  "properties": {
    "action": {
      "enum": [
        "send_group_msg",
        "send_private_msg"
      ]
    },
    "wire_payload": {
      "type": "object",
      "required": [
        "payload_id",
        "digest",
        "owner_component_id",
        "owner_kind",
        "owner_id"
      ],
      "properties": {
        "payload_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "owner_component_id": {
          "const": "kernel.effect"
        },
        "owner_kind": {
          "const": "effect.wire"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "wire_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
