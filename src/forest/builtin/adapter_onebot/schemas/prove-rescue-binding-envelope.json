{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol", "caller", "input", "prior"],
  "additionalProperties": false,
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object",
      "required": ["component_id", "generation_id"],
      "additionalProperties": false,
      "properties": {
        "component_id": {"const": "kernel.runtime"},
        "generation_id": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object",
      "required": ["protocol", "event_ref", "binding_ref", "binding_epoch", "self_id", "adapter_generation_id", "conversation_ref", "group_ref", "principal_ref", "client_incarnation"],
      "additionalProperties": false,
      "properties": {
        "protocol": {"const": "forest.core-rescue-binding-check/1"},
        "event_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "binding_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "binding_epoch": {"type": "integer", "minimum": 1},
        "self_id": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
        "adapter_generation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "conversation_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "group_ref": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
        "principal_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "client_incarnation": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "prior": {"type": "object"}
  }
}
