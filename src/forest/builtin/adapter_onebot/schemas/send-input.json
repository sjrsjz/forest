{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol",
    "effect_operation_id",
    "attempt_id",
    "binding_ref",
    "binding_epoch",
    "connection_epoch",
    "client_incarnation",
    "adapter_generation_id",
    "graph_id",
    "graph_revision",
    "transport_digest",
    "prepared",
    "timeout_seconds"
  ],
  "properties": {
    "protocol": {
      "const": "forest.onebot-send/3"
    },
    "effect_operation_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "binding_ref": {
      "type": "string"
    },
    "binding_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "connection_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "client_incarnation": {
      "type": "string"
    },
    "adapter_generation_id": {
      "type": "string"
    },
    "graph_id": {
      "type": "string"
    },
    "graph_revision": {
      "type": "integer",
      "minimum": 1
    },
    "transport_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "prepared": {
      "type": "object",
      "required": [
        "action",
        "wire_payload",
        "wire_digest"
      ],
      "properties": {
        "action": {
          "enum": [
            "send_group_msg",
            "send_private_msg"
          ]
        },
        "wire_payload": {
          "type": "object",
          "required": [
            "payload_id",
            "digest",
            "owner_component_id",
            "owner_kind",
            "owner_id"
          ],
          "properties": {
            "payload_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "owner_component_id": {
              "const": "kernel.effect"
            },
            "owner_kind": {
              "const": "effect.wire"
            },
            "owner_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        "wire_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 30
    }
  },
  "additionalProperties": false
}
