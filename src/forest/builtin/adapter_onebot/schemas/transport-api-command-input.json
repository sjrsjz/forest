{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "binding_ref": {
      "type": "string"
    },
    "action": {
      "enum": [
        "set_group_ban",
        "set_group_whole_ban",
        "set_group_kick",
        "set_group_card",
        "set_group_name"
      ]
    },
    "arguments": {
      "type": "object"
    },
    "binding_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "connection_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "client_incarnation": {
      "type": "string"
    },
    "adapter_generation_id": {
      "type": "string"
    },
    "graph_id": {
      "type": "string"
    },
    "graph_revision": {
      "type": "integer",
      "minimum": 1
    },
    "transport_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "binding_ref",
    "action",
    "arguments",
    "binding_epoch",
    "connection_epoch",
    "client_incarnation",
    "adapter_generation_id",
    "graph_id",
    "graph_revision",
    "transport_digest"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "action": {
          "const": "set_group_ban"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "user_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2592000
            }
          },
          "required": [
            "group_id",
            "user_id",
            "duration"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "set_group_whole_ban"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "enable": {
              "type": "boolean"
            }
          },
          "required": [
            "group_id",
            "enable"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "set_group_kick"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "user_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "reject_add_request": {
              "type": "boolean"
            }
          },
          "required": [
            "group_id",
            "user_id",
            "reject_add_request"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "set_group_card"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "user_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "card": {
              "type": "string",
              "maxLength": 128
            }
          },
          "required": [
            "group_id",
            "user_id",
            "card"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "set_group_name"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "group_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "group_id",
            "group_name"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
