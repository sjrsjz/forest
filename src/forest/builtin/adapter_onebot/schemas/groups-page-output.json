{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "total",
    "next_after_group_id",
    "accounts",
    "binding_ref"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "group_name"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "group_name": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "next_after_group_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "binding_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "accounts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_ref",
          "self_id"
        ],
        "properties": {
          "binding_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "self_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          }
        }
      }
    }
  }
}
