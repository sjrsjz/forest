{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["effect", "budget", "memory"],
  "properties": {
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "effect_operation_id", "attempt_id", "abandonment_operation_id", "reason_code", "cancel_effect"],
      "properties": {
        "protocol": {"const": "forest.effect-abandon/1"},
        "effect_operation_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "abandonment_operation_id": {"$ref": "#/$defs/id"},
        "reason_code": {"$ref": "#/$defs/reason"},
        "cancel_effect": {"const": false}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "reservation_id", "state", "charged_tokens", "error_code"],
      "properties": {
        "protocol": {"const": "forest.memory-embedding-budget-settle/1"},
        "reservation_id": {"$ref": "#/$defs/id"},
        "state": {"const": "RELEASED"},
        "charged_tokens": {"type": "null"},
        "error_code": {"$ref": "#/$defs/reason"}
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "claim_id", "attempt_id", "effect_operation_id", "abandonment_operation_id", "reservation_id", "reason_code"],
      "properties": {
        "protocol": {"const": "forest.memory-embedding-abandon/1"},
        "claim_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "effect_operation_id": {"$ref": "#/$defs/id"},
        "abandonment_operation_id": {"$ref": "#/$defs/id"},
        "reservation_id": {"$ref": "#/$defs/id"},
        "reason_code": {"$ref": "#/$defs/reason"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "reason": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}
  }
}
