{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["request_id", "work_kind", "plan"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "work_kind": {"enum": ["SOURCE", "BATCH"]},
    "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "selection_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 256},
    "after_ordinal": {"type": "integer", "minimum": 0, "maximum": 999999},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 64},
    "plan": {"type": "object", "required": ["protocol", "deletion_epoch",
      "selection_digest", "plan_digest"],
      "properties": {
        "protocol": {"enum": ["forest.memory-forget-impact-plan/1",
          "forest.memory-forget-batch-impact-plan/1"]},
        "deletion_epoch": {"type": "integer", "minimum": 0},
        "selection_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }}
  },
  "oneOf": [
    {"properties": {"work_kind": {"const": "SOURCE"},
      "plan": {"properties": {"protocol": {"const": "forest.memory-forget-impact-plan/1"}}}},
      "required": ["source_unit_id"],
      "not": {"anyOf": [{"required": ["selection_id"]}, {"required": ["requested_by"]},
        {"required": ["after_ordinal"]}, {"required": ["batch_size"]}]}},
    {"properties": {"work_kind": {"const": "BATCH"},
      "plan": {"properties": {"protocol": {"const": "forest.memory-forget-batch-impact-plan/1"}}}},
      "required": ["selection_id", "requested_by", "after_ordinal", "batch_size"],
      "not": {"required": ["source_unit_id"]}}
  ]
}
