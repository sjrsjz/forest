{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["request_id", "source_unit_id", "plan"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "plan": {"type": "object", "required": ["protocol", "source_unit_id",
      "deletion_epoch", "selection_digest", "plan_digest"],
      "properties": {
        "protocol": {"const": "forest.memory-forget-impact-plan/1"},
        "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "deletion_epoch": {"type": "integer", "minimum": 0},
        "selection_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }}
  }
}
