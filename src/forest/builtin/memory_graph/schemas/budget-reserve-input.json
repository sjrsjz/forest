{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "reservation_id", "batch_ref", "policy_revision", "request_limit", "token_limit", "reserved_tokens"],
  "properties": {
    "protocol": {"const": "forest.memory-embedding-budget-reserve/1"},
    "reservation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "batch_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "policy_revision": {"const": "daily-cost-cap/1"},
    "request_limit": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "token_limit": {"type": "integer", "minimum": 1, "maximum": 1000000000000},
    "reserved_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000000}
  }
}
