{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "request_id", "selection_id", "after_ordinal",
    "batch_size", "state", "attempt_count", "result", "error_code",
    "created_at", "updated_at"],
  "properties": {
    "protocol": {"const": "forest.memory-forget-batch-work/1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "selection_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "after_ordinal": {"type": "integer", "minimum": 0, "maximum": 999999},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 64},
    "state": {"enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "UNKNOWN"]},
    "attempt_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "result": {"type": ["object", "null"]},
    "error_code": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
