{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "source_unit_id", "batch_index", "facet_count"],
  "properties": {
    "protocol": {"const": "forest.memory-facets-prepared/1"},
    "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "batch_index": {"type": "integer", "minimum": 0, "maximum": 65535},
    "facet_count": {"type": "integer", "minimum": 1, "maximum": 64}
  }
}
