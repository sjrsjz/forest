{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "query_id",
    "bundle_id",
    "evidence_ref",
    "evidence_count",
    "missing_count",
    "content_truncated",
    "truncated",
    "truncation_reason",
    "association_sampled"
  ],
  "properties": {
    "protocol": {
      "const": "forest.memory-evidence-receipt/2"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_id",
        "digest",
        "owner_component_id",
        "owner_kind",
        "owner_id"
      ],
      "properties": {
        "payload_id": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "owner_component_id": {
          "$ref": "#/$defs/id"
        },
        "owner_kind": {
          "$ref": "#/$defs/id"
        },
        "owner_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "missing_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "content_truncated": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    },
    "truncation_reason": {"enum": ["SEED_LIMIT", "NODE_LIMIT", "SEED_AND_NODE_LIMIT", null]},
    "association_sampled": {
      "type": "boolean"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
