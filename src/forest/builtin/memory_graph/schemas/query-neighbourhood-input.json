{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["endpoint_kind", "endpoint_id"],
  "properties": {
    "endpoint_kind": {"$ref": "#/$defs/kind"},
    "endpoint_id": {"$ref": "#/$defs/id"},
    "relation_kinds": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["ASSOCIATES_WITH", "EVIDENCE", "CONTRADICTS", "SUBJECT_OF"]}},
    "origin_kinds": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["MANUAL", "VECTOR", "RULE", "MODEL"]}},
    "review_states": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": {"enum": ["UNREVIEWED", "APPROVED"]}},
    "direction": {"enum": ["OUTBOUND", "INBOUND", "UNDIRECTED"]},
    "cross_trunk": {"type": "boolean"},
    "evidence_trunk_id": {"$ref": "#/$defs/id"},
    "evidence_external_group_id": {"$ref": "#/$defs/id"},
    "evidence_author_subject_ref": {"$ref": "#/$defs/id"},
    "max_hops": {"type": "integer", "minimum": 1, "maximum": 3},
    "max_nodes": {"type": "integer", "minimum": 1, "maximum": 32},
    "max_edges": {"type": "integer", "minimum": 1, "maximum": 32}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "kind": {"enum": ["SOURCE_UNIT", "ASSERTION", "ENTITY", "ARTIFACT"]}
  }
}
