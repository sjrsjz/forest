{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "conversation.scheduler"},
        "generation_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["conversation_ref", "reply_ref"],
      "properties": {
        "conversation_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "reply_ref": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "prior": {
      "type": "object",
      "required": ["agent", "conversation"],
      "properties": {
        "agent": {"type": "object"},
        "conversation": {"type": "object"}
      }
    }
  }
}
