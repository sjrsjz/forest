{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["claim_id", "space_id", "source_epoch_high_watermark", "facets"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "space_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source_epoch_high_watermark": {"type": "integer", "minimum": 0},
    "facets": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "facet_id", "source_unit_id", "source_revision", "part_id", "trunk_id",
          "conversation_ref", "author_ref", "modality", "selector_start_char",
          "selector_end_char", "input_payload", "facet_content_digest",
          "input_byte_length", "media_type", "width", "height"
        ],
        "properties": {
          "facet_id": {"$ref": "#/$defs/id"},
          "source_unit_id": {"$ref": "#/$defs/id"},
          "source_revision": {"type": "integer", "minimum": 1},
          "part_id": {"$ref": "#/$defs/id"},
          "trunk_id": {"type": ["string", "null"]},
          "conversation_ref": {"$ref": "#/$defs/id"},
          "author_ref": {"$ref": "#/$defs/id"},
          "modality": {"enum": ["TEXT", "IMAGE"]},
          "selector_start_char": {"type": ["integer", "null"], "minimum": 0},
          "selector_end_char": {"type": ["integer", "null"], "minimum": 1},
          "input_payload": {"$ref": "#/$defs/payload"},
          "facet_content_digest": {"$ref": "#/$defs/digest"},
          "input_byte_length": {"type": "integer", "minimum": 1},
          "media_type": {"type": "string"},
          "width": {"type": ["integer", "null"], "minimum": 1},
          "height": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"$ref": "#/$defs/id"},
        "owner_kind": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
