{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "source_unit_id",
    "source_revision",
    "state",
    "facet_count",
    "error_code",
    "created_at",
    "updated_at",
    "published_at"
  ],
  "properties": {
    "protocol": {
      "const": "forest.memory-text-rebuild/1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_unit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "QUEUED",
        "CLAIMED",
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "facet_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4096
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
