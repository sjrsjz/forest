{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "relation_id", "contribution_id", "review_state", "cross_trunk", "created_at"],
  "properties": {
    "protocol": {"const": "forest.memory-relation-candidate/1"},
    "relation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "contribution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "review_state": {"const": "UNREVIEWED"},
    "cross_trunk": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
