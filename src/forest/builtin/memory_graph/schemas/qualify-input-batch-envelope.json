{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "agent.runtime"},
        "generation_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_step_id", "deletion_epoch_step_id"],
      "properties": {
        "selection_step_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "deletion_epoch_step_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "prior": {"type": "object"}
  }
}
