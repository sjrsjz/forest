{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "properties": {
    "limit": {"type": "integer", "minimum": 1, "maximum": 50},
    "relation_id": {"$ref": "#/$defs/id"},
    "contribution_id": {"$ref": "#/$defs/id"},
    "actor_subject_ref": {"$ref": "#/$defs/id"},
    "reason_code": {"enum": ["INCORRECT", "STALE", "UNSAFE", "OTHER"]},
    "snapshot_created_at": {"type": "string", "format": "date-time"},
    "snapshot_xid": {"type": "string", "minLength": 3, "maxLength": 65536},
    "after_created_at": {"type": "string", "format": "date-time"},
    "after_operation_id": {"$ref": "#/$defs/id"},
    "cursor_filter_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "dependentRequired": {
    "after_created_at": ["after_operation_id", "snapshot_created_at", "snapshot_xid", "cursor_filter_digest"],
    "after_operation_id": ["after_created_at", "snapshot_created_at", "snapshot_xid", "cursor_filter_digest"]
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 256}}
}
