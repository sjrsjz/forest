{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_epoch",
    "memory"
  ],
  "properties": {
    "payload_epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol"
      ],
      "properties": {
        "protocol": {
          "const": "forest.payload-epoch-capture/1"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "deletion_epoch_step_id",
        "generation_id",
        "expected_active_generation_id",
        "expected_active_revision"
      ],
      "properties": {
        "protocol": {
          "const": "forest.memory-graph-publish/1"
        },
        "deletion_epoch_step_id": {
          "const": "payload_epoch"
        },
        "generation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expected_active_generation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expected_active_revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
