{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_id", "requested_by", "parts"],
  "properties": {
    "query_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 256},
    "parts": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["part_id", "modality", "media_type", "byte_length", "width", "height", "payload"],
        "properties": {
          "part_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "modality": {"enum": ["TEXT", "IMAGE"]},
          "media_type": {"enum": ["text/plain", "image/png", "image/jpeg", "image/webp"]},
          "byte_length": {"type": "integer", "minimum": 1, "maximum": 8388608},
          "width": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000},
          "height": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000},
          "payload": {
            "type": "object", "additionalProperties": false,
            "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
            "properties": {
              "payload_id": {"type": "string", "minLength": 1, "maxLength": 256},
              "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "owner_component_id": {"const": "memory.graph"},
              "owner_kind": {"const": "trial.input"},
              "owner_id": {"type": "string", "minLength": 1, "maxLength": 256}
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"modality": {"const": "TEXT"}}},
           "then": {"properties": {"media_type": {"const": "text/plain"},
              "byte_length": {"maximum": 65536}, "width": {"type": "null"}, "height": {"type": "null"}}}},
          {"if": {"properties": {"modality": {"const": "IMAGE"}}},
           "then": {"properties": {"media_type": {"enum": ["image/png", "image/jpeg", "image/webp"]},
             "width": {"type": "integer"}, "height": {"type": "integer"}}}}
        ]
      }
    }
  }
}
