{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "query_id",
    "space_id",
    "input_batch_ref",
    "context_revision",
    "query_mode",
    "part_count"
  ],
  "properties": {
    "protocol": {
      "const": "forest.memory-query/1"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "space_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "input_batch_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "context_revision": {
      "type": "integer",
      "minimum": 1
    },
    "query_mode": {
      "enum": [
        "TEXT",
        "IMAGE",
        "MIXED"
      ]
    },
    "part_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    }
  }
}
