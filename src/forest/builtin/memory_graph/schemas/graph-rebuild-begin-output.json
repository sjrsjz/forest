{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation_id",
    "base_generation_id",
    "base_revision",
    "replayed_through"
  ],
  "properties": {
    "generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "replayed_through": {
      "type": "integer",
      "minimum": 0
    }
  }
}
