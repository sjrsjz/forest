{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id",
    "result_count",
    "input_kind",
    "current_source",
    "max_retrieval_chars", "max_retrieval_media_bytes",
    "truncated",
    "association_sampled",
    "read_count",
    "evidence_ref",
    "item_indexes",
    "content_truncated",
    "missing_count"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "result_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "input_kind": {"enum": ["SOURCE_UNIT", "ADMIN_TRIAL"]},
    "current_source": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_kind",
        "platform",
        "realm_id",
        "external_group_id",
        "trunk_id"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_kind": {
          "enum": [
            "GROUP",
            "DIRECT",
            "DOCUMENT",
            "SYSTEM",
            "UNKNOWN"
          ]
        },
        "platform": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "realm_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "external_group_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "trunk_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "max_retrieval_chars": {
      "type": "integer",
      "minimum": 256,
      "maximum": 1000000
    },
    "max_retrieval_media_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432
    },
    "truncated": {
      "type": "boolean"
    },
    "association_sampled": {
      "type": "boolean"
    },
    "read_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "evidence_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payload_id",
            "digest",
            "owner_component_id",
            "owner_kind",
            "owner_id"
          ],
          "properties": {
            "payload_id": {
              "$ref": "#/$defs/id"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "owner_component_id": {
              "$ref": "#/$defs/id"
            },
            "owner_kind": {
              "$ref": "#/$defs/id"
            },
            "owner_id": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "item_indexes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 63
      }
    },
    "content_truncated": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "missing_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 64
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {"if": {"properties": {"input_kind": {"const": "SOURCE_UNIT"}}},
     "then": {"properties": {"current_source": {"type": "object"}}}},
    {"if": {"properties": {"input_kind": {"const": "ADMIN_TRIAL"}}},
     "then": {"properties": {"current_source": {"type": "null"}}}}
  ]
}
