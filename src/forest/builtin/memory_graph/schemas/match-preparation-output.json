{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prepared",
    "complete",
    "policy",
    "space_id",
    "facet_count",
    "completed_facet_refs",
    "match_count"
  ],
  "properties": {
    "prepared": {
      "type": "boolean"
    },
    "complete": {
      "type": "boolean"
    },
    "policy": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_revision",
            "seed_limit",
            "candidate_limit_per_facet",
            "min_similarity",
            "min_graph_relevance",
            "max_graph_nodes",
            "max_association_edges_per_node",
            "max_retrieval_chars", "max_retrieval_media_bytes",
            "sequence_weight",
            "association_weight"
          ],
          "properties": {
            "policy_revision": {
              "const": "qiyu-graph-region/2"
            },
            "seed_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "candidate_limit_per_facet": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "min_similarity": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "min_graph_relevance": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "max_graph_nodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "max_association_edges_per_node": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "max_retrieval_chars": {
              "type": "integer",
              "minimum": 256,
              "maximum": 1000000
            },
            "max_retrieval_media_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 33554432
            },
            "sequence_weight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "association_weight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "space_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "facet_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 256
    },
    "completed_facet_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "match_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    }
  }
}
