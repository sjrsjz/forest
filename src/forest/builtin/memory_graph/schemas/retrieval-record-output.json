{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "query_id",
    "bundle_id",
    "result_count",
    "seed_count",
    "read_count",
    "deletion_epoch",
    "truncated",
    "truncation_reason",
    "association_sampled"
  ],
  "properties": {
    "protocol": {
      "const": "forest.memory-retrieval-record/2"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "result_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "seed_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "read_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "deletion_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "truncation_reason": {"enum": ["SEED_LIMIT", "NODE_LIMIT", "SEED_AND_NODE_LIMIT", null]},
    "association_sampled": {
      "type": "boolean"
    }
  }
}
