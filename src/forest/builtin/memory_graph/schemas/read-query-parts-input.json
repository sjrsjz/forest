{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "after_part_index",
    "limit"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "after_part_index": {
      "type": "integer",
      "minimum": -1,
      "maximum": 255
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    }
  }
}
