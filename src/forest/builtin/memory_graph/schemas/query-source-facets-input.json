{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["source_unit_id"],
  "properties": {
    "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "state": {"enum": ["PENDING", "PREPARED", "DISPATCHED", "EMBEDDED", "READY", "UNKNOWN", "FAILED", "SUPPRESSED"]},
    "after_facet_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100}
  }
}
