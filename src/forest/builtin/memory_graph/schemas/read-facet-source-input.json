  "properties": {
    "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "after_part_index": {"type": "integer", "minimum": -1, "maximum": 4095},
    "limit": {"type": "integer", "minimum": 1, "maximum": 64}
  }
}
