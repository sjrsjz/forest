{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "reservation_id", "state", "charged_tokens", "error_code"],
  "properties": {
    "protocol": {"const": "forest.memory-embedding-budget-settle/1"},
    "reservation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "state": {"enum": ["RELEASED", "CHARGED", "UNKNOWN"]},
    "charged_tokens": {"type": ["integer", "null"], "minimum": 0},
    "error_code": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "CHARGED"}}},
     "then": {"properties": {"charged_tokens": {"type": "integer"}}},
     "else": {"properties": {"charged_tokens": {"type": "null"}}}}
  ]
}
