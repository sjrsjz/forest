{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_accepted_at", "items", "has_more", "next_cursor", "filter_digest"],
  "properties": {
    "snapshot_accepted_at": {"type": "string", "format": "date-time"},
    "items": {"type": "array", "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["source_unit_id", "source_id", "trunk_id", "source_kind", "platform", "realm_id", "external_group_id", "author_subject_ref", "unit_kind", "modality", "occurred_at", "source_order_seq", "part_count", "eligibility_state", "source_status"],
      "properties": {
        "source_unit_id": {"type": "string"},
        "source_id": {"type": "string"},
        "trunk_id": {"type": ["string", "null"]},
        "source_kind": {"type": "string"},
        "platform": {"type": ["string", "null"]},
        "realm_id": {"type": ["string", "null"]},
        "external_group_id": {"type": ["string", "null"]},
        "author_subject_ref": {"type": "string"},
        "unit_kind": {"type": "string"},
        "modality": {"type": "string"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "source_order_seq": {"type": "integer"},
        "part_count": {"type": "integer"},
        "eligibility_state": {"enum": ["REGISTERED", "ELIGIBLE", "SUPPRESSED"]},
        "source_status": {"enum": ["ACTIVE", "RETIRED"]}
      }
    }},
    "has_more": {"type": "boolean"},
    "next_cursor": {"type": ["object", "null"], "additionalProperties": false,
      "required": ["occurred_at", "source_unit_id"],
      "properties": {"occurred_at": {"type": "string", "format": "date-time"}, "source_unit_id": {"type": "string"}}},
    "filter_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
