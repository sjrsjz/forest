{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["prepare", "payload", "memory"],
  "properties": {
    "prepare": {"type": "object", "additionalProperties": false,
      "required": ["operation_id", "selection_id", "requested_by", "after_ordinal", "batch_size"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "selection_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "requested_by": {"type": "string", "minLength": 1, "maxLength": 256},
        "after_ordinal": {"type": "integer", "minimum": 0, "maximum": 999999},
        "batch_size": {"type": "integer", "minimum": 1, "maximum": 64}}},
    "payload": {"type": "object", "additionalProperties": false,
      "required": ["protocol", "prior_step_id", "operation_id",
        "expected_deletion_epoch", "expected_selection_digest"],
      "properties": {
        "protocol": {"const": "forest.payload-forget-anchors/1"},
        "prior_step_id": {"const": "prepare"},
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "expected_deletion_epoch": {"type": "integer", "minimum": 0},
        "expected_selection_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}},
    "memory": {"type": "object", "additionalProperties": false,
      "required": ["operation_id", "selection_id", "requested_by", "after_ordinal",
        "batch_size", "prepare_step_id", "forget_step_id", "plan"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "selection_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "requested_by": {"type": "string", "minLength": 1, "maxLength": 256},
        "after_ordinal": {"type": "integer", "minimum": 0, "maximum": 999999},
        "batch_size": {"type": "integer", "minimum": 1, "maximum": 64},
        "prepare_step_id": {"const": "prepare"},
        "forget_step_id": {"const": "payload"},
        "plan": {"type": "object", "required": ["protocol", "plan_digest"],
          "properties": {
            "protocol": {"const": "forest.memory-forget-batch-impact-plan/1"},
            "plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}}}
  }
}
