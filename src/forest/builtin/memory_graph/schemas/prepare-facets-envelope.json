{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "caller",
    "input",
    "prior"
  ],
  "properties": {
    "protocol": {
      "const": "forest.uow-step/1"
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "generation_id"
      ],
      "properties": {
        "component_id": {
          "const": "memory.graph"
        },
        "generation_id": {
          "type": "string"
        }
      }
    },
    "input": {
      "oneOf": [
        {
          "$ref": "#/$defs/document_input"
        },
        {
          "$ref": "#/$defs/query_input"
        }
      ]
    },
    "prior": {
      "type": "object"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_id",
        "digest",
        "owner_component_id",
        "owner_kind",
        "owner_id"
      ],
      "properties": {
        "payload_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "owner_component_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facet_id",
        "part_id",
        "modality",
        "selector_start_char",
        "selector_end_char",
        "facet_content_digest",
        "input_byte_length",
        "input_payload"
      ],
      "properties": {
        "facet_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "part_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "modality": {
          "enum": [
            "TEXT",
            "IMAGE"
          ]
        },
        "selector_start_char": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "selector_end_char": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "facet_content_digest": {
          "$ref": "#/$defs/digest"
        },
        "input_byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "input_payload": {
          "$ref": "#/$defs/payload"
        },
        "search_text": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "document_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "source_unit_id",
        "source_revision",
        "space_id",
        "batch_index",
        "facets"
      ],
      "properties": {
        "protocol": {
          "const": "forest.memory-document-facets/1"
        },
        "source_unit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "space_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "batch_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "facets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/facet"},
              {
                "if": {"properties": {"modality": {"const": "TEXT"}}},
                "then": {"required": ["search_text"]},
                "else": {"not": {"required": ["search_text"]}}
              }
            ]
          }
        }
      }
    },
    "query_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "input_identity",
        "space_id",
        "batch_index",
        "facets",
        "query_id",
        "part_id"
      ],
      "properties": {
        "protocol": {
          "const": "forest.memory-query-part-facets/1"
        },
        "input_identity": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "ref", "revision"],
          "properties": {
            "kind": {"enum": ["SOURCE_UNIT", "ADMIN_TRIAL"]},
            "ref": {"type": "string", "minLength": 1, "maxLength": 256},
            "revision": {"type": "integer", "minimum": 1}
          }
        },
        "source_unit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "space_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "batch_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "facets": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/facet"
          }
        },
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "part_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "oneOf": [
        {
          "properties": {"input_identity": {"properties": {"kind": {"const": "SOURCE_UNIT"}}}},
          "required": ["source_unit_id", "source_revision"]
        },
        {
          "properties": {"input_identity": {"properties": {"kind": {"const": "ADMIN_TRIAL"}}}},
          "not": {"anyOf": [{"required": ["source_unit_id"]}, {"required": ["source_revision"]}]}
        }
      ]
    }
  }
}
