{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "claim_id", "attempt_id", "effect_operation_id", "state", "facet_count"],
  "properties": {
    "protocol": {"const": "forest.memory-embedding-handoff/1"},
    "claim_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "effect_operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "state": {"const": "DISPATCHED"},
    "facet_count": {"type": "integer", "minimum": 1, "maximum": 32}
  }
}
