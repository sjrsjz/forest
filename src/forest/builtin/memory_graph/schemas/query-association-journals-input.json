{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "journal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "enum": [
        "PENDING_ARCHIVE",
        "PROMOTED",
        "SUPPRESSED"
      ]
    },
    "trigger_external_group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "seed_external_group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "trigger_trunk_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "seed_trunk_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "trigger_author_subject_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "seed_author_subject_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "snapshot_xid": {
      "type": "string",
      "minLength": 3,
      "maxLength": 65536
    },
    "after_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "after_journal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "cursor_filter_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "dependentRequired": {
    "after_created_at": [
      "after_journal_id",
      "snapshot_xid",
      "cursor_filter_digest"
    ],
    "after_journal_id": [
      "after_created_at",
      "snapshot_xid",
      "cursor_filter_digest"
    ]
  }
}
