{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "memory.graph"},
        "generation_id": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "source_unit_id", "prepare_step_id", "forget_step_id"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "prepare_step_id": {"const": "prepare"},
        "forget_step_id": {"const": "payload"}
      }
    },
    "prior": {"type": "object", "required": ["prepare", "payload"]}
  }
}
