{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["selection_id", "requested_by"],
  "properties": {
    "selection_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 256},
    "after_ordinal": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100}
  }
}
