{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["source_unit_id", "source_id", "source_revision", "trunk_id", "external_group_id", "author_subject_ref", "items", "has_more", "next_after"],
  "properties": {
    "source_unit_id": {"type": "string"},
    "source_id": {"type": "string"},
    "source_revision": {"type": "integer", "minimum": 1},
    "trunk_id": {"type": ["string", "null"]},
    "external_group_id": {"type": ["string", "null"]},
    "author_subject_ref": {"type": "string"},
    "items": {"type": "array", "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["facet_id", "part_id", "modality", "state", "failure_code", "created_at", "attempt_id", "last_unknown_attempt_id", "claim_id", "attempt_state", "effect_operation_id", "executor_generation_id", "dispatched_at", "settled_at", "budget_day", "reservation_state", "reserved_tokens", "charged_tokens", "reservation_error_code"],
      "properties": {
        "facet_id": {"type": "string"},
        "part_id": {"type": "string"},
        "modality": {"enum": ["TEXT", "IMAGE"]},
        "state": {"enum": ["PENDING", "PREPARED", "DISPATCHED", "EMBEDDED", "READY", "UNKNOWN", "FAILED", "SUPPRESSED"]},
        "failure_code": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"},
        "attempt_id": {"type": ["string", "null"]},
        "last_unknown_attempt_id": {"type": ["string", "null"]},
        "claim_id": {"type": ["string", "null"]},
        "attempt_state": {"type": ["string", "null"]},
        "effect_operation_id": {"type": ["string", "null"]},
        "executor_generation_id": {"type": ["string", "null"]},
        "dispatched_at": {"type": ["string", "null"], "format": "date-time"},
        "settled_at": {"type": ["string", "null"], "format": "date-time"},
        "budget_day": {"type": ["string", "null"], "format": "date"},
        "reservation_state": {"type": ["string", "null"]},
        "reserved_tokens": {"type": ["integer", "null"], "minimum": 1},
        "charged_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reservation_error_code": {"type": ["string", "null"]}
      }
    }},
    "has_more": {"type": "boolean"},
    "next_after": {"type": ["string", "null"]}
  }
}
