{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "source_unit_id",
    "association_limit"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_unit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "association_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    }
  }
}
