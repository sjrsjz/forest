{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "memory.graph"},
        "generation_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "claim_id", "facet_id", "facet_content_digest", "space_id", "reason_code"],
      "properties": {
        "protocol": {"const": "forest.memory-embedding-facet-reject/1"},
        "claim_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "facet_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "facet_content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "space_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "reason_code": {"const": "EMBEDDING_FACET_INVALID"}
      }
    },
    "prior": {"type": "object", "maxProperties": 0}
  }
}
