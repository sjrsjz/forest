{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "source_unit_id",
    "source_revision"
  ],
  "properties": {
    "protocol": {
      "const": "forest.memory-text-rebuild-enqueued/1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_unit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
