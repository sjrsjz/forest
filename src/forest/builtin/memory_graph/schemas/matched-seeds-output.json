{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy",
    "result"
  ],
  "properties": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_revision",
        "seed_limit",
        "candidate_limit_per_facet",
        "min_similarity",
        "min_graph_relevance",
        "max_graph_nodes",
        "max_association_edges_per_node",
        "max_retrieval_chars", "max_retrieval_media_bytes",
        "sequence_weight",
        "association_weight"
      ],
      "properties": {
        "policy_revision": {
          "const": "qiyu-graph-region/2"
        },
        "seed_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "candidate_limit_per_facet": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "min_similarity": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "min_graph_relevance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_graph_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_association_edges_per_node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "max_retrieval_chars": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1000000
        },
        "max_retrieval_media_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "sequence_weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "association_weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "query_id",
        "space_id",
        "index_snapshot_at",
        "seeds"
      ],
      "properties": {
        "protocol": {
          "const": "forest.memory-query-seeds/1"
        },
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "space_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "index_snapshot_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "seeds": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_unit_id",
              "source_revision",
              "source_id",
              "trunk_id",
              "source_kind",
              "platform",
              "realm_id",
              "external_group_id",
              "author_subject_ref",
              "rank_score",
              "activation",
              "query_modalities"
            ],
            "properties": {
              "source_unit_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source_revision": {
                "type": "integer",
                "minimum": 1
              },
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "trunk_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "source_kind": {
                "enum": [
                  "GROUP",
                  "DIRECT",
                  "DOCUMENT",
                  "SYSTEM",
                  "UNKNOWN"
                ]
              },
              "platform": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "realm_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "external_group_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "author_subject_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "rank_score": {
                "type": "number",
                "minimum": 0
              },
              "activation": {
                "const": 1
              },
              "query_modalities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "TEXT",
                    "IMAGE"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
