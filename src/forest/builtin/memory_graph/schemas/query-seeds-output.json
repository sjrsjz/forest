{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "query_id",
    "space_id",
    "index_snapshot_at",
    "seeds"
  ],
  "properties": {
    "protocol": {
      "const": "forest.memory-query-seeds/1"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "space_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "index_snapshot_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "seeds": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_unit_id",
          "source_revision",
          "source_id",
          "trunk_id",
          "source_kind",
          "platform",
          "realm_id",
          "external_group_id",
          "author_subject_ref",
          "rank_score",
          "activation",
          "query_modalities"
        ],
        "properties": {
          "source_unit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_revision": {
            "type": "integer",
            "minimum": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "trunk_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "source_kind": {
            "enum": [
              "GROUP",
              "DIRECT",
              "DOCUMENT",
              "SYSTEM",
              "UNKNOWN"
            ]
          },
          "platform": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "realm_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "external_group_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "author_subject_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "rank_score": {
            "type": "number",
            "minimum": 0
          },
          "activation": {
            "const": 1.0
          },
          "query_modalities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "TEXT",
                "IMAGE"
              ]
            }
          }
        }
      }
    }
  }
}
