{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "trunk_id": {"$ref": "#/$defs/id"},
    "source_id": {"$ref": "#/$defs/id"},
    "group_source_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "source_kind": {"enum": ["GROUP", "DIRECT", "DOCUMENT", "SYSTEM", "UNKNOWN"]},
    "platform": {"type": "string", "minLength": 1, "maxLength": 64},
    "realm_id": {"$ref": "#/$defs/id"},
    "external_group_id": {"$ref": "#/$defs/id"},
    "binding_ref": {"$ref": "#/$defs/id"},
    "author_subject_ref": {"$ref": "#/$defs/id"},
    "modality": {"enum": ["TEXT", "IMAGE", "MIXED", "CONTROL"]},
    "unit_kind": {"type": "string", "minLength": 1, "maxLength": 128},
    "eligibility_state": {"enum": ["REGISTERED", "ELIGIBLE", "SUPPRESSED"]},
    "source_status": {"enum": ["ACTIVE", "RETIRED"]},
    "index_coverage": {"enum": ["NO_FACETS", "NOT_READY", "PARTIAL", "COMPLETE"]},
    "source_order_from": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "source_order_to": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "occurred_from": {"type": "string", "format": "date-time"},
    "occurred_to": {"type": "string", "format": "date-time"},
    "snapshot_accepted_at": {"type": "string", "format": "date-time"},
    "snapshot_xid": {"type": "string", "minLength": 3, "maxLength": 65536},
    "after_occurred_at": {"type": "string", "format": "date-time"},
    "after_source_unit_id": {"$ref": "#/$defs/id"},
    "cursor_filter_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "dependentRequired": {
    "source_order_from": ["source_id"],
    "source_order_to": ["source_id"],
    "after_occurred_at": ["after_source_unit_id", "snapshot_accepted_at", "snapshot_xid", "cursor_filter_digest"],
    "after_source_unit_id": ["after_occurred_at", "snapshot_accepted_at", "snapshot_xid", "cursor_filter_digest"]
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 256}}
}
