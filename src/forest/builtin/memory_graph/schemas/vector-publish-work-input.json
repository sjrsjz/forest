{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["attempt_id", "claim_token", "space_id", "result", "facets"],
  "properties": {
    "attempt_id": {"$ref": "#/$defs/id"},
    "claim_token": {"$ref": "#/$defs/id"},
    "space_id": {"$ref": "#/$defs/id"},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"const": "embedding.multimodal"},
        "owner_kind": {"const": "embedding.result"},
        "owner_id": {"$ref": "#/$defs/id"}
      }
    },
    "facets": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["facet_id", "item_index", "source_unit_id", "source_revision", "modality", "state", "vector_digest"],
        "properties": {
          "facet_id": {"$ref": "#/$defs/id"},
          "item_index": {"type": "integer", "minimum": 0, "maximum": 31},
          "source_unit_id": {"$ref": "#/$defs/id"},
          "source_revision": {"type": "integer", "minimum": 1},
          "modality": {"enum": ["TEXT", "IMAGE"]},
          "state": {"enum": ["EMBEDDED", "READY", "SUPPRESSED"]},
          "vector_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
