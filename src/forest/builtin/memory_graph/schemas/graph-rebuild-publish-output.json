{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation_id",
    "previous_generation_id",
    "graph_revision",
    "deletion_epoch"
  ],
  "properties": {
    "generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "previous_generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "graph_revision": {
      "type": "integer",
      "minimum": 0
    },
    "deletion_epoch": {
      "type": "integer",
      "minimum": 0
    }
  }
}
