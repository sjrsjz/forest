{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id", "identity", "source_unit_id", "source_revision", "unit_kind",
    "author_subject_ref", "author", "parts", "occurrence", "occurred_at"
  ],
  "properties": {
    "operation_id": {"$ref": "#/$defs/operation_id"},
    "identity": {"$ref": "#/$defs/identity"},
    "source_unit_id": {"$ref": "#/$defs/id"},
    "source_revision": {"type": "integer", "minimum": 1},
    "unit_kind": {"type": "string", "minLength": 1, "maxLength": 128},
    "author_subject_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "author": {"$ref": "#/$defs/payload"},
    "parts": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/part"}
    },
    "occurrence": {"$ref": "#/$defs/occurrence"},
    "occurred_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "owner_kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "owner_id": {"$ref": "#/$defs/id"}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_id", "source_kind", "identity_incarnation", "platform", "realm_id",
        "external_group_id", "trunk_id"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_kind": {"enum": ["GROUP", "DIRECT", "DOCUMENT", "SYSTEM", "UNKNOWN"]},
        "identity_incarnation": {"type": "integer", "minimum": 1},
        "platform": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
        "realm_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "external_group_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "trunk_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      }
    },
    "part": {
      "type": "object", "additionalProperties": false,
      "required": [
        "part_id", "part_index", "part_kind", "state", "media_ref", "locator", "payload",
        "media_type", "width", "height", "byte_length", "decoded_pixels", "error_code"
      ],
      "properties": {
        "part_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "part_index": {"type": "integer", "minimum": 0, "maximum": 4095},
        "part_kind": {"enum": ["TEXT", "IMAGE"]},
        "state": {"const": "READY"},
        "media_ref": {"type": ["string", "null"], "maxLength": 512},
        "locator": {"type": ["object", "null"]},
        "payload": {"$ref": "#/$defs/payload"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "width": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000},
        "height": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000},
        "byte_length": {"type": ["integer", "null"], "minimum": 0, "maximum": 33554432},
        "decoded_pixels": {"type": ["integer", "null"], "minimum": 1, "maximum": 16777216},
        "error_code": {"type": "null"}
      }
    },
    "occurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["occurrence_id", "binding_ref", "conversation_ref", "event_ref", "ingress_seq", "observed_at"],
      "properties": {
        "occurrence_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "binding_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "conversation_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "event_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "ingress_seq": {"type": "integer", "minimum": 1},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
