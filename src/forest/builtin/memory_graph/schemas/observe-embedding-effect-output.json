{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "claim_id", "attempt_id", "state"],
  "properties": {
    "protocol": {"const": "forest.memory-embedding-observed/1"},
    "claim_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "state": {"enum": ["SUCCEEDED", "NOT_SENT", "UNKNOWN"]}
  }
}
