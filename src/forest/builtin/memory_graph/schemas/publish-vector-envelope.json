{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "memory.graph"},
        "generation_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "attempt_id", "claim_token", "space_id", "results"],
      "properties": {
        "protocol": {"const": "forest.memory-vector-publish/1"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "claim_token": {"$ref": "#/$defs/id"},
        "space_id": {"$ref": "#/$defs/id"},
        "results": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["facet_id", "status"],
            "properties": {
              "facet_id": {"$ref": "#/$defs/id"},
              "status": {"enum": ["PUBLISHED", "TOMBSTONED", "SKIPPED"]}
            }
          }
        }
      }
    },
    "prior": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_epoch"],
      "properties": {
        "payload_epoch": {
          "type": "object", "additionalProperties": false,
          "required": ["protocol", "deletion_epoch"],
          "properties": {
            "protocol": {"const": "forest.payload-epoch/1"},
            "deletion_epoch": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 256}}
}
