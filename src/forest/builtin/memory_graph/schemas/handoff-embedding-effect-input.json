{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["payload_epoch", "effect", "memory"],
  "properties": {
    "payload_epoch": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol"],
      "properties": {"protocol": {"const": "forest.payload-epoch-capture/1"}}
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "permit", "handoff_operation_id"],
      "properties": {
        "protocol": {"const": "forest.effect-handoff/1"},
        "permit": {"$ref": "#/$defs/permit"},
        "handoff_operation_id": {"$ref": "#/$defs/id"}
      }
    },
    "memory": {"$ref": "#/$defs/memory"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "permit": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "effect_operation_id", "attempt_id", "attempt_no", "wire_payload_id", "wire_payload_digest", "executor_component_id", "executor_generation_id", "fence_kind", "fence_id", "fence_epoch", "deadline_at"],
      "properties": {
        "protocol": {"const": "forest.effect-permit/1"},
        "effect_operation_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "attempt_no": {"const": 1},
        "wire_payload_id": {"$ref": "#/$defs/id"},
        "wire_payload_digest": {"$ref": "#/$defs/digest"},
        "executor_component_id": {"const": "embedding.multimodal"},
        "executor_generation_id": {"$ref": "#/$defs/id"},
        "fence_kind": {"const": "runtime.graph"},
        "fence_id": {"$ref": "#/$defs/id"},
        "fence_epoch": {"type": "integer", "minimum": 1},
        "deadline_at": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "claim_id", "attempt_id", "effect_operation_id", "handoff_operation_id"],
      "properties": {
        "protocol": {"const": "forest.memory-embedding-handoff/1"},
        "claim_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "effect_operation_id": {"$ref": "#/$defs/id"},
        "handoff_operation_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
