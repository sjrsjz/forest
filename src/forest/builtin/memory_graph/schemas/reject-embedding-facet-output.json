{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "claim_id", "facet_id", "state"],
  "properties": {
    "protocol": {"const": "forest.memory-embedding-facet-rejected/1"},
    "claim_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "facet_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "state": {"const": "FAILED"}
  }
}
