{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "memory.graph"},
        "generation_id": {"$ref": "#/$defs/id"}
      }
    },
    "input": {"$ref": "#/$defs/memory"},
    "prior": {
      "type": "object", "additionalProperties": false,
      "required": ["effect", "budget"],
      "properties": {
        "effect": {"type": "object"},
        "budget": {"type": "object"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "claim_id", "attempt_id", "effect_operation_id", "abandonment_operation_id", "reservation_id", "reason_code"],
      "properties": {
        "protocol": {"const": "forest.memory-embedding-abandon/1"},
        "claim_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "effect_operation_id": {"$ref": "#/$defs/id"},
        "abandonment_operation_id": {"$ref": "#/$defs/id"},
        "reservation_id": {"$ref": "#/$defs/id"},
        "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}
      }
    }
  }
}
