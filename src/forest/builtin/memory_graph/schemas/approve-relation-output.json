{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "relation_id", "contribution_id", "approved_at"],
  "properties": {
    "protocol": {"const": "forest.memory-relation-approval/1"},
    "relation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "contribution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "approved_at": {"type": "string", "format": "date-time"}
  }
}
