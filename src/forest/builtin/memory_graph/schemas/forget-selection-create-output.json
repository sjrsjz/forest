{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "selection_id", "member_count", "member_digest",
    "snapshot_xid", "snapshot_accepted_at"],
  "properties": {
    "protocol": {"const": "forest.memory-forget-selection/1"},
    "selection_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "member_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "member_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "snapshot_xid": {"type": "string", "minLength": 3, "maxLength": 65536},
    "snapshot_accepted_at": {"type": "string", "format": "date-time"}
  }
}
