{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["attempt_id", "expected_facet_ids", "acknowledge_possible_duplicate_charge", "requested_by"],
  "properties": {
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "expected_facet_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "acknowledge_possible_duplicate_charge": {"const": true},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
