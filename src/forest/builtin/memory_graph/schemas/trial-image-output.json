{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "query_id", "source_unit_id", "part_id", "media_type", "width", "height", "digest", "offset", "byte_length", "eof", "data_base64"],
  "properties": {
    "protocol": {"const": "forest.memory-trial-image-chunk/1"},
    "query_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "part_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "media_type": {"enum": ["image/png", "image/jpeg", "image/webp"]},
    "width": {"type": "integer", "minimum": 1, "maximum": 100000},
    "height": {"type": "integer", "minimum": 1, "maximum": 100000},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "offset": {"type": "integer", "minimum": 0, "maximum": 33554432},
    "byte_length": {"type": "integer", "minimum": 1, "maximum": 33554432},
    "eof": {"type": "boolean"},
    "data_base64": {"type": "string", "minLength": 4, "maxLength": 131072,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
  }
}
