{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "query_id", "source_unit_id", "part_id", "media_type", "width", "height", "data_base64"],
  "properties": {
    "protocol": {"const": "forest.memory-trial-image/1"},
    "query_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "part_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "media_type": {"const": "image/jpeg"},
    "width": {"type": "integer", "minimum": 1, "maximum": 1024},
    "height": {"type": "integer", "minimum": 1, "maximum": 1024},
    "data_base64": {"type": "string", "minLength": 4, "maxLength": 131072,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
  }
}
