{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "attempt_id", "claim_id", "purpose", "attempt_state", "effect_operation_id", "executor_generation_id", "dispatched_at", "settled_at", "budget_day", "reservation_state", "reserved_tokens", "charged_tokens", "retry_operation_id", "retry_requested_by", "retry_created_at", "item_count", "items"],
  "properties": {
    "protocol": {"const": "forest.memory-embedding-attempt/1"},
    "attempt_id": {"type": "string"},
    "claim_id": {"type": "string"},
    "purpose": {"enum": ["DOCUMENT", "QUERY"]},
    "attempt_state": {"enum": ["PREPARED", "DISPATCHED", "SUCCEEDED", "NOT_SENT", "UNKNOWN", "FAILED"]},
    "effect_operation_id": {"type": "string"},
    "executor_generation_id": {"type": "string"},
    "dispatched_at": {"type": ["string", "null"], "format": "date-time"},
    "settled_at": {"type": ["string", "null"], "format": "date-time"},
    "budget_day": {"type": ["string", "null"], "format": "date"},
    "reservation_state": {"type": ["string", "null"]},
    "reserved_tokens": {"type": ["integer", "null"], "minimum": 1},
    "charged_tokens": {"type": ["integer", "null"], "minimum": 0},
    "retry_operation_id": {"type": ["string", "null"]},
    "retry_requested_by": {"type": ["string", "null"]},
    "retry_created_at": {"type": ["string", "null"], "format": "date-time"},
    "item_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "items": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["item_index", "facet_id", "modality", "state", "current_attempt_id", "retry_eligible", "source_unit_id", "source_revision", "trunk_id", "external_group_id", "author_subject_ref"],
      "properties": {
        "item_index": {"type": "integer", "minimum": 0, "maximum": 31},
        "facet_id": {"type": "string"},
        "modality": {"enum": ["TEXT", "IMAGE"]},
        "state": {"enum": ["PENDING", "PREPARED", "DISPATCHED", "EMBEDDED", "READY", "UNKNOWN", "FAILED", "SUPPRESSED"]},
        "current_attempt_id": {"type": ["string", "null"]},
        "retry_eligible": {"type": "boolean"},
        "source_unit_id": {"type": ["string", "null"]},
        "source_revision": {"type": ["integer", "null"], "minimum": 1},
        "trunk_id": {"type": ["string", "null"]},
        "external_group_id": {"type": ["string", "null"]},
        "author_subject_ref": {"type": ["string", "null"]}
      }
    }}
  }
}
