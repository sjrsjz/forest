{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "space_id",
    "index_snapshot_at",
    "facets",
    "next_facet_id",
    "has_more"
  ],
  "properties": {
    "space_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "index_snapshot_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "facets": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_id",
          "modality"
        ],
        "properties": {
          "ref_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "modality": {
            "enum": [
              "TEXT",
              "IMAGE"
            ]
          }
        }
      }
    },
    "next_facet_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "has_more": {
      "type": "boolean"
    }
  }
}
