{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "caller",
    "input",
    "prior"
  ],
  "properties": {
    "protocol": {
      "const": "forest.uow-step/1"
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "generation_id"
      ],
      "properties": {
        "component_id": {
          "const": "memory.graph"
        },
        "generation_id": {
          "type": "string"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "query_id",
        "deadline_at"
      ],
      "properties": {
        "protocol": {
          "const": "forest.memory-recall-request/1"
        },
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time",
          "minLength": 20,
          "maxLength": 64
        }
      }
    },
    "prior": {
      "type": "object"
    }
  }
}
