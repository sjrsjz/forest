{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidates"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_id",
          "candidate_rank",
          "score",
          "source_unit_id",
          "source_revision",
          "source_id",
          "trunk_id",
          "source_kind",
          "platform",
          "realm_id",
          "external_group_id",
          "author_subject_ref"
        ],
        "properties": {
          "ref_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "candidate_rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "score": {
            "type": "number"
          },
          "source_unit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_revision": {
            "type": "integer",
            "minimum": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "trunk_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "source_kind": {
            "enum": [
              "GROUP",
              "DIRECT",
              "DOCUMENT",
              "SYSTEM",
              "UNKNOWN"
            ]
          },
          "platform": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "realm_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "external_group_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "author_subject_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  }
}
