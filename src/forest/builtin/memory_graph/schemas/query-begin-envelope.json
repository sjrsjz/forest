{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "caller",
    "input",
    "prior"
  ],
  "properties": {
    "protocol": {
      "const": "forest.uow-step/1"
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "generation_id"
      ],
      "properties": {
        "component_id": {
          "const": "memory.graph"
        },
        "generation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "conversation_ref",
        "input_batch_ref",
        "context_revision",
        "protocol",
        "deletion_epoch_step_id"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "conversation_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "input_batch_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "context_revision": {
          "type": "integer",
          "minimum": 1
        },
        "protocol": {
          "const": "forest.memory-query-begin/1"
        },
        "deletion_epoch_step_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "prior": {
      "type": "object"
    }
  }
}
