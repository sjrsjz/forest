{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "claim_id", "attempt_id", "state"],
  "properties": {
    "protocol": {"const": "forest.memory-embedding-abandoned/1"},
    "claim_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "state": {"const": "NOT_SENT"}
  }
}
