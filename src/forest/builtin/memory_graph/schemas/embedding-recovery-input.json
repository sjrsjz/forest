{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["mode", "claim_id", "attempt_id", "effect_operation_id", "reservation_id"],
  "properties": {
    "mode": {"enum": ["ABANDON", "OBSERVE_UNKNOWN"]},
    "claim_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "effect_operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "reservation_id": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
