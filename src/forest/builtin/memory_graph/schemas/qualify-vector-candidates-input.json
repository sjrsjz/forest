{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "query_facet_id",
    "candidates"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "query_facet_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_id",
          "candidate_rank",
          "score"
        ],
        "properties": {
          "ref_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "candidate_rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "score": {
            "type": "number"
          }
        }
      }
    }
  }
}
