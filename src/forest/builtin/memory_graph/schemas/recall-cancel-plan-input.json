{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory"
  ],
  "properties": {
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "query_id",
        "reason_code"
      ],
      "properties": {
        "protocol": {
          "const": "forest.memory-recall-cancel/1"
        },
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason_code": {
          "const": "SUPERSEDED"
        }
      }
    }
  }
}
