{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "available",
    "refs",
    "next_source_unit_id",
    "has_more"
  ],
  "properties": {
    "available": {
      "type": "boolean"
    },
    "refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_unit_id",
          "payload"
        ],
        "properties": {
          "source_unit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "payload_id",
              "digest",
              "owner_component_id",
              "owner_kind",
              "owner_id"
            ],
            "properties": {
              "payload_id": {
                "$ref": "#/$defs/id"
              },
              "digest": {
                "$ref": "#/$defs/digest"
              },
              "owner_component_id": {
                "$ref": "#/$defs/id"
              },
              "owner_kind": {
                "$ref": "#/$defs/id"
              },
              "owner_id": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    },
    "next_source_unit_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "has_more": {
      "type": "boolean"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
