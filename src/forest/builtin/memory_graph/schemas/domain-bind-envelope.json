{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "caller", "input", "prior"],
  "properties": {
    "protocol": {"const": "forest.uow-step/1"},
    "caller": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "generation_id"],
      "properties": {
        "component_id": {"const": "memory.graph"},
        "generation_id": {"type": "string"}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "space_id", "embedding_model_kind", "model_revision_digest", "dimensions", "max_batch_items", "normalization", "fusion_policy_revision"],
      "properties": {
        "protocol": {"const": "forest.memory-domain-bind/1"},
        "space_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "embedding_model_kind": {"const": "TEXT_IMAGE"},
        "model_revision_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "dimensions": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_batch_items": {"type": "integer", "minimum": 1, "maximum": 32},
        "normalization": {"const": "L2"},
        "fusion_policy_revision": {"const": "independent-facets/1"}
      }
    },
    "prior": {"type": "object"}
  }
}
