{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "source_unit_id"],
  "properties": {
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "plan": {"type": "object", "required": ["protocol", "plan_digest"],
      "properties": {
        "protocol": {"const": "forest.memory-forget-impact-plan/1"},
        "plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }}
  }
}
