{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "snapshot_created_at", "snapshot_xid", "filter_digest", "items", "has_more", "next_cursor"],
  "properties": {
    "protocol": {"const": "forest.memory-relation-retractions/1"},
    "snapshot_created_at": {"type": "string", "format": "date-time"},
    "snapshot_xid": {"type": "string", "minLength": 3, "maxLength": 65536},
    "filter_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "items": {"type": "array", "maxItems": 50, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "relation_id", "contribution_id", "actor_subject_ref", "reason_code", "retracted_at", "relation_kind", "origin_kind", "left_kind", "left_id", "right_kind", "right_id", "cross_trunk", "weight_micros", "evidence_count"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/id"},
        "relation_id": {"$ref": "#/$defs/id"},
        "contribution_id": {"$ref": "#/$defs/id"},
        "actor_subject_ref": {"$ref": "#/$defs/id"},
        "reason_code": {"enum": ["INCORRECT", "STALE", "UNSAFE", "OTHER"]},
        "retracted_at": {"type": "string", "format": "date-time"},
        "relation_kind": {"enum": ["ASSOCIATES_WITH", "EVIDENCE", "CONTRADICTS", "SUBJECT_OF"]},
        "origin_kind": {"enum": ["MANUAL", "VECTOR", "RULE", "MODEL"]},
        "left_kind": {"enum": ["SOURCE_UNIT", "ASSERTION", "ENTITY", "ARTIFACT"]},
        "left_id": {"$ref": "#/$defs/id"},
        "right_kind": {"enum": ["SOURCE_UNIT", "ASSERTION", "ENTITY", "ARTIFACT"]},
        "right_id": {"$ref": "#/$defs/id"},
        "cross_trunk": {"type": "boolean"},
        "weight_micros": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "evidence_count": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    }},
    "has_more": {"type": "boolean"},
    "next_cursor": {"oneOf": [
      {"type": "null"},
      {"type": "object", "additionalProperties": false,
       "required": ["created_at", "operation_id"],
       "properties": {"created_at": {"type": "string", "format": "date-time"},
                      "operation_id": {"$ref": "#/$defs/id"}}}
    ]}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 256}}
}
