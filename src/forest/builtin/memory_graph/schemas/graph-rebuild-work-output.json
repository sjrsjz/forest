{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation_id",
    "replayed_through",
    "published"
  ],
  "properties": {
    "generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "replayed_through": {
      "type": "integer",
      "minimum": 0
    },
    "published": {
      "type": "boolean"
    }
  }
}
