{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "query_id",
    "space_id",
    "policy_revision",
    "nodes",
    "read_count",
    "truncated",
    "truncation_reason",
    "association_sampled"
  ],
  "properties": {
    "protocol": {
      "const": "forest.memory-query-region/2"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "nodes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_unit_id",
          "source_revision",
          "source_id",
          "trunk_id",
          "source_kind",
          "platform",
          "realm_id",
          "external_group_id",
          "author_subject_ref",
          "activation",
          "rank_score",
          "is_seed",
          "path_parent_source_unit_id",
          "path_edge_id"
        ],
        "properties": {
          "source_unit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_revision": {
            "type": "integer",
            "minimum": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "trunk_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "source_kind": {
            "enum": [
              "GROUP",
              "DIRECT",
              "DOCUMENT",
              "SYSTEM",
              "UNKNOWN"
            ]
          },
          "platform": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "realm_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "external_group_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "author_subject_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "activation": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "rank_score": {
            "type": "number",
            "minimum": 0
          },
          "is_seed": {
            "type": "boolean"
          },
          "path_parent_source_unit_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "path_edge_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "read_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "truncated": {
      "type": "boolean"
    },
    "truncation_reason": {"enum": ["SEED_LIMIT", "NODE_LIMIT", "SEED_AND_NODE_LIMIT", null]},
    "association_sampled": {
      "type": "boolean"
    }
  }
}
