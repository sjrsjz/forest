{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "query_id",
    "item_index",
    "available",
    "page"
  ],
  "properties": {
    "protocol": {
      "const": "forest.memory-trial-association-evidence/1"
    },
    "query_id": {
      "$ref": "#/$defs/id"
    },
    "item_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "available": {
      "type": "boolean"
    },
    "page": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation_id",
            "contribution_id",
            "snapshot_xid",
            "total_count",
            "items",
            "has_more",
            "next_after"
          ],
          "properties": {
            "relation_id": {
              "$ref": "#/$defs/id"
            },
            "contribution_id": {
              "$ref": "#/$defs/id"
            },
            "snapshot_xid": {
              "type": "string",
              "minLength": 3,
              "maxLength": 65536
            },
            "total_count": {
              "type": "integer",
              "minimum": 0
            },
            "items": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "journal_id",
                  "reply_ref",
                  "query_id",
                  "trigger_ref",
                  "seed_rank_score",
                  "promoted_at",
                  "trigger_evidence",
                  "seed_evidence"
                ],
                "properties": {
                  "journal_id": {
                    "$ref": "#/$defs/id"
                  },
                  "reply_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "query_id": {
                    "$ref": "#/$defs/id"
                  },
                  "trigger_ref": {
                    "$ref": "#/$defs/id"
                  },
                  "seed_rank_score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 256
                  },
                  "promoted_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "trigger_evidence": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_unit_id",
                      "source_revision",
                      "part_id",
                      "source_id",
                      "source_kind",
                      "platform",
                      "realm_id",
                      "external_group_id",
                      "trunk_id",
                      "author_subject_ref"
                    ],
                    "properties": {
                      "source_unit_id": {
                        "$ref": "#/$defs/id"
                      },
                      "source_revision": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "part_id": {
                        "$ref": "#/$defs/id"
                      },
                      "source_id": {
                        "$ref": "#/$defs/id"
                      },
                      "source_kind": {
                        "type": "string"
                      },
                      "platform": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "realm_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "external_group_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "trunk_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "author_subject_ref": {
                        "$ref": "#/$defs/id"
                      }
                    }
                  },
                  "seed_evidence": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_unit_id",
                      "source_revision",
                      "part_id",
                      "source_id",
                      "source_kind",
                      "platform",
                      "realm_id",
                      "external_group_id",
                      "trunk_id",
                      "author_subject_ref"
                    ],
                    "properties": {
                      "source_unit_id": {
                        "$ref": "#/$defs/id"
                      },
                      "source_revision": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "part_id": {
                        "$ref": "#/$defs/id"
                      },
                      "source_id": {
                        "$ref": "#/$defs/id"
                      },
                      "source_kind": {
                        "type": "string"
                      },
                      "platform": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "realm_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "external_group_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "trunk_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "author_subject_ref": {
                        "$ref": "#/$defs/id"
                      }
                    }
                  }
                }
              }
            },
            "has_more": {
              "type": "boolean"
            },
            "next_after": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "available": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "page": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "page": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
