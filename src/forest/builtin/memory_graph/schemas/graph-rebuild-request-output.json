{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "generation_id",
    "state"
  ],
  "properties": {
    "protocol": {
      "const": "forest.memory-graph-rebuild-enqueued/1"
    },
    "generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "type": "string",
      "enum": [
        "QUEUED",
        "CLAIMED",
        "SUCCEEDED",
        "FAILED"
      ]
    }
  }
}
