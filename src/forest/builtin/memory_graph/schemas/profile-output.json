{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "component_id", "generation_id", "profile_digest", "embedding", "fusion_policy_revision", "retrieval"],
  "properties": {
    "protocol": {"const": "forest.memory-profile/2"},
    "component_id": {"const": "memory.graph"},
    "generation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "profile_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "embedding": {"$ref": "#/$defs/embedding"},
    "fusion_policy_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "retrieval": {"$ref": "#/$defs/retrieval"}
  },
  "$defs": {
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_kind", "deployment_id", "model_revision", "model", "dimensions", "normalization"],
      "properties": {
        "model_kind": {"const": "TEXT_IMAGE"},
        "deployment_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "model_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "dimensions": {"type": "integer", "minimum": 1, "maximum": 4096},
        "normalization": {"enum": ["L2", "NONE"]}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_revision", "seed_limit", "candidate_limit_per_facet", "min_similarity", "min_graph_relevance", "max_graph_nodes", "max_association_edges_per_node", "max_retrieval_chars", "max_retrieval_media_bytes", "sequence_weight", "association_weight"],
      "properties": {
        "policy_revision": {"const": "qiyu-graph-region/2"},
        "seed_limit": {"type": "integer", "minimum": 1, "maximum": 64},
        "candidate_limit_per_facet": {"type": "integer", "minimum": 1, "maximum": 256},
        "min_similarity": {"type": "number", "minimum": -1, "maximum": 1},
        "min_graph_relevance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_graph_nodes": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_association_edges_per_node": {"type": "integer", "minimum": 1, "maximum": 128},
        "max_retrieval_chars": {"type": "integer", "minimum": 256, "maximum": 1000000},
        "max_retrieval_media_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "sequence_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "association_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    }
  }
}
