{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "deadline_at"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 64
    }
  }
}
