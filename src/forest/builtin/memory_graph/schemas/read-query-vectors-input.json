{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "after_facet_id",
    "limit"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "after_facet_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    }
  }
}
