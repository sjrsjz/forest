{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "source_unit_id", "deletion_epoch", "suppressed_source_units", "vector_deletions", "retracted_relations"],
  "properties": {
    "protocol": {"const": "forest.memory-source-forgotten/1"},
    "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "deletion_epoch": {"type": "integer", "minimum": 1},
    "suppressed_source_units": {"type": "integer", "minimum": 0},
    "vector_deletions": {"type": "integer", "minimum": 0},
    "retracted_relations": {"type": "integer", "minimum": 0}
  }
}
