{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["snapshot_xid", "items", "has_more", "next_cursor", "filter_digest"],
  "properties": {
    "snapshot_xid": {"type": "string", "minLength": 3, "maxLength": 65536},
    "items": {"type": "array", "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["relation_id", "contribution_id", "relation_kind", "relation_key", "left_kind", "left_id", "right_kind", "right_id", "weight_micros", "origin_kind", "created_at", "cross_trunk", "direction", "review_state", "reviewed_by", "reviewed_at", "evidence_count", "association_evidence_count", "evidence"],
      "properties": {
        "relation_id": {"$ref": "#/$defs/id"},
        "contribution_id": {"$ref": "#/$defs/id"},
        "relation_kind": {"enum": ["ASSOCIATES_WITH", "EVIDENCE", "CONTRADICTS", "SUBJECT_OF"]},
        "relation_key": {"type": "string", "maxLength": 256},
        "left_kind": {"$ref": "#/$defs/kind"}, "left_id": {"$ref": "#/$defs/id"},
        "right_kind": {"$ref": "#/$defs/kind"}, "right_id": {"$ref": "#/$defs/id"},
        "weight_micros": {"type": "integer", "minimum": 0},
        "origin_kind": {"enum": ["MANUAL", "VECTOR", "RULE", "MODEL"]},
        "review_state": {"enum": ["UNREVIEWED", "APPROVED"]},
        "reviewed_by": {"type": ["string", "null"], "maxLength": 256},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "created_at": {"type": "string", "format": "date-time"},
        "cross_trunk": {"type": "boolean"},
        "direction": {"enum": ["OUTBOUND", "INBOUND", "UNDIRECTED", "CANONICAL"]},
        "evidence_count": {"type": "integer", "minimum": 0},
        "association_evidence_count": {"type": "integer", "minimum": 0},
        "evidence": {"type": "array", "maxItems": 16, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["source_unit_id", "source_revision", "part_id", "trunk_id", "source_id", "source_kind", "platform", "realm_id", "external_group_id", "author_subject_ref"],
          "properties": {
            "source_unit_id": {"$ref": "#/$defs/id"},
            "source_revision": {"type": "integer", "minimum": 1},
            "part_id": {"$ref": "#/$defs/id"},
            "trunk_id": {"type": ["string", "null"]},
            "source_id": {"$ref": "#/$defs/id"},
            "source_kind": {"type": "string"},
            "platform": {"type": ["string", "null"]},
            "realm_id": {"type": ["string", "null"]},
            "external_group_id": {"type": ["string", "null"]},
            "author_subject_ref": {"$ref": "#/$defs/id"}
          }
        }}
      }
    }},
    "has_more": {"type": "boolean"},
    "next_cursor": {"type": ["object", "null"], "additionalProperties": false,
      "required": ["relation_id", "contribution_id"],
      "properties": {"relation_id": {"$ref": "#/$defs/id"}, "contribution_id": {"$ref": "#/$defs/id"}}},
    "filter_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "kind": {"enum": ["SOURCE_UNIT", "ASSERTION", "ENTITY", "ARTIFACT"]}
  }
}
