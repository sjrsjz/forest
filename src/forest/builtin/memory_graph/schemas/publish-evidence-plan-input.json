{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_epoch",
    "memory"
  ],
  "properties": {
    "payload_epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol"
      ],
      "properties": {
        "protocol": {
          "const": "forest.payload-epoch-capture/1"
        }
      }
    },
    "memory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "query_id",
        "evidence_ref",
        "item_indexes",
        "missing_count",
        "content_truncated",
        "deletion_epoch_step_id"
      ],
      "properties": {
        "protocol": {
          "const": "forest.memory-evidence-publish/1"
        },
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payload_id",
            "digest",
            "owner_component_id",
            "owner_kind",
            "owner_id"
          ],
          "properties": {
            "payload_id": {
              "$ref": "#/$defs/id"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "owner_component_id": {
              "$ref": "#/$defs/id"
            },
            "owner_kind": {
              "$ref": "#/$defs/id"
            },
            "owner_id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "item_indexes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "content_truncated": {
          "type": "boolean"
        },
        "deletion_epoch_step_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
