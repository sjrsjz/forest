{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "selection_id", "member_count", "member_digest",
    "snapshot_xid", "snapshot_accepted_at", "filters", "items", "has_more"],
  "properties": {
    "protocol": {"const": "forest.memory-forget-selection-page/1"},
    "selection_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "member_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "member_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "snapshot_xid": {"type": "string", "minLength": 3, "maxLength": 65536},
    "snapshot_accepted_at": {"type": "string", "format": "date-time"},
    "filters": {"type": "object"},
    "items": {"type": "array", "maxItems": 100,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["ordinal", "source_unit_id", "source_revision", "anchor_payload_id",
          "forget_state", "forget_operation_id"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "source_revision": {"type": "integer", "minimum": 1},
          "anchor_payload_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "forget_state": {"enum": ["ACTIVE", "FORGOTTEN_BY_SELECTION",
            "SUPPRESSED_EXTERNALLY"]},
          "forget_operation_id": {"type": ["string", "null"], "minLength": 1,
            "maxLength": 256}
        }
      }
    },
    "has_more": {"type": "boolean"}
  }
}
