{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "query_id",
    "phase",
    "facet_count",
    "ready_count",
    "unknown_count",
    "failed_count",
    "matched_count",
    "evidence_ref"
  ],
  "properties": {
    "protocol": {
      "const": "forest.memory-query-progress/1"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "phase": {
      "enum": [
        "NEED_PREPARATION",
        "WAIT_EMBEDDING",
        "BLOCKED_UNKNOWN",
        "FAILED",
        "NEED_MATCHING",
        "NEED_FREEZING",
        "NEED_MATERIALIZATION",
        "READY"
      ]
    },
    "facet_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "ready_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "unknown_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "failed_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "matched_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "evidence_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payload_id",
            "digest",
            "owner_component_id",
            "owner_kind",
            "owner_id"
          ],
          "properties": {
            "payload_id": {
              "$ref": "#/$defs/id"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "owner_component_id": {
              "$ref": "#/$defs/id"
            },
            "owner_kind": {
              "$ref": "#/$defs/id"
            },
            "owner_id": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_ref": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "evidence_ref": {
            "type": "null"
          }
        }
      }
    }
  ]
}
