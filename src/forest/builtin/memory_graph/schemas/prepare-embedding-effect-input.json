{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["payload_epoch", "budget", "authorization", "effect", "memory"],
  "properties": {
    "payload_epoch": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol"],
      "properties": {"protocol": {"const": "forest.payload-epoch-capture/1"}}
    },
    "budget": {"type": "object"},
    "authorization": {"type": "object"},
    "effect": {"type": "object"},
    "memory": {"$ref": "#/$defs/memory"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "claim_id", "attempt_id", "effect_operation_id", "reservation_id", "space_id"],
      "properties": {
        "protocol": {"const": "forest.memory-embedding-attempt-prepare/1"},
        "claim_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "effect_operation_id": {"$ref": "#/$defs/id"},
        "reservation_id": {"$ref": "#/$defs/id"},
        "space_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
