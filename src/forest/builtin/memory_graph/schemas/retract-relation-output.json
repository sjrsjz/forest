{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "relation_id", "contribution_id", "reason_code", "retracted_at"],
  "properties": {
    "protocol": {"const": "forest.memory-relation-retraction/1"},
    "relation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "contribution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "reason_code": {"enum": ["INCORRECT", "STALE", "UNSAFE", "OTHER"]},
    "retracted_at": {"type": "string", "format": "date-time"}
  }
}
