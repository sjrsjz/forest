{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["source_unit_id", "source_revision", "space_id"],
  "properties": {
    "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_revision": {"type": "integer", "minimum": 1},
    "space_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
