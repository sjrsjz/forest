{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["snapshot_xid", "nodes", "edges", "pages_read", "truncated", "truncation_reason"],
  "properties": {
    "snapshot_xid": {"type": "string", "minLength": 3, "maxLength": 65536},
    "nodes": {"type": "array", "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "depth"],
      "properties": {
        "kind": {"$ref": "#/$defs/kind"},
        "id": {"$ref": "#/$defs/id"},
        "depth": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    }},
    "edges": {"type": "array", "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["relation_id", "contribution_id", "relation_kind", "relation_key",
        "left_kind", "left_id", "right_kind", "right_id", "weight_micros",
        "origin_kind", "created_at", "cross_trunk", "direction", "evidence_count",
        "evidence", "traversal_depth", "from_kind", "from_id"],
      "properties": {
        "relation_id": {"$ref": "#/$defs/id"},
        "contribution_id": {"$ref": "#/$defs/id"},
        "relation_kind": {"enum": ["ASSOCIATES_WITH", "EVIDENCE", "CONTRADICTS", "SUBJECT_OF"]},
        "relation_key": {"type": "string", "maxLength": 256},
        "left_kind": {"$ref": "#/$defs/kind"}, "left_id": {"$ref": "#/$defs/id"},
        "right_kind": {"$ref": "#/$defs/kind"}, "right_id": {"$ref": "#/$defs/id"},
        "weight_micros": {"type": "integer", "minimum": 0},
        "origin_kind": {"enum": ["MANUAL", "VECTOR", "RULE", "MODEL"]},
        "created_at": {"type": "string", "format": "date-time"},
        "cross_trunk": {"type": "boolean"},
        "direction": {"enum": ["OUTBOUND", "INBOUND", "UNDIRECTED"]},
        "evidence_count": {"type": "integer", "minimum": 0},
        "evidence": {"type": "array", "maxItems": 4, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["source_unit_id", "source_revision", "part_id", "trunk_id",
            "source_id", "source_kind", "platform", "realm_id", "external_group_id",
            "author_subject_ref"],
          "properties": {
            "source_unit_id": {"$ref": "#/$defs/id"},
            "source_revision": {"type": "integer", "minimum": 1},
            "part_id": {"$ref": "#/$defs/id"},
            "trunk_id": {"type": ["string", "null"]},
            "source_id": {"$ref": "#/$defs/id"},
            "source_kind": {"type": "string"},
            "platform": {"type": ["string", "null"]},
            "realm_id": {"type": ["string", "null"]},
            "external_group_id": {"type": ["string", "null"]},
            "author_subject_ref": {"$ref": "#/$defs/id"}
          }
        }},
        "traversal_depth": {"type": "integer", "minimum": 1, "maximum": 3},
        "from_kind": {"$ref": "#/$defs/kind"},
        "from_id": {"$ref": "#/$defs/id"}
      }
    }},
    "pages_read": {"type": "integer", "minimum": 0, "maximum": 64},
    "truncated": {"type": "boolean"},
    "truncation_reason": {"enum": ["EDGE_LIMIT", "NODE_LIMIT", "PAGE_LIMIT", "DEADLINE", null]}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "kind": {"enum": ["SOURCE_UNIT", "ASSERTION", "ENTITY", "ARTIFACT"]}
  }
}
