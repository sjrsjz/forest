{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "bundle_id",
    "item_index",
    "result_count",
    "node",
    "parts",
    "last_part_index",
    "has_more"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "item_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "result_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "node": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_unit_id",
            "source_revision",
            "source_id",
            "trunk_id",
            "source_kind",
            "platform",
            "realm_id",
            "external_group_id",
            "author_subject_ref",
            "activation",
            "rank_score",
            "is_seed",
            "path_parent_source_unit_id",
            "path_edge_id",
            "occurred_at",
            "source_order_seq",
            "unit_kind",
            "part_count",
            "is_current_source",
            "matched_part_ids",
            "author_payload"
          ],
          "properties": {
            "source_unit_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "source_revision": {
              "type": "integer",
              "minimum": 1
            },
            "source_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "trunk_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "source_kind": {
              "enum": [
                "GROUP",
                "DIRECT",
                "DOCUMENT",
                "SYSTEM",
                "UNKNOWN"
              ]
            },
            "platform": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "realm_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "external_group_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "author_subject_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "activation": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "rank_score": {
              "type": "number",
              "minimum": 0
            },
            "is_seed": {
              "type": "boolean"
            },
            "path_parent_source_unit_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "path_edge_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "occurred_at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "source_order_seq": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "unit_kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "part_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "is_current_source": {
              "type": "boolean"
            },
            "matched_part_ids": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 256,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "author_payload": {
              "$ref": "#/$defs/payload"
            }
          }
        }
      ]
    },
    "parts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "last_part_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4095
    },
    "has_more": {
      "type": "boolean"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_id",
        "digest",
        "owner_component_id",
        "owner_kind",
        "owner_id"
      ],
      "properties": {
        "payload_id": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "owner_component_id": {
          "$ref": "#/$defs/id"
        },
        "owner_kind": {
          "$ref": "#/$defs/id"
        },
        "owner_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_id",
        "part_index",
        "part_kind",
        "media_type",
        "byte_length",
        "payload",
        "width",
        "height"
      ],
      "properties": {
        "part_id": {
          "$ref": "#/$defs/id"
        },
        "part_index": {
          "type": "integer",
          "minimum": 0
        },
        "part_kind": {
          "enum": [
            "TEXT",
            "IMAGE"
          ]
        },
        "media_type": {
          "$ref": "#/$defs/id"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
