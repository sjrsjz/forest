{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "source_id",
    "source_unit_id",
    "source_order_seq"
  ],
  "properties": {
    "protocol": {
      "const": "forest.memory-source-position/1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_unit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_order_seq": {
      "type": "integer",
      "minimum": 1
    }
  }
}
