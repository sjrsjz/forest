{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_epoch",
    "memory"
  ],
  "properties": {
    "payload_epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol"
      ],
      "properties": {
        "protocol": {
          "const": "forest.payload-epoch-capture/1"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "query_id",
        "deletion_epoch_step_id",
        "query_ref_id",
        "candidates"
      ],
      "properties": {
        "protocol": {
          "const": "forest.memory-query-matches/1"
        },
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "deletion_epoch_step_id": {
          "const": "payload_epoch"
        },
        "query_ref_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "candidates": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref_id",
              "candidate_rank",
              "score"
            ],
            "properties": {
              "ref_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "candidate_rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
              },
              "score": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
