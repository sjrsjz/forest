{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "relation_kinds": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["ASSOCIATES_WITH", "EVIDENCE", "CONTRADICTS", "SUBJECT_OF"]}},
    "origin_kinds": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["MANUAL", "VECTOR", "RULE", "MODEL"]}},
    "review_states": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": {"enum": ["UNREVIEWED", "APPROVED"]}},
    "cross_trunk": {"type": "boolean"},
    "evidence_trunk_id": {"$ref": "#/$defs/id"},
    "evidence_external_group_id": {"$ref": "#/$defs/id"},
    "evidence_author_subject_ref": {"$ref": "#/$defs/id"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 20},
    "snapshot_xid": {"type": "string", "minLength": 3, "maxLength": 65536},
    "after_relation_id": {"$ref": "#/$defs/id"},
    "after_contribution_id": {"$ref": "#/$defs/id"},
    "cursor_filter_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "dependentRequired": {
    "after_relation_id": ["after_contribution_id", "snapshot_xid", "cursor_filter_digest"],
    "after_contribution_id": ["after_relation_id", "snapshot_xid", "cursor_filter_digest"]
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 256}}
}
