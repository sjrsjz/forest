{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["disposition", "facet_count", "error_code"],
  "properties": {
    "disposition": {"enum": ["READY", "SUPPRESSED", "FAILED"]},
    "facet_count": {"type": "integer", "minimum": 0, "maximum": 4096},
    "error_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}
  }
}
