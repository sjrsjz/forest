{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "space_id",
    "candidate_revision",
    "collection_id",
    "collection_name",
    "audit_seq",
    "after_ref",
    "limit",
    "expected"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidate_revision": {
      "type": "integer",
      "minimum": 2
    },
    "collection_id": {
      "type": "integer",
      "minimum": 1
    },
    "collection_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "audit_seq": {
      "type": "integer",
      "minimum": 0
    },
    "after_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "limit": {
      "const": 64
    },
    "expected": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_id",
          "bot_id",
          "space_id",
          "purpose",
          "input_digest",
          "physical_digest"
        ],
        "properties": {
          "ref_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "bot_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "space_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "physical_digest": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
