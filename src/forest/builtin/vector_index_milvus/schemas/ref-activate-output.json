{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ref_id",
    "space_id",
    "state"
  ],
  "properties": {
    "ref_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "const": "ACTIVE"
    }
  }
}
