{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "space_id",
    "binding_revision",
    "collection_id",
    "cycle_seq",
    "observations",
    "claim_token"
  ],
  "properties": {
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "binding_revision": {
      "type": "integer",
      "minimum": 1
    },
    "collection_id": {
      "type": "integer",
      "minimum": 1
    },
    "cycle_seq": {
      "type": "integer",
      "minimum": 0
    },
    "observations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_id",
          "physical"
        ],
        "properties": {
          "ref_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "physical": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref_id",
                  "bot_id",
                  "space_id",
                  "purpose",
                  "input_digest",
                  "physical_digest"
                ],
                "properties": {
                  "ref_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "bot_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "space_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "purpose": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "input_digest": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "physical_digest": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "claim_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
