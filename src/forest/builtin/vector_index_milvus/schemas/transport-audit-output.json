{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "space_id",
    "mode",
    "rows",
    "next_ref",
    "done"
  ],
  "properties": {
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mode": {
      "enum": [
        "GET",
        "SCAN"
      ]
    },
    "rows": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_id",
          "bot_id",
          "space_id",
          "purpose",
          "input_digest",
          "physical_digest"
        ],
        "properties": {
          "ref_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "bot_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "space_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "physical_digest": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "next_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "done": {
      "type": "boolean"
    }
  }
}
