{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "space_id",
    "candidate_revision",
    "collection_id",
    "collection_name",
    "after_seq",
    "next_seq",
    "changes"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidate_revision": {
      "type": "integer",
      "minimum": 2
    },
    "collection_id": {
      "type": "integer",
      "minimum": 1
    },
    "collection_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "after_seq": {
      "type": "integer",
      "minimum": 0
    },
    "next_seq": {
      "type": "integer",
      "minimum": 1
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mutation_seq",
          "ref_id",
          "space_id",
          "state",
          "purpose",
          "input_digest",
          "replay_locator",
          "vector_digest",
          "physical_digest"
        ],
        "properties": {
          "mutation_seq": {
            "type": "integer",
            "minimum": 1
          },
          "ref_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "space_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "state": {
            "enum": [
              "ACTIVE",
              "TOMBSTONED"
            ]
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "replay_locator": {
            "type": [
              "object",
              "null"
            ]
          },
          "vector_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "physical_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^f32-sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
