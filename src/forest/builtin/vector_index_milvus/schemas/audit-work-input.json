{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "space_id",
    "binding_revision",
    "collection_id",
    "phase",
    "after_ref",
    "limit",
    "cycle_seq",
    "refs",
    "claim_token",
    "collection_name"
  ],
  "properties": {
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "binding_revision": {
      "type": "integer",
      "minimum": 1
    },
    "collection_id": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "REF",
        "PHYSICAL"
      ]
    },
    "after_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "limit": {
      "const": 64
    },
    "cycle_seq": {
      "type": "integer",
      "minimum": 0
    },
    "refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "claim_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "collection_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
