{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding",
    "health_state",
    "health_reason",
    "ref_seq",
    "active_rebuild",
    "retirement_pending",
    "retirement_blocked",
    "unconfirmed_attempts"
  ],
  "properties": {
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binding_revision",
            "collection_name",
            "collection_id",
            "space_id",
            "dimensions"
          ],
          "properties": {
            "binding_revision": {
              "type": "integer",
              "minimum": 1
            },
            "collection_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "collection_id": {
              "type": "integer",
              "minimum": 1
            },
            "space_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "dimensions": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "health_state": {
      "enum": [
        "READY",
        "REBUILD_REQUIRED",
        null
      ]
    },
    "health_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "ref_seq": {
      "type": "integer",
      "minimum": 0
    },
    "active_rebuild": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id",
            "state",
            "created_at"
          ],
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "retirement_pending": {
      "type": "integer",
      "minimum": 0
    },
    "retirement_blocked": {
      "type": "integer",
      "minimum": 0
    },
    "unconfirmed_attempts": {
      "type": "integer",
      "minimum": 0
    }
  }
}
