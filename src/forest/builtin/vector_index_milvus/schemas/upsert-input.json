{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ref_id",
    "space_id",
    "purpose",
    "vector",
    "replay"
  ],
  "properties": {
    "ref_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "purpose": {
      "enum": [
        "DOCUMENT",
        "QUERY"
      ]
    },
    "vector": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "number"
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "item_index",
        "vector_digest"
      ],
      "properties": {
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payload_id",
            "digest",
            "owner_component_id",
            "owner_kind",
            "owner_id"
          ],
          "properties": {
            "payload_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "owner_component_id": {
              "const": "embedding.multimodal"
            },
            "owner_kind": {
              "const": "embedding.result"
            },
            "owner_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "item_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "vector_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
