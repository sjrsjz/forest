{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref_id", "space_id", "purpose", "source_unit_id", "source_revision", "modality", "vector"],
  "properties": {
    "ref_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "space_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "purpose": {"enum": ["DOCUMENT", "QUERY"]},
    "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_revision": {"type": "integer", "minimum": 1},
    "modality": {"enum": ["TEXT", "IMAGE"]},
    "vector": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "number"}}
  }
}
