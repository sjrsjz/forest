{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "limit"
  ],
  "properties": {
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "state": {
      "enum": [
        "QUEUED",
        "CLAIMED",
        "DELETED",
        "BLOCKED",
        "NEEDS_ID"
      ]
    },
    "source_kind": {
      "enum": [
        "OLD_BINDING",
        "ABANDONED_CANDIDATE",
        "UNCONFIRMED_ATTEMPT"
      ]
    },
    "after_revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
