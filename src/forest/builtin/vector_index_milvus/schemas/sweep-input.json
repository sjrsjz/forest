{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ref_ids",
    "space_id",
    "binding"
  ],
  "properties": {
    "ref_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_revision",
        "collection_id",
        "collection_name"
      ],
      "properties": {
        "binding_revision": {
          "type": "integer",
          "minimum": 1
        },
        "collection_id": {
          "type": "integer",
          "minimum": 1
        },
        "collection_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
