{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "claim_token",
    "space_id",
    "base_revision",
    "candidate_revision",
    "collection_id",
    "collection_name",
    "audit_seq"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "claim_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_revision": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_revision": {
      "type": "integer",
      "minimum": 2
    },
    "collection_id": {
      "type": "integer",
      "minimum": 1
    },
    "collection_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "audit_seq": {
      "type": "integer",
      "minimum": 0
    }
  }
}
