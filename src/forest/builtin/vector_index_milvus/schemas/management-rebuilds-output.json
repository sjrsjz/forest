{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "has_more",
    "next_cursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "state",
          "base_revision",
          "candidate_revision",
          "replay_cursor",
          "audit_seq",
          "published_seq",
          "error_code",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "state": {
            "enum": [
              "QUEUED",
              "CLAIMED",
              "CANDIDATE_READY",
              "REPLAY_CLAIMED",
              "AUDIT_READY",
              "AUDIT_CLAIMED",
              "AUDITED",
              "PUBLISHING",
              "PUBLISHED",
              "FAILED"
            ]
          },
          "base_revision": {
            "type": "integer",
            "minimum": 1
          },
          "candidate_revision": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "replay_cursor": {
            "type": "integer",
            "minimum": 0
          },
          "audit_seq": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "published_seq": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "has_more": {
      "type": "boolean"
    },
    "next_cursor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created_at",
            "request_id"
          ],
          "properties": {
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
