{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "candidate_revision",
    "collection_id",
    "next_seq"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidate_revision": {
      "type": "integer",
      "minimum": 2
    },
    "collection_id": {
      "type": "integer",
      "minimum": 1
    },
    "next_seq": {
      "type": "integer",
      "minimum": 1
    }
  }
}
