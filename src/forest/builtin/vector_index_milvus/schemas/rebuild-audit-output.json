{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "candidate_revision",
    "collection_id",
    "audit_seq",
    "next_ref",
    "done"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidate_revision": {
      "type": "integer",
      "minimum": 2
    },
    "collection_id": {
      "type": "integer",
      "minimum": 1
    },
    "audit_seq": {
      "type": "integer",
      "minimum": 0
    },
    "next_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "done": {
      "type": "boolean"
    }
  }
}
