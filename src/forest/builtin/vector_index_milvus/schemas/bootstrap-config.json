{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "endpoint",
    "credential_ref",
    "timeout_seconds",
    "metric"
  ],
  "properties": {
    "protocol": {
      "const": "forest.vector-index.milvus/1"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "credential_ref": {
      "type": "string",
      "maxLength": 512
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 300
    },
    "metric": {
      "const": "COSINE"
    }
  }
}
