{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "state",
    "space_id"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "enum": [
        "QUEUED",
        "CLAIMED",
        "CANDIDATE_READY",
        "REPLAY_CLAIMED",
        "AUDIT_READY",
        "AUDIT_CLAIMED",
        "AUDITED",
        "PUBLISHING",
        "PUBLISHED",
        "FAILED"
      ]
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
