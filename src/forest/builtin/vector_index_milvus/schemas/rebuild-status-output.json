{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "state",
    "space_id",
    "base_revision",
    "candidate_revision",
    "candidate_name",
    "candidate_id",
    "replay_waterline",
    "attempt_count",
    "error_code"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "enum": [
        "QUEUED",
        "CLAIMED",
        "CANDIDATE_READY",
        "FAILED"
      ]
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_revision": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "candidate_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "replay_waterline": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
