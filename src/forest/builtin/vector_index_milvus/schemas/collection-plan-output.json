{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "reason",
    "claim_token",
    "binding_revision",
    "collection_id"
  ],
  "properties": {
    "state": {
      "enum": [
        "READY",
        "CREATE",
        "CONFIRM",
        "WAIT",
        "REBUILD_REQUIRED"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "claim_token": {
      "type": [
        "string",
        "null"
      ]
    },
    "binding_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "collection_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  }
}
