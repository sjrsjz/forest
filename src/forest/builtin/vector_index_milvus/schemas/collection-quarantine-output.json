{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "binding_revision",
    "collection_id"
  ],
  "properties": {
    "state": {
      "const": "REBUILD_REQUIRED"
    },
    "binding_revision": {
      "type": "integer",
      "minimum": 1
    },
    "collection_id": {
      "type": "integer",
      "minimum": 1
    }
  }
}
