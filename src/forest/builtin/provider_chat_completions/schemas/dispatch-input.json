{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "effect_operation_id", "authorization_ticket_id", "component_id", "generation_id", "profile_ref", "capability_digest", "prepared"],
  "properties": {
    "protocol": {"const": "forest.provider-dispatch/1"},
    "effect_operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authorization_ticket_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "component_id": {"const": "provider.chat-completions"},
    "generation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "profile_ref": {"type": "string", "pattern": "^profile:[0-9a-f]{64}$"},
    "capability_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "prepared": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "transport_attempt_id", "body_base64", "manifest_json", "payload_digest", "max_output_tokens", "stream", "serializer_revision"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "transport_attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "body_base64": {"type": "string", "minLength": 1, "maxLength": 8388608},
        "manifest_json": {"type": "string", "minLength": 2, "maxLength": 8388608},
        "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 262144},
        "stream": {"type": "boolean"},
        "serializer_revision": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
