{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "component_id", "generation_id", "profile_ref",
    "capability_digest", "request_id", "transport_attempt_id", "input", "media"
  ],
  "properties": {
    "protocol": {"const": "forest.provider-materialize/1"},
    "component_id": {"const": "provider.chat-completions"},
    "generation_id": {"$ref": "#/$defs/id"},
    "profile_ref": {"type": "string", "pattern": "^profile:[0-9a-f]{64}$"},
    "capability_digest": {"$ref": "#/$defs/digest"},
    "request_id": {"$ref": "#/$defs/id"},
    "transport_attempt_id": {"$ref": "#/$defs/id"},
    "input": {"$ref": "#/$defs/input_payload"},
    "media": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/media"}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_id", "digest", "owner_component_id", "owner_kind", "owner_id"],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "owner_component_id": {"$ref": "#/$defs/id"},
        "owner_kind": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"}
      }
    },
    "input_payload": {
      "allOf": [
        {"$ref": "#/$defs/payload"},
        {"properties": {
          "owner_component_id": {"const": "agent.runtime"},
          "owner_kind": {"const": "model.input"}
        }}
      ]
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_unit_id", "part_id", "media_ref", "media_revision", "payload",
        "media_type", "width", "height", "byte_length"
      ],
      "properties": {
        "source_unit_id": {"$ref": "#/$defs/id"},
        "part_id": {"$ref": "#/$defs/id"},
        "media_ref": {"$ref": "#/$defs/id"},
        "media_revision": {"type": "integer", "minimum": 1},
        "payload": {"$ref": "#/$defs/payload"},
        "media_type": {"enum": ["image/png", "image/jpeg", "image/webp", "image/gif"]},
        "width": {"type": "integer", "minimum": 1, "maximum": 100000},
        "height": {"type": "integer", "minimum": 1, "maximum": 100000},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 16777216}
      }
    }
  }
}
