{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "base_url",
    "credential_ref",
    "timeout_seconds",
    "max_connections",
    "capabilities"
  ],
  "properties": {
    "protocol": {
      "const": "forest.provider.chat-completions/1"
    },
    "base_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "credential_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 600
    },
    "max_connections": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities",
      "allOf": [
        {
          "if": {
            "properties": {
              "reasoning_mode": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "reasoning_effort": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reasoning_mode"
            ],
            "properties": {
              "reasoning_mode": {
                "const": "deepseek"
              }
            }
          },
          "then": {
            "properties": {
              "reasoning_effort": {
                "enum": [
                  null,
                  "low",
                  "high",
                  "max"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reasoning_mode"
            ],
            "properties": {
              "reasoning_mode": {
                "const": "openai"
              }
            }
          },
          "then": {
            "required": [
              "reasoning_effort"
            ],
            "properties": {
              "reasoning_effort": {
                "enum": [
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "model",
        "capability_revision",
        "model_revision",
        "input_modalities",
        "supports_tools",
        "supports_streaming",
        "stream_usage",
        "max_output_tokens",
        "image_roles",
        "image_detail",
        "system_role",
        "output_token_parameter",
        "tool_image_mapping"
      ],
      "properties": {
        "deployment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "capability_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "input_modalities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "image"
            ]
          },
          "contains": {
            "const": "text"
          }
        },
        "supports_tools": {
          "type": "boolean"
        },
        "supports_streaming": {
          "type": "boolean"
        },
        "stream_usage": {
          "type": "boolean"
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "image_roles": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "user"
          }
        },
        "image_detail": {
          "enum": [
            "auto",
            "low",
            "high"
          ]
        },
        "system_role": {
          "enum": [
            "system",
            "developer"
          ]
        },
        "output_token_parameter": {
          "enum": [
            "max_tokens",
            "max_completion_tokens"
          ]
        },
        "tool_image_mapping": {
          "enum": [
            "omit",
            "user_after_tool_group_v1"
          ]
        },
        "reasoning_mode": {
          "enum": [
            "none",
            "deepseek",
            "openai"
          ],
          "default": "none",
          "description": "Explicit native reasoning protocol; never inferred from the endpoint."
        },
        "reasoning_effort": {
          "enum": [
            null,
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": null
        }
      }
    }
  }
}
