{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "component_id",
    "generation_id",
    "profile_ref",
    "capability_digest",
    "capabilities"
  ],
  "properties": {
    "protocol": {
      "const": "forest.provider-profile/1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "component_id": {
      "const": "provider.chat-completions"
    },
    "generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "profile_ref": {
      "type": "string",
      "pattern": "^profile:[0-9a-f]{64}$"
    },
    "capability_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    }
  },
  "$defs": {
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "model",
        "capability_revision",
        "model_revision",
        "input_modalities",
        "supports_tools",
        "supports_streaming",
        "stream_usage",
        "max_output_tokens",
        "image_roles",
        "image_detail",
        "system_role",
        "output_token_parameter",
        "tool_image_mapping"
      ],
      "properties": {
        "deployment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "capability_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "input_modalities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "image"
            ]
          },
          "contains": {
            "const": "text"
          }
        },
        "supports_tools": {
          "type": "boolean"
        },
        "supports_streaming": {
          "type": "boolean"
        },
        "stream_usage": {
          "type": "boolean"
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "image_roles": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "user"
          }
        },
        "image_detail": {
          "enum": [
            "auto",
            "low",
            "high"
          ]
        },
        "system_role": {
          "enum": [
            "system",
            "developer"
          ]
        },
        "output_token_parameter": {
          "enum": [
            "max_tokens",
            "max_completion_tokens"
          ]
        },
        "tool_image_mapping": {
          "enum": [
            "omit",
            "user_after_tool_group_v1"
          ]
        }
      }
    }
  }
}
