{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["forest.provider-profile/1"],
  "properties": {
    "forest.provider-profile/1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_ref", "capability_digest", "model_ref"],
      "properties": {
        "profile_ref": {"type": "string", "pattern": "^profile:[0-9a-f]{64}$"},
        "capability_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "model_ref": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
