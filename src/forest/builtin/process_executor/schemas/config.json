{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol",
    "profiles"
  ],
  "properties": {
    "protocol": {
      "const": "forest.process.executor/1"
    },
    "profiles": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "executable",
          "executable_sha256",
          "arguments_schema",
          "argv",
          "working_directory",
          "environment",
          "run_as",
          "network_policy",
          "require_posix_limits",
          "limits"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "executable_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "arguments_schema": {
            "type": "object"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "literal"
                  ],
                  "properties": {
                    "literal": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "argument"
                  ],
                  "properties": {
                    "argument": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "working_directory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "environment": {
            "type": "object",
            "maxProperties": 128,
            "propertyNames": {
              "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "run_as": {
            "type": "object",
            "required": [
              "uid",
              "gid"
            ],
            "properties": {
              "uid": {
                "type": "integer",
                "minimum": 0
              },
              "gid": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "network_policy": {
            "enum": [
              "deny",
              "inherit"
            ]
          },
          "require_posix_limits": {
            "type": "boolean"
          },
          "limits": {
            "type": "object",
            "required": [
              "cpu_seconds",
              "memory_bytes",
              "wall_seconds",
              "output_bytes",
              "open_files",
              "processes",
              "terminate_grace_seconds"
            ],
            "properties": {
              "cpu_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "memory_bytes": {
                "type": "integer",
                "minimum": 16777216,
                "maximum": 68719476736
              },
              "wall_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "output_bytes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 33554432
              },
              "open_files": {
                "type": "integer",
                "minimum": 8,
                "maximum": 4096
              },
              "processes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              },
              "terminate_grace_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
